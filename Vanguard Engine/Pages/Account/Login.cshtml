@page
@model Vanguard_Engine.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="glass-card">
        <h2 class="mb-3">Welcome Back</h2>
        <p class="text-muted mb-4">Sign in to continue</p>

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control glass-input" asp-for="Login.Email" />
                <span class="text-danger" asp-validation-for="Login.Email"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input class="form-control glass-input" asp-for="Login.Password" type="password" />
                <span class="text-danger" asp-validation-for="Login.Password"></span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <button type="submit" class="btn btn-primary w-100">Login</button>
        </form>

        <div class="mt-4 text-center">
            <span class="text-muted">New here?</span>
            <a asp-page="/Account/Register">Create an account</a>
        </div>
    </div>
</div>
