@page
@model Vanguard_Engine.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
    <div class="glass-card">
        <h2 class="mb-3">Create Account</h2>
        <p class="text-muted mb-4">Join Vanguard Engine</p>

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input class="form-control glass-input" asp-for="Register.Username" />
                <span class="text-danger" asp-validation-for="Register.Username"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control glass-input" asp-for="Register.Email" />
                <span class="text-danger" asp-validation-for="Register.Email"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input class="form-control glass-input" asp-for="Register.Password" type="password" />
                <span class="text-danger" asp-validation-for="Register.Password"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Address</label>
                <input class="form-control glass-input" asp-for="Register.Address" />
            </div>
            <div class="mb-3">
                <label class="form-label">Role</label>
                <select class="form-select glass-input" asp-for="Register.RoleId">
                    <option value="">Select role</option>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role.Id">@role.RoleName</option>
                    }
                </select>
                <span class="text-danger" asp-validation-for="Register.RoleId"></span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <button type="submit" class="btn btn-primary w-100">Register</button>
        </form>

        <div class="mt-4 text-center">
            <span class="text-muted">Already have an account?</span>
            <a asp-page="/Account/Login">Sign in</a>
        </div>
    </div>
</div>
