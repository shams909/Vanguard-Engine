@page
@model Vanguard_Engine.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<h2>Users</h2>

<div class="mb-3">
    <a class="btn btn-primary" asp-page="/Users/Create">Add User</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Email</th>
            <th>Role Id</th>
            <th>Last Login</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.Id</td>
            <td>@user.Username</td>
            <td>@user.Email</td>
            <td>@user.RoleId</td>
            <td>@user.LastLogin.ToString("g")</td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
            <a class="page-link" asp-page="/Users/Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Previous</a>
        </li>
        <li class="page-item">
            <span class="page-link">Page @Model.PageNumber</span>
        </li>
        <li class="page-item">
            <a class="page-link" asp-page="/Users/Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
        </li>
    </ul>
</nav>
