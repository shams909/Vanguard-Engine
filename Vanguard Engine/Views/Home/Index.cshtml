@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Vanguard Engine</h1>
    <p class="lead">Security Guard Management System</p>
</div>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Roles</h5>
                <p class="card-text">Manage role definitions and permissions.</p>
                <a class="btn btn-primary" asp-page="/Roles/Index">Go to Roles</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Users</h5>
                <p class="card-text">Manage system users and assignments.</p>
                <a class="btn btn-primary" asp-page="/Users/Index">Go to Users</a>
            </div>
        </div>
    </div>
</div>
