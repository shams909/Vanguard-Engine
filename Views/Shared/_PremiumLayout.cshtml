@using System.Security.Claims
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta name="user-id" content="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vanguard Engine</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <style>
        :root {
            --bg: #f3ede1;
            --bg2: #eaddc7;
            --surface: rgba(247, 238, 226, 0.65);
            --surface-hover: rgba(247, 238, 226, 0.85);
            --border: rgba(215, 200, 180, 0.8);
            --border-strong: rgba(180, 160, 140, 0.8);
            --text: #292524;
            --text-muted: #78716c;
            --text-sub: #57534e;
            --accent: #92400e;
            --accent2: #b45309;
            --green: #15803d;
            --yellow: #b45309;
            --red: #b91c1c;
            --glass: rgba(245, 235, 220, 0.5);
            --glass-border: rgba(230, 215, 195, 0.8);
            --radius: 24px;
            --radius-sm: 14px;
            --shadow-sm: 0 8px 32px rgba(67, 40, 24, 0.04);
            --shadow-md: 0 16px 48px rgba(67, 40, 24, 0.08);
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html { font-size: 16px; scroll-behavior: smooth; }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            /* Coffee/Bronze Light Theme Background */
            background-image: 
                radial-gradient(at 0% 0%, rgba(215, 200, 180, 0.4) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(245, 235, 220, 0.6) 0px, transparent 50%);
            background-attachment: fixed;
        }

        /* ─── DATATABLES PREMIUM STYLING ─── */
        .dataTables_wrapper { padding: 12px 4px; font-size: 0.85rem; }
        .dataTables_wrapper .dataTables_filter { margin-bottom: 12px; }
        .dataTables_wrapper .dataTables_filter label { display: flex; align-items: center; justify-content: flex-end; color: var(--text-muted); font-weight: 500; }
        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid var(--border-strong); border-radius: 10px; padding: 8px 14px; min-width: 220px;
            background: rgba(255,255,255,0.7); outline: none; margin-left: 8px; transition: all 0.2s; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
        }
        .dataTables_wrapper .dataTables_filter input:focus { border-color: var(--accent); background: #fff; box-shadow: 0 0 0 3px rgba(180,83,9,0.15); }
        .dataTables_wrapper .dataTables_length { margin-bottom: 12px; }
        .dataTables_wrapper .dataTables_length label { display: flex; align-items: center; color: var(--text-muted); font-weight: 500; }
        .dataTables_wrapper .dataTables_length select {
            border: 1px solid var(--border-strong); border-radius: 8px; padding: 6px 12px;
            background: rgba(255,255,255,0.7); margin: 0 8px; font-weight: 600; color: var(--text); outline: none; cursor: pointer;
        }
        .dataTables_wrapper .dataTables_paginate { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border); }
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            border-radius: 8px !important; border: 1px solid transparent !important; background: transparent !important; color: var(--text) !important; font-weight: 600; padding: 6px 12px !important; margin: 0 2px; transition: all 0.15s;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: var(--accent) !important; color: white !important; font-weight: 700; box-shadow: 0 2px 8px rgba(146, 64, 14, 0.2); border: 1px solid var(--accent) !important;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.current) {
            background: rgba(180,83,9,0.1) !important; color: var(--accent) !important; border-color: rgba(180,83,9,0.2) !important;
        }
        table.dataTable { margin-top: 8px !important; margin-bottom: 8px !important; border-bottom: 1px solid var(--border) !important; }
        table.dataTable thead th, table.dataTable thead td, table.dataTable.no-footer {
            border-bottom: 2px solid var(--border) !important; padding: 12px 16px;
        }
        .dataTables_info { color: var(--text-muted) !important; margin-top: 20px; }

        /* ─── NAVBAR ─── */
        .dk-nav {
            position: sticky; 
            top: 16px; 
            z-index: 1000;
            margin: 16px auto;
            max-width: 1440px;
            width: calc(100% - 32px);
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(40px) saturate(180%);
            -webkit-backdrop-filter: blur(40px) saturate(180%);
            border: 1px solid var(--border);
            border-radius: 30px;
            box-shadow: 0 12px 40px rgba(67, 40, 24, 0.08);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .dk-nav-inner {
            display: flex; 
            align-items: center; 
            justify-content: space-between;
            flex-wrap: wrap;
            padding: 8px 24px; 
            min-height: 64px; 
            height: auto; 
            gap: 12px;
        }
        .dk-brand {
            font-size: 1.05rem; font-weight: 800; color: var(--text);
            text-decoration: none; display: flex; align-items: center; gap: 8px;
            letter-spacing: -0.3px; flex-shrink: 0;
        }
        .dk-brand:hover { color: var(--accent); }
        .dk-nav-links {
            display: flex; 
            align-items: center; 
            gap: 6px;
            list-style: none; 
            flex-wrap: wrap;
            justify-content: center;
        }
        .dk-nav-links a {
            display: block; 
            padding: 6px 12px; 
            border-radius: 100px;
            font-size: 0.78rem; 
            font-weight: 600; 
            color: var(--text-sub);
            text-decoration: none; 
            transition: all 0.15s; 
            white-space: nowrap;
            background: rgba(245, 235, 220, 0.35);
            border: 1px solid rgba(215, 200, 180, 0.5);
            box-shadow: 0 2px 8px rgba(67, 40, 24, 0.02);
        }
        .dk-nav-links a:hover { 
            background: var(--surface-hover); 
            color: var(--text); 
            border-color: rgba(215, 200, 180, 0.8);
        }
        .dk-nav-links a.active { 
            background: rgba(180, 83, 9, 0.12); 
            color: var(--accent); 
            border-color: rgba(180, 83, 9, 0.25);
        }

        /* ─── NEXT-GEN ADMIN MEGA-MENU (OPTION 1) ─── */
        .admin-mega-btn {
            display: flex !important;
            align-items: center !important;
            padding: 6px 14px !important;
            border-radius: 100px !important;
            font-size: 0.78rem !important;
            font-weight: 700 !important;
            color: var(--accent) !important;
            background: rgba(180, 83, 9, 0.1) !important;
            border: 1px solid rgba(180, 83, 9, 0.28) !important;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
            box-shadow: 0 2px 8px rgba(180, 83, 9, 0.08) !important;
            font-family: inherit;
        }
        .admin-mega-btn:hover, .admin-mega-btn.active {
            background: rgba(180, 83, 9, 0.18) !important;
            border-color: rgba(180, 83, 9, 0.45) !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(180, 83, 9, 0.15) !important;
        }
        .admin-mega-menu {
            position: absolute;
            top: calc(100% + 12px);
            left: 50%;
            transform: translateX(-50%) translateY(-12px) scale(0.96);
            width: 760px;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(45px) saturate(200%);
            -webkit-backdrop-filter: blur(45px) saturate(200%);
            border: 1px solid var(--border-strong);
            border-radius: 26px;
            box-shadow: 0 24px 64px rgba(67, 40, 24, 0.16), 0 0 1px 1px rgba(255,255,255,0.8);
            padding: 24px;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            z-index: 2500;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .admin-mega-menu.show {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateX(-50%) translateY(0) scale(1);
        }
        .mega-col-title {
            font-size: 0.68rem;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 12px;
            padding-bottom: 6px;
            border-bottom: 1.5px solid var(--border);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .mega-col-title svg { width: 13px; height: 13px; color: var(--accent); }
        .mega-item {
            display: flex !important;
            align-items: center;
            gap: 12px;
            padding: 10px 12px !important;
            border-radius: 14px !important;
            text-decoration: none !important;
            background: transparent !important;
            border: 1px solid transparent !important;
            transition: all 0.2s ease !important;
            margin-bottom: 4px;
        }
        .mega-item:hover {
            background: rgba(255, 255, 255, 0.9) !important;
            border-color: var(--border-strong) !important;
            transform: translateX(3px);
            box-shadow: 0 4px 14px rgba(67, 40, 24, 0.05) !important;
        }
        .mega-icon-wrap {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: transform 0.2s;
        }
        .mega-item:hover .mega-icon-wrap { transform: scale(1.08); }
        .mega-icon-wrap svg { width: 18px; height: 18px; }
        .mega-item-title { font-size: 0.83rem; font-weight: 700; color: var(--text); line-height: 1.2; }
        .mega-item-sub { font-size: 0.72rem; color: var(--text-muted); font-weight: 500; margin-top: 3px; line-height: 1.3; }
        .mega-item.danger-item:hover {
            background: rgba(239, 68, 68, 0.06) !important;
            border-color: rgba(239, 68, 68, 0.3) !important;
        }

        /* ─── NEXT-GEN COMMAND PALETTE (OPTION 2) ─── */
        .cmd-trigger-pill {
            display: flex !important;
            align-items: center !important;
            gap: 8px !important;
            padding: 4px 6px 4px 12px !important;
            border-radius: 100px !important;
            font-size: 0.76rem !important;
            font-weight: 600 !important;
            color: var(--text-sub) !important;
            background: rgba(245, 235, 220, 0.45) !important;
            border: 1px dashed rgba(180, 160, 140, 0.7) !important;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: inherit;
        }
        .cmd-trigger-pill:hover {
            background: rgba(255, 255, 255, 0.9) !important;
            color: var(--text) !important;
            border-style: solid !important;
            border-color: var(--accent) !important;
            box-shadow: 0 2px 10px rgba(180, 83, 9, 0.1) !important;
        }
        .kbd-shortcut {
            background: rgba(215, 200, 180, 0.5);
            color: var(--text);
            font-size: 0.68rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 100px;
            border: 1px solid rgba(180, 160, 140, 0.8);
            letter-spacing: 0.5px;
            font-family: inherit;
        }
        .cmd-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(41, 37, 36, 0.45);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 9999;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 12vh 20px 20px;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .cmd-modal-overlay.open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }
        .cmd-modal-box {
            width: 100%;
            max-width: 620px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(50px) saturate(200%);
            -webkit-backdrop-filter: blur(50px) saturate(200%);
            border: 1px solid var(--border-strong);
            border-radius: 24px;
            box-shadow: 0 32px 80px rgba(0, 0, 0, 0.28), 0 0 0 1px rgba(255,255,255,0.8);
            overflow: hidden;
            transform: scale(0.95) translateY(-15px);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
        }
        .cmd-modal-overlay.open .cmd-modal-box {
            transform: scale(1) translateY(0);
        }
        .cmd-input-wrap {
            display: flex;
            align-items: center;
            padding: 16px 20px;
            gap: 14px;
            background: rgba(255, 255, 255, 0.6);
            border-bottom: 1px solid var(--border);
        }
        .cmd-search-icon { width: 22px; height: 22px; color: var(--accent); flex-shrink: 0; }
        #cmd-search-input {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text);
            font-family: inherit;
        }
        #cmd-search-input::placeholder { color: var(--text-muted); font-weight: 500; opacity: 0.75; }
        .cmd-esc-tag {
            background: rgba(239, 68, 68, 0.08);
            color: var(--red);
            border: 1px solid rgba(239, 68, 68, 0.25);
            border-radius: 8px;
            padding: 4px 8px;
            font-size: 0.72rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.15s;
        }
        .cmd-esc-tag:hover { background: rgba(239, 68, 68, 0.15); }
        .cmd-results-list {
            max-height: 400px;
            overflow-y: auto;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .cmd-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            border-radius: 14px;
            background: transparent;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all 0.15s;
            text-decoration: none;
            color: inherit;
        }
        .cmd-item:hover, .cmd-item.selected {
            background: rgba(180, 83, 9, 0.1);
            border-color: rgba(180, 83, 9, 0.22);
            transform: translateX(4px);
        }
        .cmd-item.selected {
            background: rgba(180, 83, 9, 0.16);
            box-shadow: 0 4px 12px rgba(180, 83, 9, 0.08);
        }
        .cmd-item-left { display: flex; align-items: center; gap: 14px; }
        .cmd-icon-wrap {
            width: 38px; height: 38px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .cmd-icon-wrap svg { width: 18px; height: 18px; }
        .cmd-title-group { display: flex; flex-direction: column; }
        .cmd-item-title { font-size: 0.9rem; font-weight: 700; color: var(--text); }
        .cmd-item-sub { font-size: 0.75rem; color: var(--text-muted); font-weight: 500; margin-top: 2px; }
        .cmd-cat-badge {
            font-size: 0.7rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 100px;
            background: rgba(215, 200, 180, 0.4);
            color: var(--text-sub);
            border: 1px solid var(--border);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .cmd-footer {
            padding: 10px 20px;
            background: rgba(245, 235, 220, 0.5);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.72rem;
            color: var(--text-muted);
            font-weight: 600;
        }
        .cmd-footer kbd {
            background: rgba(255,255,255,0.7);
            border: 1px solid var(--border-strong);
            border-radius: 4px;
            padding: 1px 5px;
            font-weight: 800;
            color: var(--text);
        }
        .cmd-no-results {
            padding: 40px 20px;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 600;
        }
        @@media (max-width: 768px) {
            .admin-mega-menu {
                position: fixed;
                left: 12px !important;
                right: 12px !important;
                top: 85px !important;
                width: calc(100vw - 24px) !important;
                transform: translateY(-10px) scale(0.96) !important;
                grid-template-columns: 1fr;
                max-height: calc(100vh - 110px);
                overflow-y: auto;
            }
            .admin-mega-menu.show {
                transform: translateY(0) scale(1) !important;
            }
            .cmd-modal-overlay { padding: 5vh 12px 12px; }
            .cmd-trigger-pill span { display: none; }
        }
        .dk-nav-right {
            display: flex; align-items: center; gap: 8px;
            list-style: none; flex-shrink: 0;
        }
        .user-chip {
            display: flex; align-items: center; gap: 8px;
            background: var(--surface); border: 1px solid var(--border);
            padding: 5px 12px 5px 8px; border-radius: 100px;
        }
        .user-avatar {
            width: 26px; height: 26px; border-radius: 50%;
            background: linear-gradient(135deg, var(--accent2), #a855f7);
            display: flex; align-items: center; justify-content: center;
            font-size: 0.7rem; font-weight: 700; color: #fff;
        }
        .user-name { font-size: 0.82rem; font-weight: 600; color: var(--text); }
        .role-pill {
            font-size: 0.68rem; font-weight: 700; padding: 2px 8px;
            border-radius: 100px; background: rgba(180, 83, 9, 0.12);
            color: var(--accent); border: 1px solid rgba(180, 83, 9, 0.25);
        }
        .btn-logout {
            background: none; border: 1px solid var(--border); color: var(--text-muted);
            font-size: 0.8rem; font-weight: 600; padding: 6px 14px;
            border-radius: 10px; cursor: pointer; transition: all 0.15s;
            font-family: inherit;
        }
        .btn-logout:hover { background: rgba(248,113,113,0.1); border-color: var(--red); color: var(--red); }

        /* ─── NOTIFICATION BELL ─── */
        .notif-bell-btn {
            position: relative; background: none; border: 1px solid var(--border);
            border-radius: 12px; padding: 7px 10px; cursor: pointer; color: var(--text-sub);
            display: flex; align-items: center; transition: all 0.15s; flex-shrink: 0;
        }
        .notif-bell-btn:hover { background: var(--surface-hover); color: var(--text); border-color: var(--border-strong); }
        .notif-bell-btn.active { background: rgba(180,83,9,0.1); color: var(--accent); border-color: rgba(180,83,9,0.3); }
        .notif-badge {
            position: absolute; top: -6px; right: -6px;
            background: var(--red); color: #fff; border-radius: 999px;
            min-width: 18px; height: 18px; font-size: 0.65rem; font-weight: 700;
            display: flex; align-items: center; justify-content: center; padding: 0 4px;
            border: 2px solid var(--bg); line-height: 1; pointer-events: none;
        }

        /* ─── NOTIFICATION OVERLAY ─── */
        .notif-overlay {
            display: none;
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.35);
            backdrop-filter: blur(2px);
            z-index: 3000;
            opacity: 0;
            transition: opacity 0.25s ease;
        }
        .notif-overlay.open { display: block; }
        .notif-overlay.visible { opacity: 1; }

        /* ─── NOTIFICATION SIDEBAR DRAWER ─── */
        .notif-sidebar {
            position: fixed;
            top: 0; right: 0; bottom: 0;
            width: 400px;
            max-width: 100vw;
            background: #ffffff;
            border-left: 1px solid rgba(0,0,0,0.05);
            box-shadow: -10px 0 50px rgba(0, 0, 0, 0.08);
            z-index: 3001;
            display: flex;
            flex-direction: column;
            transform: translateX(100%);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
            will-change: transform;
        }
        .notif-sidebar.open { transform: translateX(0); }

        /* Sidebar header */
        .notif-sb-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 24px 24px 16px;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(16px);
            flex-shrink: 0;
            z-index: 2;
        }
        .notif-sb-title {
            font-size: 1.15rem; font-weight: 800; color: #1e293b;
            display: flex; align-items: center; gap: 10px; letter-spacing: -0.5px;
        }
        .notif-sb-title .nb-icon { font-size: 1.3rem; }
        .notif-sb-actions { display: flex; align-items: center; gap: 8px; }
        .notif-mark-all {
            font-size: 0.75rem; font-weight: 700; color: var(--accent);
            background: rgba(180,83,9,0.08); border: 1px solid rgba(180,83,9,0.2);
            border-radius: 6px; padding: 6px 12px; cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); white-space: nowrap;
        }
        .notif-mark-all:hover { background: var(--accent); color: white; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(180,83,9,0.2); }
        .notif-close-btn {
            width: 34px; height: 34px; border-radius: 8px;
            border: 1px solid transparent; background: rgba(0,0,0,0.03);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: #64748b; transition: all 0.2s ease;
        }
        .notif-close-btn:hover { background: rgba(239, 68, 68, 0.1); color: #ef4444; transform: rotate(90deg); }

        /* Sidebar list */
        .notif-list {
            flex: 1;
            overflow-y: auto;
            overscroll-behavior: contain;
            background: #f8fafc;
            padding: 8px 12px;
        }
        .notif-list::-webkit-scrollbar { width: 6px; }
        .notif-list::-webkit-scrollbar-track { background: transparent; }
        .notif-list::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 6px; }
        .notif-list::-webkit-scrollbar-thumb:hover { background: rgba(0,0,0,0.2); }

        .notif-item {
            display: flex; align-items: flex-start; gap: 14px;
            padding: 16px; margin-bottom: 8px; cursor: pointer; 
            background: #ffffff; border-radius: 12px;
            border: 1px solid rgba(0,0,0,0.04);
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
            position: relative;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            animation: slideInNotif 0.4s ease backwards;
        }
        .notif-item:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.06); border-color: rgba(0,0,0,0.08); }
        .notif-item.notif-unread { background: #fffbeb; border-color: rgba(245, 158, 11, 0.2); }
        .notif-item.notif-unread::before {
            content: '';
            position: absolute; left: -4px; top: 50%; transform: translateY(-50%);
            width: 8px; height: 8px; background: #f59e0b; border-radius: 50%;
            box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
        }
        
        .notif-item.removing {
            animation: slideOutNotif 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            pointer-events: none;
        }

        @@keyframes slideInNotif {
            0% { opacity: 0; transform: translateX(20px) scale(0.95); }
            100% { opacity: 1; transform: translateX(0) scale(1); }
        }
        @@keyframes slideOutNotif {
            0% { opacity: 1; transform: scale(1); max-height: 120px; margin-bottom: 8px; }
            100% { opacity: 0; transform: scale(0.9) translateX(-20px); max-height: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; border: none; overflow: hidden; }
        }

        .notif-icon-wrap {
            width: 42px; height: 42px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; font-size: 1.1rem;
        }

        /* Notifications Selection & Dropdown */
        .notif-item-header {
            display: flex; align-items: center; justify-content: space-between; gap: 8px;
        }
        .notif-checkbox {
            cursor: pointer;
            width: 18px; height: 18px;
            accent-color: var(--accent);
            margin-right: 4px;
            margin-top: 12px;
            transition: transform 0.2s;
        }
        .notif-checkbox:hover { transform: scale(1.1); }
        
        .notif-more-btn {
            background: none; border: none; cursor: pointer; color: #94a3b8;
            padding: 6px; border-radius: 8px; margin-top: -6px; margin-right: -6px;
            transition: all 0.2s ease;
        }
        .notif-more-btn:hover { background: rgba(0,0,0,0.06); color: #334155; transform: rotate(90deg); }
        
        .notif-dropdown {
            position: absolute; right: 16px; top: 44px;
            background: #ffffff; border: 1px solid rgba(0,0,0,0.08);
            border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            display: flex; flex-direction: column; z-index: 10;
            min-width: 140px; overflow: hidden;
            opacity: 0; visibility: hidden; transform: translateY(-10px) scale(0.95);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            transform-origin: top right;
        }
        .notif-dropdown.show { opacity: 1; visibility: visible; transform: translateY(0) scale(1); }
        
        .notif-dropdown-item {
            padding: 12px 16px; font-size: 0.85rem; font-weight: 600;
            color: #334155; cursor: pointer; background: none; border: none; text-align: left;
            transition: all 0.2s;
            display: flex; align-items: center; gap: 8px;
        }
        .notif-dropdown-item:hover { background: #f1f5f9; padding-left: 20px; }
        .notif-dropdown-item.danger { color: #ef4444; }
        .notif-dropdown-item.danger:hover { background: #fef2f2; }
        .notif-icon-info     { background: rgba(59,130,246,0.12); color: #3b82f6; }
        .notif-icon-warning  { background: rgba(245,158,11,0.12); color: #f59e0b; }
        .notif-icon-critical { background: rgba(239,68,68,0.12);  color: #ef4444; }

        .notif-body { flex: 1; min-width: 0; }
        .notif-title { font-size: 0.83rem; font-weight: 700; color: var(--text); margin-bottom: 3px; line-height: 1.3; }
        .notif-msg   { font-size: 0.78rem; color: var(--text-sub); line-height: 1.5; word-break: break-word; }
        .notif-time  { font-size: 0.7rem; color: var(--text-muted); margin-top: 5px; display: flex; align-items: center; gap: 4px; }

        .notif-empty {
            padding: 60px 24px; text-align: center; color: var(--text-muted);
        }
        .notif-empty-icon { font-size: 2.5rem; margin-bottom: 12px; opacity: 0.5; }
        .notif-empty-text { font-size: 0.85rem; font-weight: 600; color: var(--text-sub); margin-bottom: 4px; }
        .notif-empty-sub  { font-size: 0.78rem; }

        /* Sidebar footer */
        .notif-sb-footer {
            padding: 12px 20px;
            border-top: 1px solid var(--border);
            text-align: center;
            font-size: 0.75rem; color: var(--text-muted);
            flex-shrink: 0;
            background: rgba(255,255,255,0.5);
        }

        /* ─── MOBILE ─── */
        @@media (max-width: 480px) {
            .notif-sidebar { width: 100vw; }
        }


        .dk-main { max-width: 1400px; margin: 0 auto; padding: 36px 28px 80px; }

        /* ─── CARDS ─── */
        .dk-card {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-top: 1.5px solid rgba(255, 255, 255, 0.9);
            border-radius: var(--radius);
            backdrop-filter: blur(40px) saturate(150%);
            -webkit-backdrop-filter: blur(40px) saturate(150%);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }
        .dk-card-pad { padding: 28px; }

        /* ─── HERO ─── */
        .page-hero { text-align: center; padding: 40px 0 32px; }
        .hero-icon { font-size: 3.5rem; margin-bottom: 12px; }
        .hero-title { font-size: 2rem; font-weight: 900; color: var(--text); letter-spacing: -0.5px; margin-bottom: 8px; }
        .hero-sub { color: var(--text-muted); font-size: 0.9rem; max-width: 500px; margin: 0 auto; line-height: 1.6; }

        /* ─── TABLE ─── */
        .dk-table { width: 100%; border-collapse: collapse; }
        .dk-table thead tr { border-bottom: 1px solid var(--border); }
        .dk-table th {
            padding: 14px 16px; text-align: left;
            font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.05em; color: var(--text-muted);
        }
        .dk-table tbody tr {
            border-bottom: 1px solid rgba(255,255,255,0.04);
            transition: background 0.1s;
        }
        .dk-table tbody tr:hover { background: var(--surface); }
        .dk-table tbody tr:last-child { border-bottom: none; }
        .dk-table td { padding: 14px 16px; font-size: 0.875rem; vertical-align: middle; }

        /* ─── BADGES ─── */
        .badge {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 4px 10px; border-radius: 100px;
            font-size: 0.72rem; font-weight: 700;
        }
        .badge-pending { background: rgba(251,191,36,0.12); color: var(--yellow); border: 1px solid rgba(251,191,36,0.25); }
        .badge-approved { background: rgba(52,211,153,0.12); color: var(--green); border: 1px solid rgba(52,211,153,0.25); }
        .badge-rejected { background: rgba(248,113,113,0.12); color: var(--red); border: 1px solid rgba(248,113,113,0.25); }
        .badge-admin { background: rgba(248,113,113,0.12); color: var(--red); border: 1px solid rgba(248,113,113,0.2); }
        .badge-guard { background: rgba(52,211,153,0.12); color: var(--green); border: 1px solid rgba(52,211,153,0.2); }
        .badge-client { background: rgba(129,140,248,0.12); color: var(--accent); border: 1px solid rgba(129,140,248,0.2); }

        /* ─── BUTTONS ─── */
        .dk-btn {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 9px 18px; border-radius: 12px;
            font-size: 0.85rem; font-weight: 600; cursor: pointer;
            transition: all 0.15s; border: none; text-decoration: none;
            font-family: inherit;
        }
        .dk-btn:active { transform: scale(0.97); }
        .dk-btn-primary {
            background: linear-gradient(135deg, #b45309, #78350f);
            color: #fff;
            box-shadow: 0 8px 24px rgba(180, 83, 9, 0.25);
        }
        .dk-btn-primary:hover { opacity: 0.9; box-shadow: 0 12px 32px rgba(180, 83, 9, 0.35); color: #fff; transform: translateY(-2px); }
        .dk-btn-success {
            background: rgba(52,211,153,0.12); color: var(--green);
            border: 1px solid rgba(52,211,153,0.3);
        }
        .dk-btn-success:hover { background: rgba(52,211,153,0.22); color: var(--green); }
        .dk-btn-danger {
            background: rgba(248,113,113,0.1); color: var(--red);
            border: 1px solid rgba(248,113,113,0.25);
        }
        .dk-btn-danger:hover { background: rgba(248,113,113,0.2); color: var(--red); }
        .dk-btn-ghost {
            background: var(--surface); color: var(--text-sub);
            border: 1px solid var(--border);
        }
        .dk-btn-ghost:hover { background: var(--surface-hover); color: var(--text); }
        .dk-btn-sm { padding: 6px 12px; font-size: 0.78rem; border-radius: 9px; }

        /* ─── FORM ─── */
        .app-form { display: flex; flex-direction: column; gap: 0; }
        .form-section {
            padding: 24px 28px; border-bottom: 1px solid var(--border);
        }
        .form-section:last-child { border-bottom: none; }
        .form-section-header {
            display: flex; align-items: center; gap: 10px;
            font-size: 0.9rem; font-weight: 700; color: var(--text);
            margin-bottom: 20px;
        }
        .section-icon { font-size: 1.1rem; }
        .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        .dk-label { font-size: 0.8rem; font-weight: 600; color: var(--text-sub); }
        .req { color: var(--red); }
        .dk-input {
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(214, 211, 209, 0.6);
            border-top: 1px solid rgba(214, 211, 209, 0.8);
            border-radius: var(--radius-sm);
            padding: 12px 16px;
            font-size: 0.95rem; color: var(--text);
            transition: all 0.2s; outline: none;
            font-family: inherit; width: 100%;
            box-shadow: inset 0 2px 6px rgba(67, 40, 24, 0.03);
            backdrop-filter: blur(20px);
        }
        .dk-input::placeholder { color: var(--text-muted); opacity: 0.8; font-weight: 500; }
        .dk-input:focus {
            border-color: var(--accent2);
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(180, 83, 9, 0.12), inset 0 1px 2px rgba(67, 40, 24, 0.02);
            transform: translateY(-1px);
        }
        .dk-textarea { resize: vertical; min-height: 110px; line-height: 1.5; }
        select.dk-input { appearance: auto; cursor: pointer; }
        .field-err { font-size: 0.75rem; color: var(--red); margin-top: 2px; }

        /* ─── TOGGLE ─── */
        .dk-toggle { position: relative; display: inline-block; width: 44px; height: 24px; flex-shrink: 0; cursor: pointer; }
        .dk-toggle input { opacity: 0; width: 0; height: 0; }
        .toggle-slider {
            position: absolute; inset: 0;
            background: var(--border); border-radius: 100px; transition: 0.2s;
        }
        .toggle-slider::before {
            content: ''; position: absolute;
            width: 18px; height: 18px; border-radius: 50%;
            background: #fff; left: 3px; top: 3px; transition: 0.2s;
        }
        .dk-toggle input:checked + .toggle-slider { background: var(--accent2); }
        .dk-toggle input:checked + .toggle-slider::before { transform: translateX(20px); }

        /* ─── ALERTS ─── */
        .dk-alert {
            padding: 13px 16px; border-radius: var(--radius-sm);
            font-size: 0.875rem; font-weight: 500; margin-bottom: 20px;
        }
        .dk-alert-success { background: rgba(52,211,153,0.1); color: var(--green); border: 1px solid rgba(52,211,153,0.2); }
        .dk-alert-error { background: rgba(248,113,113,0.1); color: var(--red); border: 1px solid rgba(248,113,113,0.2); }

        /* ─── STAT CARDS ─── */
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 28px; }
        .stat-card {
            background: var(--glass); border: 1px solid var(--glass-border);
            border-radius: var(--radius); padding: 20px 18px;
            display: flex; flex-direction: column; gap: 6px;
            box-shadow: var(--shadow-sm);
        }
        .stat-label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
        .stat-value { font-size: 2rem; font-weight: 800; }
        .stat-pending .stat-value { color: var(--yellow); }
        .stat-approved .stat-value { color: var(--green); }
        .stat-rejected .stat-value { color: var(--red); }
        .stat-total .stat-value { color: var(--accent); }

        /* ─── PAGE HEADER ─── */
        .page-header {
            display: flex; align-items: flex-start; justify-content: space-between;
            margin-bottom: 24px; flex-wrap: wrap; gap: 16px;
        }
        .page-header-title { font-size: 1.5rem; font-weight: 800; color: var(--text); }
        .page-header-sub { font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; }

        /* ─── EMPTY STATE ─── */
        .empty-state { text-align: center; padding: 64px 24px; }
        .empty-icon { font-size: 3rem; margin-bottom: 12px; }
        .empty-title { font-size: 1rem; font-weight: 600; color: var(--text); margin-bottom: 6px; }
        .empty-sub { font-size: 0.85rem; color: var(--text-muted); }

        /* ─── FOOTER ─── */
        .dk-footer {
            border-top: 1px solid var(--border); padding: 20px 28px;
            text-align: center; font-size: 0.78rem; color: var(--text-muted);
        }
        .dk-footer a { color: var(--accent); text-decoration: none; }

        /* ─── PAGINATION ─── */
        .pagination { display: flex; gap: 8px; justify-content: center; padding-top: 20px; list-style: none; }
        .pagination a, .pagination span {
            display: inline-block; padding: 7px 14px; border-radius: 9px;
            font-size: 0.82rem; font-weight: 600; text-decoration: none;
            border: 1px solid var(--border); color: var(--text-sub);
            background: var(--surface); transition: all 0.15s;
        }
        .pagination a:hover { background: var(--surface-hover); color: var(--text); }
        .pagination .active span { background: rgba(180, 83, 9, 0.12); color: var(--accent); border-color: rgba(180, 83, 9, 0.25); }
        .pagination .disabled a { opacity: 0.35; pointer-events: none; }

        /* ─── MONO TEXT ─── */
        .mono { font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: var(--text-muted); }

        /* ─── RESPONSIVE MEDIA QUERIES ─── */
        /* Tablets and small desktops */
        @@media (max-width: 1024px) {
            .dk-main { padding: 24px 16px 80px; }
            div[style*="grid-template-columns: 2fr 1fr"],
            div[style*="grid-template-columns: 3fr 1fr"] {
                grid-template-columns: 1fr !important;
            }
        }

        /* Mobile devices and small tablets */
        @@media (max-width: 768px) {
            div[style*="grid-template-columns: 1fr 1fr"],
            div[style*="grid-template-columns: repeat(3, 1fr)"] {
                grid-template-columns: 1fr !important;
            }
            .form-grid-2 { grid-template-columns: 1fr; }
            
            /* Navbar adjustments */
            .dk-nav { border-radius: 16px; top: 8px; width: calc(100% - 16px); }
            .dk-nav-inner { flex-direction: column; padding: 16px; gap: 16px; height: auto; }
            .dk-nav-links { width: 100%; justify-content: center; }
            .dk-nav-right { width: 100%; justify-content: center; flex-wrap: wrap; }
            
            /* Header and Flex adjustments */
            .page-header { flex-direction: column; align-items: flex-start !important; gap: 12px; }
            div[style*="display: flex; justify-content: space-between"] {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 16px !important;
            }
            div[style*="display: flex; justify-content: space-between"] > a.dk-btn,
            div[style*="display: flex; justify-content: space-between"] > button {
                width: 100%;
                justify-content: center;
            }
            
            /* Table responsiveness - horizontal scroll */
            .dk-table { display: block; overflow-x: auto; white-space: nowrap; }
        }

        /* Small mobile devices */
        @@media (max-width: 480px) {
            .stat-grid { grid-template-columns: 1fr; }
            .notif-sidebar { width: 100vw; }
            .dk-card-pad { padding: 16px; }
            .hero-title { font-size: 1.5rem; }
            
            /* Allow horizontal scroll for nav links on very small screens */
            .dk-nav-links { justify-content: flex-start; overflow-x: auto; padding-bottom: 8px; flex-wrap: nowrap; }
            .dk-nav-links::-webkit-scrollbar { display: none; }
            .dk-nav-links a { white-space: nowrap; }
        }
    </style>
</head>
<body>
@{
    var currentRole = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
    var isAuth = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "";
    var initials = userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "?";
}
<nav class="dk-nav">
    <div class="dk-nav-inner">
        <a href="/" class="dk-brand"><i data-lucide="shield-half" style="width:20px; height:20px;"></i> Vanguard</a>

        <ul class="dk-nav-links">
            <li><a href="/">Home</a></li>
            <li><a asp-controller="Recruitment" asp-action="Index"><i data-lucide="megaphone" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> Careers</a></li>
            @if (isAuth)
            {
                <li><a asp-controller="Dashboard" asp-action="Index"><i data-lucide="layout-dashboard" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> Dashboard</a></li>
                @if (currentRole == "Guard")
                {
                    <li><a asp-controller="ClientRequest" asp-action="OpenJobs"><i data-lucide="search" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> Open Deployments</a></li>
                    <li><a asp-controller="Guard" asp-action="Apply"><i data-lucide="shield-check" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> Enlistment</a></li>
                    <li><a asp-controller="Guard" asp-action="MyApplications"><i data-lucide="clipboard-list" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> Enlistment History</a></li>
                    <li><a asp-controller="GuardShift" asp-action="History"><i data-lucide="clock" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> My Shifts</a></li>
                }
                @if (currentRole == "Admin" || currentRole == "Recruiter")
                {
                    <li><a asp-controller="Analytics" asp-action="Index"><i data-lucide="pie-chart" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> Analytics</a></li>
                    
                    <!-- NEXT-GEN MEGA-MENU DROPDOWN (OPTION 1) -->
                    <li style="position: relative;" id="admin-mega-li">
                        <button type="button" class="admin-mega-btn" id="admin-mega-trigger" title="Explore All Administrative Modules">
                            <i data-lucide="layers" style="width:16px; height:16px; margin-right:4px; color:var(--accent);"></i>
                            <span>Admin Console</span>
                            <i data-lucide="chevron-down" style="width:14px; height:14px; margin-left:4px; opacity:0.7; transition: transform 0.2s;" id="mega-arrow"></i>
                        </button>
                        <div class="admin-mega-menu" id="admin-mega-popover" role="menu" aria-label="Admin Modules">
                            <!-- Column 1: Personnel & Roles -->
                            <div class="mega-col">
                                <div class="mega-col-title"><i data-lucide="users"></i> PERSONNEL & ROLES</div>
                                <a asp-controller="Users" asp-action="Index" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(180,83,9,0.1); color:var(--accent);"><i data-lucide="users"></i></div>
                                    <div>
                                        <div class="mega-item-title">User Management</div>
                                        <div class="mega-item-sub">Assign roles & clearances</div>
                                    </div>
                                </a>
                                <a asp-controller="Roles" asp-action="Index" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(180,83,9,0.1); color:var(--accent);"><i data-lucide="key"></i></div>
                                    <div>
                                        <div class="mega-item-title">Role Definitions</div>
                                        <div class="mega-item-sub">Manage system policies</div>
                                    </div>
                                </a>
                                <a asp-controller="Guard" asp-action="Applications" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(52,211,153,0.1); color:var(--green);"><i data-lucide="shield-check"></i></div>
                                    <div>
                                        <div class="mega-item-title">Recruitment Desk</div>
                                        <div class="mega-item-sub">Approve guard applicants</div>
                                    </div>
                                </a>
                                <a asp-controller="Recruitment" asp-action="Manage" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(180,83,9,0.1); color:var(--accent);"><i data-lucide="file-text"></i></div>
                                    <div>
                                        <div class="mega-item-title">Deployment Notices</div>
                                        <div class="mega-item-sub">Post hiring notices</div>
                                    </div>
                                </a>
                            </div>

                            <!-- Column 2: Operations & Petitions -->
                            <div class="mega-col">
                                <div class="mega-col-title"><i data-lucide="shield-alert"></i> OPERATIONS & PETITIONS</div>
                                <a asp-controller="ClientRequest" asp-action="AdminRequests" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(180,83,9,0.1); color:var(--accent);"><i data-lucide="shield-alert"></i></div>
                                    <div>
                                        <div class="mega-item-title">Client Petitions</div>
                                        <div class="mega-item-sub">Deploy tactical forces</div>
                                    </div>
                                </a>
                                <a asp-controller="VIPRequest" asp-action="AdminRequests" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(147,51,234,0.1); color:#9333ea;"><i data-lucide="crown"></i></div>
                                    <div>
                                        <div class="mega-item-title">VIP Requests</div>
                                        <div class="mega-item-sub">Elite protection deployments</div>
                                    </div>
                                </a>
                                <a asp-controller="VipApplication" asp-action="AdminPanel" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(147,51,234,0.1); color:#9333ea;"><i data-lucide="award"></i></div>
                                    <div>
                                        <div class="mega-item-title">VIP Applications</div>
                                        <div class="mega-item-sub">Approve elite client tiers</div>
                                    </div>
                                </a>
                                <a asp-controller="Dashboard" asp-action="Admin" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(41,37,36,0.08); color:#292524;"><i data-lucide="layout-dashboard"></i></div>
                                    <div>
                                        <div class="mega-item-title">Admin Dashboard</div>
                                        <div class="mega-item-sub">Central operations hub</div>
                                    </div>
                                </a>
                            </div>

                            <!-- Column 3: Monitoring & Logs -->
                            <div class="mega-col">
                                <div class="mega-col-title"><i data-lucide="activity"></i> MONITORING & LOGS</div>
                                <a asp-controller="Analytics" asp-action="Index" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(59,130,246,0.1); color:#3b82f6;"><i data-lucide="pie-chart"></i></div>
                                    <div>
                                        <div class="mega-item-title">Analytics Hub</div>
                                        <div class="mega-item-sub">System metrics & stats</div>
                                    </div>
                                </a>
                                <a asp-controller="Incident" asp-action="AdminPanel" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(239,68,68,0.1); color:var(--red);"><i data-lucide="alert-triangle"></i></div>
                                    <div>
                                        <div class="mega-item-title">Incident Reports</div>
                                        <div class="mega-item-sub">Manage guard & client issues</div>
                                    </div>
                                </a>
                                <a asp-controller="AuditLog" asp-action="Index" class="mega-item">
                                    <div class="mega-icon-wrap" style="background:rgba(139,92,246,0.1); color:#8b5cf6;"><i data-lucide="history"></i></div>
                                    <div>
                                        <div class="mega-item-title">Audit Logs</div>
                                        <div class="mega-item-sub">Monitor system activity</div>
                                    </div>
                                </a>
                                <a href="/DangerZone" class="mega-item danger-item">
                                    <div class="mega-icon-wrap" style="background:rgba(239,68,68,0.15); color:#ef4444;"><i data-lucide="flame"></i></div>
                                    <div>
                                        <div class="mega-item-title" style="color:#ef4444;">Danger Zone</div>
                                        <div class="mega-item-sub">Purge records & users</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </li>

                    <!-- COMMAND PALETTE TRIGGER PILL (OPTION 2) -->
                    <li>
                        <button type="button" class="cmd-trigger-pill" id="open-cmd-palette" title="Press Ctrl + K or Cmd + K anywhere to jump instantly">
                            <i data-lucide="search" style="width:14px; height:14px; opacity:0.8;"></i>
                            <span>Quick Jump...</span>
                            <kbd class="kbd-shortcut">Ctrl + K</kbd>
                        </button>
                    </li>
                }
                @if (currentRole == "Client")
                {
                    <li><a asp-controller="ClientRequest" asp-action="MyRequests"><i data-lucide="file-text" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> My Requests</a></li>
                    <li><a asp-controller="ClientRequest" asp-action="Create"><i data-lucide="shield-alert" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> Request Patrol</a></li>
                }
                @if (currentRole == "VIP Client" || currentRole == "VIP")
                {
                    <li><a asp-controller="VIPRequest" asp-action="Create"><i data-lucide="shield-plus" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> New Request</a></li>
                    <li><a asp-controller="VIPRequest" asp-action="MyRequests"><i data-lucide="list" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> My Requests</a></li>
                    <li><a asp-controller="Dashboard" asp-action="Vip"><i data-lucide="crown" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> Elite Console</a></li>
                }
            }
        </ul>

        <ul class="dk-nav-right">
            @if (isAuth)
            {
                <li>
                    <button id="notif-bell" class="notif-bell-btn" aria-label="Notifications">
                        <i data-lucide="bell" style="width:20px; height:20px;"></i>
                        <span id="notif-badge" class="notif-badge" style="display:none;">0</span>
                    </button>
                </li>
                <li>
                    <div class="user-chip">
                        <div class="user-avatar">@initials</div>
                        <span class="user-name">@userName</span>
                        <span class="role-pill">@currentRole</span>
                    </div>
                </li>
                <li>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                        <button type="submit" class="btn-logout">Sign out</button>
                    </form>
                </li>
            }
            else
            {
                <li><a href="/Auth/Login" class="dk-btn dk-btn-ghost" style="font-size:0.82rem; padding:6px 14px;">Login</a></li>
                <li><a href="/Auth/Register" class="dk-btn dk-btn-primary" style="font-size:0.82rem; padding:6px 14px;">Register</a></li>
            }
        </ul>
    </div>
</nav>

<!-- ═══ NOTIFICATION SIDEBAR ═══ -->
<div id="notif-overlay" class="notif-overlay" aria-hidden="true"></div>
<aside id="notif-sidebar" class="notif-sidebar" role="dialog" aria-label="Notifications" aria-modal="true">
    <div class="notif-sb-header">
        <div class="notif-sb-title">
            <span class="nb-icon">🔔</span> Notifications
        </div>
        <div class="notif-sb-actions">
            <button id="notif-mark-all" class="notif-mark-all" style="margin-right:8px;">Mark all read</button>
            <button id="notif-clear-all" class="notif-mark-all" style="color:#ef4444; border-color:rgba(239, 68, 68, 0.3); background:rgba(239, 68, 68, 0.05); margin-right:12px;">Delete Selected</button>
            <button id="notif-close" class="notif-close-btn" aria-label="Close notifications">
                <i data-lucide="x" style="width:16px;height:16px;"></i>
            </button>
        </div>
    </div>
    <div id="notif-list" class="notif-list">
        <div class="notif-empty">
            <div class="notif-empty-icon">🔕</div>
            <div class="notif-empty-text">All caught up!</div>
            <div class="notif-empty-sub">No notifications yet.</div>
        </div>
    </div>
    <div class="notif-sb-footer">Notifications are kept for 30 days</div>
</aside>

<!-- ═══ NEXT-GEN COMMAND PALETTE MODAL (OPTION 2) ═══ -->
<div id="cmd-modal-overlay" class="cmd-modal-overlay" aria-hidden="true">
    <div class="cmd-modal-box" role="dialog" aria-modal="true" aria-label="Command Palette">
        <div class="cmd-input-wrap">
            <i data-lucide="search" class="cmd-search-icon"></i>
            <input type="text" id="cmd-search-input" placeholder="Where do you want to navigate today? Type to filter... (e.g. Incidents, VIP)" autocomplete="off" />
            <button type="button" id="cmd-close-btn" class="cmd-esc-tag">ESC</button>
        </div>
        <div id="cmd-results-list" class="cmd-results-list">
            <!-- Dynamically populated via JS -->
        </div>
        <div class="cmd-footer">
            <span><kbd>↑</kbd> <kbd>↓</kbd> to navigate</span>
            <span><kbd>Enter</kbd> to select</span>
            <span><kbd>Esc</kbd> to close</span>
        </div>
    </div>
</div>

<main class="dk-main">
    @RenderBody()
</main>

<footer class="dk-footer">
    &copy; 2026 Vanguard Engine &mdash; <a href="/Home/Privacy">Privacy Policy</a>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script>
    lucide.createIcons();
    $(document).ready(function() {
        if ($.fn.DataTable) {
            $('.dk-table, table[style*="width: 100%"], table[style*="width:100%"]').not('.no-dt').DataTable({
                "pageLength": 10,
                "lengthMenu": [5, 10, 25, 50, 100],
                "language": {
                    "search": "<i data-lucide='search' style='width:16px;height:16px;margin-bottom:-3px;color:var(--text-muted);margin-right:6px;'></i>",
                    "searchPlaceholder": "Search records...",
                    "lengthMenu": "<span style='color:var(--text-muted);font-weight:600;margin-right:6px;'>Display</span> _MENU_",
                    "info": "<span style='color:var(--text-muted);font-weight:600;'>Showing _START_ to _END_ of _TOTAL_ entries</span>"
                },
                "drawCallback": function() {
                    lucide.createIcons();
                },
                "order": [] 
            });
        }
    });
</script>
<script src="~/js/notification.js" asp-append-version="true"></script>
<script>
    /* ═══ NEXT-GEN NAVIGATION COMBINED EXPERIENCE (MEGA-MENU + COMMAND PALETTE) ═══ */
    document.addEventListener('DOMContentLoaded', function() {
        // --- 1. Mega-Menu (Option 1) Handlers ---
        const megaTrigger = document.getElementById('admin-mega-trigger');
        const megaPopover = document.getElementById('admin-mega-popover');
        const megaArrow = document.getElementById('mega-arrow');
        const megaLi = document.getElementById('admin-mega-li');

        if (megaTrigger && megaPopover) {
            megaTrigger.addEventListener('click', function(e) {
                e.stopPropagation();
                const isShown = megaPopover.classList.contains('show');
                if (isShown) {
                    megaPopover.classList.remove('show');
                    megaTrigger.classList.remove('active');
                    if (megaArrow) megaArrow.style.transform = 'rotate(0deg)';
                } else {
                    megaPopover.classList.add('show');
                    megaTrigger.classList.add('active');
                    if (megaArrow) megaArrow.style.transform = 'rotate(180deg)';
                    if (window.lucide) lucide.createIcons();
                }
            });

            document.addEventListener('click', function(e) {
                if (megaLi && !megaLi.contains(e.target) && megaPopover.classList.contains('show')) {
                    megaPopover.classList.remove('show');
                    if (megaTrigger) megaTrigger.classList.remove('active');
                    if (megaArrow) megaArrow.style.transform = 'rotate(0deg)';
                }
            });
        }

        // --- 2. Command Palette / Spotlight (Option 2) Handlers ---
        const cmdOverlay = document.getElementById('cmd-modal-overlay');
        const cmdInput = document.getElementById('cmd-search-input');
        const cmdResults = document.getElementById('cmd-results-list');
        const cmdCloseBtn = document.getElementById('cmd-close-btn');
        const openCmdBtn = document.getElementById('open-cmd-palette');

        const adminModules = [
            { title: "User Management", sub: "Assign roles & security clearances", category: "Personnel", url: "/Users", icon: "users", color: "#92400e", bg: "rgba(180, 83, 9, 0.1)" },
            { title: "Role Definitions", sub: "Manage backend roles and security policies", category: "Personnel", url: "/Roles", icon: "key", color: "#92400e", bg: "rgba(180, 83, 9, 0.1)" },
            { title: "Recruitment Desk", sub: "Approve or reject guard applicants", category: "Personnel", url: "/Guard/Applications", icon: "shield-check", color: "#15803d", bg: "rgba(52, 211, 153, 0.1)" },
            { title: "Deployment Notices", sub: "Post new hiring notices for security guards", category: "Personnel", url: "/Recruitment/Manage", icon: "file-text", color: "#92400e", bg: "rgba(180, 83, 9, 0.1)" },
            { title: "Client Petitions", sub: "Deploy tactical forces & patrol schedules to clients", category: "Operations", url: "/ClientRequest/AdminRequests", icon: "shield-alert", color: "#92400e", bg: "rgba(180, 83, 9, 0.1)" },
            { title: "VIP Requests", sub: "Elite executive protection deployments", category: "Operations", url: "/VIPRequest/AdminRequests", icon: "crown", color: "#9333ea", bg: "rgba(147, 51, 234, 0.1)" },
            { title: "VIP Applications", sub: "Approve elite client tiers and credentials", category: "Operations", url: "/VipApplication/AdminPanel", icon: "award", color: "#9333ea", bg: "rgba(147, 51, 234, 0.1)" },
            { title: "Analytics Hub", sub: "System metrics, guard ratings & performance charts", category: "Monitoring", url: "/Analytics", icon: "pie-chart", color: "#3b82f6", bg: "rgba(59, 130, 246, 0.1)" },
            { title: "Incident Reports", sub: "Manage guard issues, alarms & client complaints", category: "Monitoring", url: "/Incident/AdminPanel", icon: "alert-triangle", color: "#b91c1c", bg: "rgba(239, 68, 68, 0.1)" },
            { title: "Audit Logs", sub: "Track and monitor all system activity & entity logs", category: "Monitoring", url: "/AuditLog", icon: "history", color: "#8b5cf6", bg: "rgba(139, 92, 246, 0.1)" },
            { title: "Danger Zone", sub: "Permanently purge records and users", category: "System", url: "/DangerZone", icon: "flame", color: "#ef4444", bg: "rgba(239, 68, 68, 0.15)", isDanger: true },
            { title: "Admin Operations Center", sub: "Return to main administrative root console", category: "General", url: "/Dashboard/Admin", icon: "layout-dashboard", color: "#292524", bg: "rgba(41, 37, 36, 0.1)" }
        ];

        let selectedIndex = 0;
        let currentResults = [];

        function openPalette() {
            if (!cmdOverlay) return;
            cmdOverlay.classList.add('open');
            cmdOverlay.setAttribute('aria-hidden', 'false');
            if (cmdInput) {
                cmdInput.value = '';
                cmdInput.focus();
            }
            renderResults('');
            if (megaPopover && megaPopover.classList.contains('show')) {
                megaPopover.classList.remove('show');
                if (megaTrigger) megaTrigger.classList.remove('active');
                if (megaArrow) megaArrow.style.transform = 'rotate(0deg)';
            }
        }

        function closePalette() {
            if (!cmdOverlay) return;
            cmdOverlay.classList.remove('open');
            cmdOverlay.setAttribute('aria-hidden', 'true');
        }

        function renderResults(query) {
            if (!cmdResults) return;
            const q = query.toLowerCase().trim();
            currentResults = adminModules.filter(m => 
                m.title.toLowerCase().includes(q) || 
                m.sub.toLowerCase().includes(q) || 
                m.category.toLowerCase().includes(q)
            );

            selectedIndex = 0;
            if (currentResults.length === 0) {
                cmdResults.innerHTML = '<div class="cmd-no-results">No matching administrative modules found.</div>';
                return;
            }

            let html = '';
            currentResults.forEach((m, idx) => {
                const isSelected = idx === selectedIndex ? 'selected' : '';
                const dangerStyle = m.isDanger ? 'color:#ef4444;' : '';
                html += `
                    <a href="${m.url}" class="cmd-item ${isSelected}" data-idx="${idx}">
                        <div class="cmd-item-left">
                            <div class="cmd-icon-wrap" style="background:${m.bg}; color:${m.color};">
                                <i data-lucide="${m.icon}"></i>
                            </div>
                            <div class="cmd-title-group">
                                <div class="cmd-item-title" style="${dangerStyle}">${m.title}</div>
                                <div class="cmd-item-sub">${m.sub}</div>
                            </div>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span class="cmd-cat-badge">${m.category}</span>
                            <i data-lucide="arrow-right" style="width:16px; height:16px; color:var(--text-muted); opacity:0.6;"></i>
                        </div>
                    </a>
                `;
            });

            cmdResults.innerHTML = html;
            if (window.lucide) lucide.createIcons();
        }

        function updateSelection() {
            const items = cmdResults ? cmdResults.querySelectorAll('.cmd-item') : [];
            items.forEach((item, idx) => {
                if (idx === selectedIndex) {
                    item.classList.add('selected');
                    item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                } else {
                    item.classList.remove('selected');
                }
            });
        }

        if (openCmdBtn) {
            openCmdBtn.addEventListener('click', function(e) {
                e.preventDefault();
                openPalette();
            });
        }

        if (cmdCloseBtn) {
            cmdCloseBtn.addEventListener('click', closePalette);
        }

        if (cmdOverlay) {
            cmdOverlay.addEventListener('click', function(e) {
                if (e.target === cmdOverlay) closePalette();
            });
        }

        if (cmdInput) {
            cmdInput.addEventListener('input', function(e) {
                renderResults(e.target.value);
            });

            cmdInput.addEventListener('keydown', function(e) {
                if (currentResults.length === 0) return;
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    selectedIndex = (selectedIndex + 1) % currentResults.length;
                    updateSelection();
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    selectedIndex = (selectedIndex - 1 + currentResults.length) % currentResults.length;
                    updateSelection();
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    const target = currentResults[selectedIndex];
                    if (target) window.location.href = target.url;
                }
            });
        }

        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                if (cmdOverlay && cmdOverlay.classList.contains('open')) {
                    closePalette();
                } else {
                    openPalette();
                }
            }
            if (e.key === 'Escape' && cmdOverlay && cmdOverlay.classList.contains('open')) {
                closePalette();
            }
        });
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
