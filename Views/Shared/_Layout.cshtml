@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vanguard Engine</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
@{
    var currentRole = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "";
}

    <!-- ── NAVBAR ── -->
    <nav class="vg-nav">
        <div class="vg-nav-inner">

            <a href="/" class="vg-brand">
                <span style="font-size:1.4rem;">⚔️</span> Vanguard
            </a>

            <ul class="vg-nav-links">
                <li><a href="/">Home</a></li>

                @if (isAuthenticated)
                {
                    @if (currentRole == "Guard")
                    {
                        <li>
                            <a asp-controller="Guard" asp-action="Apply"
                               style="background: rgba(79,70,229,0.1); color: #4f46e5; font-weight: 600;">
                                🛡️ Apply as Guard
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Guard" asp-action="MyApplications">📋 My Applications</a>
                        </li>
                    }
                    @if (currentRole == "Admin" || currentRole == "Recruiter" || currentRole == "Client")
                    {
                        <li>
                            <a asp-controller="Guard" asp-action="Applications"
                               style="background: rgba(16,185,129,0.1); color: #059669; font-weight: 600;">
                                👁️ Guard Applications
                            </a>
                        </li>
                    }
                    @if (currentRole == "Admin")
                    {
                        <li><a asp-controller="Roles" asp-action="Index">🔑 Roles</a></li>
                        <li><a asp-controller="Users" asp-action="Index">👥 Users</a></li>
                    }
                }
            </ul>

            <ul class="vg-nav-right">
                @if (isAuthenticated)
                {
                    <li>
                        <span class="vg-user-chip">
                            @userName
                            <span class="vg-role-badge">@currentRole</span>
                        </span>
                    </li>
                    <li>
                        <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                            <button type="submit" class="vg-btn-logout">Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li>
                        <a href="/Auth/Login"
                           style="color:#475569; text-decoration:none; font-size:0.875rem; font-weight:500; padding:6px 14px; border-radius:10px; transition:all 0.2s; display:inline-block;">
                            Login
                        </a>
                    </li>
                    <li><a href="/Auth/Register" class="vg-btn-primary">Register</a></li>
                }
            </ul>

        </div>
    </nav>

    <!-- ── MAIN ── -->
    <div class="vg-main">
        @RenderBody()
    </div>

    <!-- ── FOOTER ── -->
    <footer class="vg-footer">
        &copy; 2026 Vanguard Engine &mdash; <a href="/Home/Privacy">Privacy</a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
