@model List<Vanguard_Engine.Entities.ClientRequest>
@{
    ViewData["Title"] = "My Deployment Petitions";
    var guardMap = ViewBag.GuardNames as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="page-header">
    <div>
        <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 6px;">Client Service Portal</div>
        <h1 class="page-header-title">My Security Requests</h1>
        <p class="page-header-sub">Track active deployment status, patrol parameters, and assigned tactical officers.</p>
    </div>
    <div>
        <a asp-action="Create" class="dk-btn dk-btn-primary">
            <i data-lucide="plus-circle" style="width:16px; height:16px;"></i> Draft New Petition
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="dk-alert dk-alert-success" style="margin-bottom: 20px;">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="dk-alert dk-alert-error" style="margin-bottom: 20px;">
        @TempData["Error"]
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="dk-card dk-card-pad" style="text-align: center; padding: 48px; border-style: dashed; border-color: rgba(180, 83, 9, 0.4);">
        <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(180, 83, 9, 0.1); color: var(--accent); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
            <i data-lucide="shield-alert" style="width: 28px; height: 28px;"></i>
        </div>
        <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text); margin: 0 0 10px;">No Active Requests</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem; max-width: 440px; margin: 0 auto 24px; line-height: 1.6;">
            You have not drafted any security guard deployment requests yet. File a petition to assign tactical guards to your commercial or residential sites.
        </p>
        <a asp-action="Create" class="dk-btn dk-btn-primary">
            <i data-lucide="file-signature" style="width: 16px; height: 16px;"></i> Submit First Request
        </a>
    </div>
}
else
{
    <div style="display: flex; flex-direction: column; gap: 20px;">
        @foreach (var request in Model)
        {
            <div class="dk-card dk-card-pad" style="transition: all 0.25s;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 16px;">
                    <div>
                        <div style="font-size: 0.74rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted);">Deployment Target</div>
                        <h2 style="font-size: 1.2rem; font-weight: 800; color: var(--text); margin: 4px 0 0;"><i data-lucide="map-pin" style="width: 16px; height: 16px; display: inline-block; vertical-align: -2px; margin-right: 4px; color: var(--accent);"></i> @request.Location</h2>
                    </div>

                    <div>
                        @if (request.Status == "Approved")
                        {
                            <span class="badge-approved" style="padding: 6px 14px; border-radius: 100px; font-size: 0.78rem; font-weight: 700; background: rgba(52, 211, 153, 0.1); color: var(--green); border: 1px solid rgba(52, 211, 153, 0.2);">
                                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--green); display: inline-block; margin-right: 4px;"></span> Approved & Active
                            </span>
                        }
                        else if (request.Status == "Rejected")
                        {
                            <span class="badge-rejected" style="padding: 6px 14px; border-radius: 100px; font-size: 0.78rem; font-weight: 700; background: rgba(239, 68, 68, 0.1); color: var(--red); border: 1px solid rgba(239, 68, 68, 0.2);">
                                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--red); display: inline-block; margin-right: 4px;"></span> Declined
                            </span>
                        }
                        else
                        {
                            <span class="badge-pending" style="padding: 6px 14px; border-radius: 100px; font-size: 0.78rem; font-weight: 700; background: rgba(217, 119, 6, 0.1); color: var(--yellow); border: 1px solid rgba(217, 119, 6, 0.2);">
                                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--yellow); display: inline-block; margin-right: 4px;"></span> Pending Vetting
                            </span>
                        }
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; font-size: 0.86rem; line-height: 1.5;">
                    <div>
                        <span style="color: var(--text-muted);">Required Operators:</span>
                        <div style="font-weight: 700; color: var(--text); font-size: 1rem;">@request.NumberOfGuards Tactical Guards</div>
                    </div>
                    <div>
                        <span style="color: var(--text-muted);">Shift Duration:</span>
                        <div style="font-weight: 700; color: var(--text); font-size: 1rem;">@request.Duration</div>
                    </div>
                </div>

                <!-- Assigned Guards Display -->
                <div style="border-top: 1px solid var(--border); margin-top: 18px; padding-top: 16px;">
                    <div style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Assigned Tactical Personnel</div>
                    
                    @if (request.AssignedGuardIds != null && request.AssignedGuardIds.Any())
                    {
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            @foreach (var guardId in request.AssignedGuardIds)
                            {
                                var name = guardMap.ContainsKey(guardId) ? guardMap[guardId] : "Officer #" + guardId.Substring(0, Math.Min(guardId.Length, 5));
                                <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 8px; background: rgba(180, 83, 9, 0.08); border: 1px solid rgba(180, 83, 9, 0.15); color: var(--accent); font-size: 0.8rem; font-weight: 700;">
                                    <i data-lucide="shield" style="width: 14px; height: 14px;"></i> @name
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="font-size: 0.82rem; color: var(--text-muted); font-style: italic;">
                            <i data-lucide="info" style="width: 14px; height: 14px; display: inline-block; vertical-align: -2px; margin-right: 2px;"></i> Tactical operators will be assigned once approved.
                        </div>
                    }
                </div>

                @if (request.Status == "Pending")
                {
                    <div style="display: flex; justify-content: flex-end; margin-top: 14px; border-top: 1px dashed var(--border); padding-top: 12px;">
                        <form asp-action="Cancel" method="post" onsubmit="return confirm('Are you sure you want to cancel this deployment petition?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@request.Id" />
                            <button type="submit" class="dk-btn dk-btn-ghost dk-btn-sm" style="color: var(--red); border-color: rgba(239, 68, 68, 0.25); box-shadow: none;">
                                <i data-lucide="trash" style="width: 14px; height: 14px; margin-right: 4px; display: inline-block; vertical-align: -2px;"></i> Cancel Request
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}
