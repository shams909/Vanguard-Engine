@model List<Vanguard_Engine.Entities.ClientRequest>
@{
    ViewData["Title"] = "Open Tactical Deployments";
    var guardStatus = ViewBag.GuardStatus as string ?? "Available";
    var appliedIds = ViewBag.AppliedRequestIds as List<string> ?? new List<string>();
}

<div class="page-header">
    <div>
        <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 6px;">Deployment Board</div>
        <h1 class="page-header-title">Open Tactical Deployments</h1>
        <p class="page-header-sub">Browse client security requirements and apply for active duty patrol assignments.</p>
    </div>
    <div>
        @if (guardStatus == "Busy")
        {
            <span class="badge-rejected" style="padding: 8px 16px; border-radius: 100px; font-size: 0.8rem; font-weight: 700; background: rgba(239, 68, 68, 0.1); color: var(--red); border: 1px solid rgba(239, 68, 68, 0.2);">
                <i data-lucide="shield-off" style="width: 14px; height: 14px; display: inline-block; vertical-align: -2px; margin-right: 4px;"></i> Status: Busy (On Duty)
            </span>
        }
        else
        {
            <span class="badge-approved" style="padding: 8px 16px; border-radius: 100px; font-size: 0.8rem; font-weight: 700; background: rgba(52, 211, 153, 0.1); color: var(--green); border: 1px solid rgba(52, 211, 153, 0.2);">
                <i data-lucide="shield" style="width: 14px; height: 14px; display: inline-block; vertical-align: -2px; margin-right: 4px;"></i> Status: Available for Duty
            </span>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="dk-alert dk-alert-success" style="margin-bottom: 24px;">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="dk-alert dk-alert-error" style="margin-bottom: 24px;">
        @TempData["Error"]
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="dk-card dk-card-pad" style="text-align: center; padding: 48px; border-style: dashed; border-color: rgba(180, 83, 9, 0.4);">
        <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(180, 83, 9, 0.1); color: var(--accent); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
            <i data-lucide="inbox" style="width: 28px; height: 28px;"></i>
        </div>
        <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text); margin: 0 0 10px;">Deployment Board Empty</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem; max-width: 440px; margin: 0 auto; line-height: 1.6;">
            There are no active deployment posts available for application at the moment. Please check back later.
        </p>
    </div>
}
else
{
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        @foreach (var request in Model)
        {
            var isApplied = appliedIds.Contains(request.Id);
            var isFull = request.AssignedGuardIds != null && request.AssignedGuardIds.Count >= request.NumberOfGuards;

            <div class="dk-card dk-card-pad" style="display: flex; flex-direction: column; justify-content: space-between; border-color: @(isApplied ? "rgba(180, 83, 9, 0.45)" : "var(--border)"); background: @(isApplied ? "linear-gradient(135deg, rgba(180, 83, 9, 0.02), rgba(255,255,255,0.45))" : "rgba(255,255,255,0.45)");">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                        <span style="font-size: 0.74rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Active Duty Post</span>
                        
                        @if (isApplied)
                        {
                            <span style="font-size: 0.74rem; font-weight: 700; color: var(--accent); background: rgba(180, 83, 9, 0.1); padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(180, 83, 9, 0.15);">
                                <i data-lucide="clock" style="width: 12px; height: 12px; display: inline-block; vertical-align: -2px; margin-right: 2px;"></i> Applied
                            </span>
                        }
                        else if (isFull)
                        {
                            <span style="font-size: 0.74rem; font-weight: 700; color: var(--green); background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px;">
                                <i data-lucide="check-circle" style="width: 12px; height: 12px; display: inline-block; vertical-align: -2px; margin-right: 2px;"></i> Roster Filled
                            </span>
                        }
                        else
                        {
                            <span style="font-size: 0.74rem; font-weight: 700; color: var(--green); background: rgba(52, 211, 153, 0.1); padding: 4px 10px; border-radius: 8px;">
                                Open Job
                            </span>
                        }
                    </div>

                    <h2 style="font-size: 1.15rem; font-weight: 800; color: var(--text); margin: 0 0 16px;"><i data-lucide="map-pin" style="width:16px; height:16px; display:inline-block; vertical-align:-2px; color:var(--accent); margin-right:4px;"></i> @request.Location</h2>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; font-size: 0.82rem; line-height: 1.4; border-top: 1px solid var(--border); padding-top: 12px; margin-bottom: 20px;">
                        <div>
                            <span style="color: var(--text-muted); display: block;">Shift Option:</span>
                            <strong style="color: var(--text);">@request.Duration</strong>
                        </div>
                        <div>
                            <span style="color: var(--text-muted); display: block;">Personnel Roster:</span>
                            <strong style="color: var(--text);">@(request.AssignedGuardIds?.Count ?? 0) / @request.NumberOfGuards Guards</strong>
                        </div>
                    </div>
                </div>

                <div>
                    @if (isApplied)
                    {
                        <button class="dk-btn dk-btn-ghost" style="width: 100%; pointer-events: none; border-style: dashed;" disabled>
                            <i data-lucide="hourglass" style="width: 16px; height: 16px;"></i> Pending Client Review
                        </button>
                    }
                    else if (isFull)
                    {
                        <button class="dk-btn dk-btn-ghost" style="width: 100%; pointer-events: none;" disabled>
                            Roster Fully Mapped
                        </button>
                    }
                    else if (guardStatus == "Busy")
                    {
                        <button class="dk-btn dk-btn-ghost" style="width: 100%; border-color: rgba(239, 68, 68, 0.15); color: var(--text-muted);" disabled title="You already have an active assignment.">
                            Active Assignment
                        </button>
                    }
                    else
                    {
                        <form asp-action="Apply" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@request.Id" />
                            <button type="submit" class="dk-btn dk-btn-primary" style="width: 100%;">
                                <i data-lucide="file-signature" style="width: 16px; height: 16px;"></i> Apply for Duty
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
