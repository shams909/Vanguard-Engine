@model Vanguard_Engine.Models.RolesCreateViewModel
@{
    ViewData["Title"] = "Create Role";
}

<div class="page-hero">
    <div class="hero-icon">🔑</div>
    <h1 class="hero-title">Create Role</h1>
    <p class="hero-sub">Define a new system access role</p>
</div>

<div class="dk-card" style="max-width:520px; margin:0 auto;">
    <form asp-action="Create" method="post" class="app-form">
        <div class="form-section">
            <div class="form-group">
                <label asp-for="RoleName" class="dk-label">Role Name <span class="req">*</span></label>
                <input class="dk-input" asp-for="RoleName" placeholder="e.g. Admin, Guard, Recruiter" />
                <span asp-validation-for="RoleName" class="field-err"></span>
            </div>
        </div>
        <div class="form-section">
            <div class="form-group">
                <label asp-for="Description" class="dk-label">Description</label>
                <textarea class="dk-input dk-textarea" asp-for="Description" rows="3"
                          placeholder="Describe the access level and responsibilities of this role..."></textarea>
                <span asp-validation-for="Description" class="field-err"></span>
            </div>
        </div>
        <div class="form-section" style="display:flex; gap:12px; justify-content:flex-end;">
            <a asp-action="Index" class="dk-btn dk-btn-ghost">Cancel</a>
            <button type="submit" class="dk-btn dk-btn-primary">Create Role</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
