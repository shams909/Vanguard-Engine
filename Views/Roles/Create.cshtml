@model Vanguard_Engine.Models.RolesCreateViewModel
@{
    ViewData["Title"] = "Create Role";
}

<h2>Create Role</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">Role Name</label>
        <input class="form-control" asp-for="Role.RoleName" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" asp-for="Role.Description"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
