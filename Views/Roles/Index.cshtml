@model Vanguard_Engine.Models.RolesIndexViewModel
@{
    ViewData["Title"] = "Roles";
}

<h2>Roles</h2>

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Add Role</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Role Name</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var role in Model.Roles)
    {
        <tr>
            <td>@role.Id</td>
            <td>@role.RoleName</td>
            <td>@role.Description</td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Previous</a>
        </li>
        <li class="page-item">
            <span class="page-link">Page @Model.PageNumber</span>
        </li>
        <li class="page-item">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
        </li>
    </ul>
</nav>
