@model Vanguard_Engine.Models.VerifyOtpViewModel
@{
    ViewData["Title"] = "Verify OTP";
}

<div style="min-height:calc(100vh - 140px); display:flex; align-items:center; justify-content:center; padding:32px 20px;">
    <div style="width:100%; max-width:420px;">

        <!-- Logo / Icon -->
        <div style="text-align:center; margin-bottom:32px;">
            <div style="width:56px; height:56px; border-radius:18px; background:linear-gradient(135deg,#0369a1,#075985); display:flex; align-items:center; justify-content:center; margin:0 auto 16px; box-shadow:0 8px 24px rgba(3,105,161,0.25);">
                <i data-lucide="mail-check" style="width:28px; height:28px; color:#fff;"></i>
            </div>
            <h1 style="font-size:1.6rem; font-weight:800; color:var(--text); margin:0 0 6px; letter-spacing:-0.5px;">Check Your Inbox</h1>
            <p style="color:var(--text-muted); font-size:0.875rem; margin:0;">
                We sent a 6-digit verification code to<br />
                <strong style="color:var(--text);">@Model.Email</strong>
            </p>
        </div>

        <!-- Card -->
        <div class="dk-card dk-card-pad">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="dk-alert dk-alert-success" style="margin-bottom:16px; font-size:0.85rem; display:flex; align-items:flex-start; gap:8px;">
                    <i data-lucide="check-circle-2" style="width:16px; height:16px; flex-shrink:0; margin-top:2px;"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="dk-alert dk-alert-error" style="margin-bottom:16px; font-size:0.85rem;"></div>

            <form asp-action="VerifyOtp" method="post" style="display:flex; flex-direction:column; gap:16px;">
                <input type="hidden" asp-for="Email" />

                <div>
                    <label asp-for="Otp" class="dk-label" style="text-align:center; display:block; margin-bottom:10px;">Verification Code</label>
                    <input asp-for="Otp" type="text" inputmode="numeric" pattern="\d{6}" maxlength="6"
                           class="dk-input" style="font-size:1.5rem; text-align:center; letter-spacing:0.5rem; font-weight:700; font-family:monospace; padding:16px;"
                           placeholder="••••••" autocomplete="one-time-code" autofocus />
                    <span asp-validation-for="Otp" class="field-err" style="text-align:center; display:block; margin-top:8px;"></span>
                </div>

                <button type="submit" class="dk-btn dk-btn-primary"
                        style="width:100%; justify-content:center; padding:12px; font-size:0.9rem; border-radius:14px; margin-top:4px; gap:8px;">
                    <i data-lucide="shield-check" style="width:16px; height:16px;"></i>
                    Verify Code
                </button>
            </form>
            
            <div style="margin-top:24px; text-align:center; border-top:1px solid var(--border); padding-top:16px;">
                <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:8px;">Didn't receive the email?</p>
                
                <form asp-action="ResendOtp" method="post" id="resend-form">
                    <input type="hidden" name="email" value="@Model.Email" />
                    <button type="submit" id="resend-btn" class="dk-btn" disabled
                            style="width:100%; justify-content:center; background:var(--surface); color:var(--text-muted); padding:10px; font-size:0.85rem; border:1px solid var(--border);">
                        <i data-lucide="refresh-cw" style="width:14px; height:14px;"></i>
                        <span id="resend-text">Resend Code in <span id="countdown">60</span>s</span>
                    </button>
                </form>
            </div>
            
        </div>

        <p style="text-align:center; margin-top:20px; font-size:0.85rem; color:var(--text-muted);">
            <a asp-action="Login" style="color:var(--accent); font-weight:600; text-decoration:none;">← Back to Sign In</a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Countdown timer for Resend button
        let timeLeft = 60;
        const countdownEl = document.getElementById('countdown');
        const resendBtn = document.getElementById('resend-btn');
        const resendText = document.getElementById('resend-text');

        const timer = setInterval(() => {
            timeLeft--;
            if (countdownEl) countdownEl.innerText = timeLeft;
            
            if (timeLeft <= 0) {
                clearInterval(timer);
                resendBtn.disabled = false;
                resendBtn.style.color = 'var(--text)';
                resendBtn.style.borderColor = 'var(--border-strong)';
                resendBtn.style.cursor = 'pointer';
                resendText.innerText = 'Resend Code Now';
            }
        }, 1000);
    </script>
}
