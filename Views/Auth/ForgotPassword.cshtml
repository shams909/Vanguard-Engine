@model Vanguard_Engine.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div style="min-height:calc(100vh - 140px); display:flex; align-items:center; justify-content:center; padding:32px 20px;">
    <div style="width:100%; max-width:420px;">

        <!-- Logo / Icon -->
        <div style="text-align:center; margin-bottom:32px;">
            <div style="width:56px; height:56px; border-radius:18px; background:linear-gradient(135deg,#d97706,#9a3412); display:flex; align-items:center; justify-content:center; margin:0 auto 16px; box-shadow:0 8px 24px rgba(180,83,9,0.25);">
                <i data-lucide="key-round" style="width:28px; height:28px; color:#fff;"></i>
            </div>
            <h1 style="font-size:1.6rem; font-weight:800; color:var(--text); margin:0 0 6px; letter-spacing:-0.5px;">Forgot Password?</h1>
            <p style="color:var(--text-muted); font-size:0.875rem; margin:0;">Enter your registered email and we'll send you a secure reset link.</p>
        </div>

        <!-- Card -->
        <div class="dk-card dk-card-pad">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="dk-alert" style="margin-bottom:16px; font-size:0.85rem; background:rgba(16,185,129,0.08); color:#10b981; border:1px solid rgba(16,185,129,0.2); padding:12px 14px; border-radius:10px; display:flex; align-items:flex-start; gap:8px;">
                    <i data-lucide="check-circle-2" style="width:16px; height:16px; flex-shrink:0; margin-top:2px;"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="dk-alert dk-alert-error" style="margin-bottom:16px; font-size:0.85rem; display:flex; align-items:flex-start; gap:8px;">
                    <i data-lucide="alert-circle" style="width:16px; height:16px; flex-shrink:0; margin-top:2px;"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="dk-alert dk-alert-error" style="margin-bottom:16px; font-size:0.85rem;"></div>

            <form asp-action="ForgotPassword" method="post" style="display:flex; flex-direction:column; gap:16px;">

                <div>
                    <label asp-for="Email" class="dk-label">Email address</label>
                    <input asp-for="Email" id="forgot-email" class="dk-input" type="email"
                           placeholder="you@example.com" autocomplete="email"
                           style="margin-top:6px;" />
                    <span asp-validation-for="Email" class="field-err"></span>
                </div>

                <button id="forgot-submit-btn" type="submit" class="dk-btn dk-btn-primary"
                        style="width:100%; justify-content:center; padding:12px; font-size:0.9rem; border-radius:14px; margin-top:4px; gap:8px;">
                    <i data-lucide="send" style="width:16px; height:16px;"></i>
                    Send Reset Link
                </button>

            </form>
        </div>

        <p style="text-align:center; margin-top:20px; font-size:0.85rem; color:var(--text-muted);">
            Remember your password?
            <a asp-action="Login" style="color:var(--accent); font-weight:600; text-decoration:none;">Back to Sign In</a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
