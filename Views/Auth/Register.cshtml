@model Vanguard_Engine.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div style="min-height: calc(100vh - 200px); display:flex; align-items:center; justify-content:center; padding: 40px 20px;">
    <div class="glass-card" style="max-width:520px;">

        <div style="text-align:center; margin-bottom:28px;">
            <div style="font-size:3rem;">🛡️</div>
            <h1 style="font-size:1.6rem; font-weight:800; color:#1e293b; margin:8px 0 4px;">Join Vanguard</h1>
            <p style="color:#64748b; font-size:0.875rem; margin:0;">Create your account to get started</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert-error"></div>

        <form asp-action="Register" method="post" style="display:flex; flex-direction:column; gap:16px;">

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div>
                    <label asp-for="Username" class="vg-label">Username</label>
                    <input asp-for="Username" class="vg-input" placeholder="johndoe" autocomplete="username" />
                    <span asp-validation-for="Username" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="Email" class="vg-label">Email</label>
                    <input asp-for="Email" class="vg-input" type="email" placeholder="you@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
            </div>

            <div>
                <label asp-for="Address" class="vg-label">Address</label>
                <input asp-for="Address" class="vg-input" placeholder="Your address" autocomplete="street-address" />
                <span asp-validation-for="Address" class="field-validation-error"></span>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div>
                    <label asp-for="Password" class="vg-label">Password</label>
                    <input asp-for="Password" class="vg-input" type="password" placeholder="••••••••" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="vg-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="vg-input" type="password" placeholder="••••••••" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
            </div>

            <div>
                <label asp-for="UserRole" class="vg-label">I want to...</label>
                <select asp-for="UserRole" class="vg-input" style="cursor:pointer; appearance:auto;">
                    <option value="Guard">🛡️ Apply as a Security Guard</option>
                    <option value="Client">👔 Recruit Security Guards</option>
                </select>
                <span asp-validation-for="UserRole" class="field-validation-error"></span>
            </div>

            <button type="submit" class="vg-btn-primary"
                    style="width:100%; padding:12px; font-size:0.95rem; border-radius:14px; margin-top:4px;">
                Create Account →
            </button>

        </form>

        <p style="text-align:center; margin-top:20px; font-size:0.85rem; color:#64748b;">
            Already have an account?
            <a asp-action="Login" style="color:#6366f1; font-weight:600; text-decoration:none;">Sign in</a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
