@{
    ViewData["Title"] = "Access Denied";
}

<div style="min-height: calc(100vh - 240px); display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <div class="dk-card dk-card-pad" style="max-width: 440px; width: 100%; text-align: center; background: rgba(239, 68, 68, 0.05); border-color: rgba(239, 68, 68, 0.2);">
        <div style="width: 64px; height: 64px; border-radius: 20px; background: rgba(239, 68, 68, 0.1); color: var(--red); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
            <i data-lucide="shield-alert" style="width: 32px; height: 32px;"></i>
        </div>
        <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text); margin: 0 0 12px; letter-spacing: -0.5px;">Access Denied</h1>
        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; margin: 0 0 28px;">
            You do not have the required role clearances to view this dashboard panel. Please verify your credentials or contact security operations.
        </p>
        <a href="/" class="dk-btn dk-btn-ghost" style="width: 100%; justify-content: center; border-radius: 12px;">
            <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i> Return to Headquarters
        </a>
    </div>
</div>
