@model Vanguard_Engine.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div style="min-height: calc(100vh - 200px); display:flex; align-items:center; justify-content:center; padding: 20px;">
    <div class="glass-card">

        <div style="text-align:center; margin-bottom:28px;">
            <div style="font-size:3rem;">🔐</div>
            <h1 style="font-size:1.6rem; font-weight:800; color:#1e293b; margin:8px 0 4px;">Welcome back</h1>
            <p style="color:#64748b; font-size:0.875rem; margin:0;">Sign in to your Vanguard account</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert-error"></div>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" style="display:flex; flex-direction:column; gap:16px;">

            <div>
                <label asp-for="Email" class="vg-label">Email address</label>
                <input asp-for="Email" class="vg-input" type="email" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div>
                <label asp-for="Password" class="vg-label">Password</label>
                <input asp-for="Password" class="vg-input" type="password" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div style="display:flex; align-items:center; gap:8px;">
                <input asp-for="RememberMe" type="checkbox"
                       style="width:16px; height:16px; accent-color:#6366f1; cursor:pointer;" />
                <label asp-for="RememberMe" style="font-size:0.875rem; color:#475569; cursor:pointer;">Remember me</label>
            </div>

            <button type="submit" class="vg-btn-primary"
                    style="width:100%; padding:12px; font-size:0.95rem; border-radius:14px; margin-top:4px;">
                Sign In →
            </button>

        </form>

        <p style="text-align:center; margin-top:20px; font-size:0.85rem; color:#64748b;">
            Don't have an account?
            <a asp-action="Register" style="color:#6366f1; font-weight:600; text-decoration:none;">Register here</a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
