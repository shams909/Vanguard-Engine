@model Vanguard_Engine.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div style="min-height:calc(100vh - 140px); display:flex; align-items:center; justify-content:center; padding:32px 20px;">
    <div style="width:100%; max-width:420px;">

        <!-- Logo -->
        <div style="text-align:center; margin-bottom:32px;">
            <div style="width:56px; height:56px; border-radius:18px; background:linear-gradient(135deg,#d97706,#9a3412); display:flex; align-items:center; justify-content:center; margin:0 auto 16px; box-shadow:0 8px 24px rgba(180,83,9,0.25);">
                <i data-lucide="shield-half" style="width:28px; height:28px; color:#fff;"></i>
            </div>
            <h1 style="font-size:1.6rem; font-weight:800; color:var(--text); margin:0 0 6px; letter-spacing:-0.5px;">Sign in to Vanguard</h1>
            <p style="color:var(--text-muted); font-size:0.875rem; margin:0;">Enter your credentials to access your account</p>
        </div>

        <!-- Card -->
        <div class="dk-card dk-card-pad">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="dk-alert dk-alert-error" style="margin-bottom: 16px; font-size: 0.85rem;">
                    <i data-lucide="alert-circle" style="width:16px; height:16px; vertical-align: middle; margin-right: 6px;"></i>
                    @TempData["ErrorMessage"]
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="dk-alert dk-alert-success" style="margin-bottom: 16px; font-size: 0.85rem; background: rgba(16,185,129,0.1); color: #10b981; border: 1px solid rgba(16,185,129,0.2); padding: 10px; border-radius: 8px;">
                    <i data-lucide="check-circle" style="width:16px; height:16px; vertical-align: middle; margin-right: 6px;"></i>
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["UnverifiedEmail"] != null)
            {
                <div class="dk-alert dk-alert-error" style="margin-bottom: 16px; font-size: 0.85rem; display: flex; flex-direction: column; gap: 8px; border-color: rgba(239,68,68,0.2); background: rgba(239,68,68,0.05);">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <i data-lucide="alert-triangle" style="width:16px; height:16px; color: #ef4444;"></i>
                        <span style="font-weight: 600;">Verification Required</span>
                    </div>
                    <p style="margin: 0; color: var(--text-sub);">Please verify your email before logging in.</p>
                    <form asp-action="ResendVerification" method="post" style="margin: 4px 0 0 0;">
                        <input type="hidden" name="email" value="@TempData["UnverifiedEmail"]" />
                        <button type="submit" class="dk-btn" style="padding: 6px 12px; font-size: 0.75rem; border-radius: 8px; width: fit-content; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2); color: #ef4444; cursor: pointer; transition: all 0.2s;">
                            Resend Verification Email
                        </button>
                    </form>
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="dk-alert dk-alert-error" style="margin-bottom: 16px; font-size: 0.85rem;"></div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post"
                  style="display:flex; flex-direction:column; gap:16px;">

                <div>
                    <label asp-for="Email" class="dk-label">Email address</label>
                    <input asp-for="Email" class="dk-input" type="email"
                           placeholder="you@example.com" autocomplete="email"
                           style="margin-top:6px;" />
                    <span asp-validation-for="Email" class="field-err"></span>
                </div>

                <div>
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;">
                        <label asp-for="Password" class="dk-label" style="margin:0;">Password</label>
                        <a asp-action="ForgotPassword" style="font-size:0.8rem; color:var(--accent); text-decoration:none; font-weight:500; opacity:0.85; transition:opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.85'">Forgot password?</a>
                    </div>
                    <div style="position: relative;">
                        <input asp-for="Password" class="dk-input" type="password"
                               placeholder="••••••••" autocomplete="current-password" style="padding-right: 40px;" />
                        <button type="button" id="togglePasswordBtn" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 0; display: flex; align-items: center; justify-content: center;" title="Toggle Password Visibility">
                            <i data-lucide="eye" id="togglePasswordIcon" style="width: 18px; height: 18px;"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-err"></span>
                </div>

                <div style="display:flex; align-items:center; gap:10px;">
                    <label class="dk-toggle">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span class="toggle-slider"></span>
                    </label>
                    <span style="font-size:0.85rem; color:var(--text-sub); cursor:pointer;">Remember me for 60 minutes</span>
                </div>

                <button type="submit" class="dk-btn dk-btn-primary"
                        style="width:100%; justify-content:center; padding:12px; font-size:0.9rem; border-radius:14px; margin-top:4px;">
                    Sign In →
                </button>

                <!-- OR Divider -->
                <div style="display:flex; align-items:center; gap:12px; margin:8px 0;">
                    <div style="flex:1; height:1px; background:var(--border);"></div>
                    <span style="font-size:0.75rem; color:var(--text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.05em;">OR</span>
                    <div style="flex:1; height:1px; background:var(--border);"></div>
                </div>

                <a asp-action="LoginWithGoogle" class="dk-btn dk-btn-outline" 
                   style="width:100%; justify-content:center; padding:11px; font-size:0.9rem; border-radius:14px; gap:10px; background:var(--card-bg); border-color:var(--border);">
                    <svg width="18" height="18" viewBox="0 0 18 18">
                        <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" fill="#4285F4"/>
                        <path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 009 18z" fill="#34A853"/>
                        <path d="M3.964 10.712c-.18-.54-.282-1.117-.282-1.712s.102-1.172.282-1.712V4.956H.957a8.996 8.996 0 000 8.088l3.007-2.332z" fill="#FBBC05"/>
                        <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 00.957 4.956l3.007 2.332C4.672 5.164 6.656 3.58 9 3.58z" fill="#EA4335"/>
                    </svg>
                    Continue with Google
                </a>

            </form>
        </div>

        <p style="text-align:center; margin-top:20px; font-size:0.85rem; color:var(--text-muted);">
            Don't have an account?
            <a asp-action="Register" style="color:var(--accent); font-weight:600; text-decoration:none;">Create one free</a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePasswordBtn').addEventListener('click', function () {
            const passwordInput = document.getElementById('Password');
            const toggleIcon = document.getElementById('togglePasswordIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.setAttribute('data-lucide', 'eye-off');
            } else {
                passwordInput.type = 'password';
                toggleIcon.setAttribute('data-lucide', 'eye');
            }
            
            lucide.createIcons();
        });
    </script>
}
