@{
    ViewData["Title"] = "Elite Tactical Operations Portal";
}

<div class="page-header">
    <div>
        <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 6px;">Tactical Command &bull; VIP Services</div>
        <h1 class="page-header-title">VIP Protection Console</h1>
        <p class="page-header-sub">Manage elite close-protection plans, view assigned tactical officers, and access priority secure services.</p>
    </div>
    <div>
        <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; background: rgba(180, 83, 9, 0.12); color: var(--accent); border: 1px solid rgba(180, 83, 9, 0.3); border-radius: 100px; font-size: 0.8rem; font-weight: 700; box-shadow: 0 4px 12px rgba(180, 83, 9, 0.1);">
            <i data-lucide="crown" style="width: 14px; height: 14px; color: var(--accent);"></i> Elite Tier Account
        </span>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    <!-- VIP Services & Protection Details -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- Active Guard Attachment -->
        <div class="dk-card dk-card-pad" style="background: linear-gradient(135deg, rgba(180, 83, 9, 0.05), rgba(255,255,255,0.4)); border-color: rgba(180, 83, 9, 0.25);">
            <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0 0 16px;">
                <i data-lucide="shield-check" style="width: 20px; height: 20px; color: var(--accent);"></i> Active Elite Protection Plan
            </h2>

            <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
                <div style="width: 60px; height: 60px; border-radius: 50%; border: 2px solid rgba(180, 83, 9, 0.3); display: flex; align-items: center; justify-content: center; font-size: 1.6rem; background: var(--surface);">👮‍♂️</div>
                <div>
                    <div style="font-size: 0.74rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted);">Primary Protection Commander</div>
                    <div style="font-size: 1.05rem; font-weight: 700; color: var(--text); margin-top: 2px;">Captain Marcus Vance</div>
                    <div style="font-size: 0.76rem; color: var(--text-sub); margin-top: 2px;">Vetted Armed Special Forces Vet &bull; Detachment 1</div>
                </div>
            </div>

            <div style="border-top: 1px solid var(--border); padding-top: 16px; margin-top: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <span style="font-size: 0.8rem; color: var(--text-sub);">Current Deployment Sector: <strong>Metropolitan Sector A</strong></span>
                <span style="font-size: 0.74rem; font-weight: 700; background: rgba(52, 211, 153, 0.1); color: var(--green); border: 1px solid rgba(52, 211, 153, 0.2); padding: 4px 10px; border-radius: 8px;">Active Surveillance On</span>
            </div>
        </div>

        <!-- Premium VIP Requests History -->
        <div class="dk-card dk-card-pad">
            <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text); margin: 0 0 16px; display: flex; align-items: center; gap: 6px;">
                <i data-lucide="folder-heart" style="width: 18px; height: 18px; color: var(--accent);"></i> Elite Service Logs
            </h3>
            
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="padding: 14px 20px; border-radius: 12px; border: 1px solid var(--border); background: rgba(255,255,255,0.25); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div>
                        <div style="font-weight: 700; color: var(--text); font-size: 0.88rem;">Close Protection Transit (Armed)</div>
                        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Airport Transfer to Summit Centre &bull; May 14, 2026</div>
                    </div>
                    <span style="font-size: 0.74rem; font-weight: 700; background: rgba(52, 211, 153, 0.1); color: var(--green); border: 1px solid rgba(52, 211, 153, 0.2); padding: 4px 10px; border-radius: 8px;">Completed</span>
                </div>
            </div>
        </div>

    </div>

    <!-- Right: Elite Support & Hotlines -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <div class="dk-card dk-card-pad" style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.05), rgba(255,255,255,0.3)); border-color: rgba(239, 68, 68, 0.25);">
            <h3 style="font-size: 0.95rem; font-weight: 800; color: var(--text); margin: 0 0 8px; display: flex; align-items: center; gap: 6px;">
                <i data-lucide="phone-forwarded" style="width: 16px; height: 16px; color: var(--red);"></i> Priority Tactical Support
            </h3>
            <p style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 16px;">
                Elite accounts receive guaranteed sub-15 minute tactical response dispatch. Use the priority hotline for immediate security concerns.
            </p>
            <div style="font-size: 0.88rem; font-weight: 800; color: var(--red); display: flex; align-items: center; gap: 6px;">
                <i data-lucide="phone-call" style="width: 14px; height: 14px;"></i> Elite Hotline: +1 (800) Vanguard-VIP
            </div>
        </div>

        <div class="dk-card dk-card-pad">
            <h3 style="font-size: 0.95rem; font-weight: 800; color: var(--text); margin: 0 0 12px; display: flex; align-items: center; gap: 6px;">
                <i data-lucide="shield" style="width: 16px; height: 16px; color: var(--accent);"></i> Tactical Guard Standard
            </h3>
            <p style="font-size: 0.78rem; color: var(--text-muted); line-height: 1.5; margin: 0;">
                All security officers assigned to elite details possess a minimum of 5 years tactical training, hold specialized close-protection licenses, and are subject to continuous psychological auditing.
            </p>
        </div>
    </div>
</div>
