@{
    ViewData["Title"] = "Security Services Console";
}

<div class="page-header">
    <div>
        <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 6px;">Client Service Portal</div>
        <h1 class="page-header-title">Security Services Dashboard</h1>
        <p class="page-header-sub">Request armed tactical guard detachments, monitor deploy status, and track assigned personnel.</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    <!-- Active Protection Services / Requests -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- Quick Request card -->
        <div class="dk-card dk-card-pad" style="background: linear-gradient(135deg, rgba(180, 83, 9, 0.04), rgba(255,255,255,0.45)); border-color: rgba(180, 83, 9, 0.25);">
            <div style="display: flex; gap: 20px; align-items: flex-start; flex-wrap: wrap;">
                <div style="width: 54px; height: 54px; border-radius: 16px; background: rgba(180, 83, 9, 0.1); color: var(--accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <i data-lucide="shield-plus" style="width: 24px; height: 24px;"></i>
                </div>
                <div style="flex: 1; min-width: 200px;">
                    <h2 style="font-size: 1.15rem; font-weight: 800; color: var(--text); margin: 0 0 6px;">Need Security Deployment?</h2>
                    <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin: 0 0 18px;">
                        Instantly submit deployment parameters including target patrol locations, required guard counts, shift durations, and tactical requirements.
                    </p>
                    <a asp-controller="ClientRequest" asp-action="Create" class="dk-btn dk-btn-primary">
                        <i data-lucide="plus-circle" style="width: 16px; height: 16px;"></i> Draft Security Request
                    </a>
                </div>
            </div>
        </div>

        <!-- VIP Application Banner -->
        <div class="dk-card dk-card-pad" style="background: linear-gradient(135deg, rgba(180, 83, 9, 0.05), rgba(215, 200, 180, 0.1)); border-color: rgba(180, 83, 9, 0.2); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;">
            <div>
                <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text); margin: 0 0 4px; display: flex; align-items: center; gap: 8px;">
                    <i data-lucide="crown" style="width: 18px; height: 18px; color: var(--accent);"></i> Unlock Elite Services
                </h3>
                <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0; max-width: 500px;">
                    Apply for VIP Client status to access exclusive protection details, armed escorts, and priority deployment.
                </p>
            </div>
            <a asp-controller="VipApplication" asp-action="Apply" class="dk-btn dk-btn-primary" style="background: var(--text); color: var(--surface);">
                Apply for VIP Status
            </a>
        </div>

        <!-- Guard Evaluation -->
        <div class="dk-card dk-card-pad" style="border-color: rgba(59, 130, 246, 0.25);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2 style="font-size: 1.05rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0 0 4px;">
                        <i data-lucide="star" style="width: 18px; height: 18px; color: #3b82f6;"></i> Evaluate Guard Service
                    </h2>
                    <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0;">Rate recent guard performance and leave comments.</p>
                </div>
                <a asp-controller="Rating" asp-action="RateGuard" class="dk-btn" style="padding: 8px 16px; font-size: 0.85rem; background: rgba(59, 130, 246, 0.1); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.2);">
                    Submit Rating
                </a>
            </div>
        </div>

        <!-- Live Request Summary -->
        <div class="dk-card dk-card-pad">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 6px; margin: 0;">
                    <i data-lucide="activity" style="width: 18px; height: 18px; color: var(--accent);"></i> My Active Deployments
                </h3>
                <a asp-controller="ClientRequest" asp-action="MyRequests" class="dk-btn dk-btn-ghost dk-btn-sm" style="font-size: 0.8rem;">
                    View All <i data-lucide="arrow-right" style="width: 13px; height: 13px; margin-left: 4px;"></i>
                </a>
            </div>

            @{
                var activeReqs = ViewBag.ActiveRequests as List<Vanguard_Engine.Entities.ClientRequest> ?? new List<Vanguard_Engine.Entities.ClientRequest>();
                var pendingReqs = ViewBag.PendingRequests as List<Vanguard_Engine.Entities.ClientRequest> ?? new List<Vanguard_Engine.Entities.ClientRequest>();
                var allVisible = activeReqs.Take(3).Concat(pendingReqs.Take(2)).ToList();
            }

            @if (!allVisible.Any())
            {
                <div style="text-align: center; padding: 32px 20px; border: 1px dashed var(--border); border-radius: 12px; background: rgba(255,255,255,0.05);">
                    <i data-lucide="clipboard-list" style="width: 32px; height: 32px; color: var(--text-muted); margin-bottom: 8px;"></i>
                    <div style="font-weight: 600; color: var(--text-muted); font-size: 0.88rem;">No active requests</div>
                    <div style="color: var(--text-muted); font-size: 0.78rem; margin-top: 4px;">Submit a request to start tracking deployments here.</div>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    @foreach (var req in allVisible)
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-radius: 10px; border: 1px solid @(req.Status == "Active" ? "rgba(239,68,68,0.2)" : req.Status == "Scheduled" ? "rgba(139,92,246,0.2)" : req.Status is "Assigned" or "Partially Assigned" ? "rgba(59,130,246,0.2)" : req.Status == "Approved" ? "rgba(52,211,153,0.2)" : "rgba(217,119,6,0.2)"); background: @(req.Status == "Active" ? "rgba(239,68,68,0.08)" : req.Status == "Scheduled" ? "rgba(139,92,246,0.08)" : req.Status is "Assigned" or "Partially Assigned" ? "rgba(59,130,246,0.06)" : req.Status == "Approved" ? "rgba(52,211,153,0.08)" : "rgba(217,119,6,0.08)"); flex-wrap: wrap; gap: 8px;">
                            <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                                <i data-lucide="map-pin" style="width: 15px; height: 15px; color: @(req.Status == "Active" ? "var(--red)" : req.Status == "Scheduled" ? "#8b5cf6" : req.Status is "Assigned" or "Partially Assigned" ? "#3b82f6" : req.Status == "Approved" ? "var(--green)" : "var(--yellow)"); flex-shrink: 0;"></i>
                                <div style="min-width: 0;">
                                    <div style="font-weight: 700; color: var(--text); font-size: 0.88rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px;">@req.Location</div>
                                    <div style="font-size: 0.73rem; color: var(--text-muted);">@req.NumberOfGuards guard(s) &bull; @req.Duration</div>
                                </div>
                            </div>
                            <span style="font-size: 0.73rem; font-weight: 700; padding: 4px 10px; border-radius: 100px; color: @(req.Status == "Active" ? "var(--red)" : req.Status == "Scheduled" ? "#8b5cf6" : req.Status is "Assigned" or "Partially Assigned" ? "#3b82f6" : req.Status == "Approved" ? "var(--green)" : "var(--yellow)"); border: 1px solid @(req.Status == "Active" ? "rgba(239,68,68,0.2)" : req.Status == "Scheduled" ? "rgba(139,92,246,0.2)" : req.Status is "Assigned" or "Partially Assigned" ? "rgba(59,130,246,0.2)" : req.Status == "Approved" ? "rgba(52,211,153,0.2)" : "rgba(217,119,6,0.2)"); white-space: nowrap;">
                                @(req.Status == "Active" ? "🔴 Active" : req.Status == "Partially Assigned" ? "Partial" : req.Status)
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Complaint Reporting Shortcut -->
        <div class="dk-card dk-card-pad" style="border-color: rgba(239, 68, 68, 0.25);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2 style="font-size: 1.05rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0 0 4px;">
                        <i data-lucide="alert-circle" style="width: 18px; height: 18px; color: var(--red);"></i> Service Complaints
                    </h2>
                    <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0;">Report issues with security services or personnel.</p>
                </div>
                <div style="display: flex; gap: 8px;">
                    <a asp-controller="Incident" asp-action="Submit" class="dk-btn dk-btn-danger" style="padding: 8px 16px; font-size: 0.85rem;">
                        Submit Complaint
                    </a>
                    <a asp-controller="Incident" asp-action="MyReports" class="dk-btn" style="padding: 8px 16px; font-size: 0.85rem; background: rgba(255,255,255,0.05);">
                        History
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- Right: Sidebar metrics & support -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <div class="dk-card dk-card-pad">
            <h3 style="font-size: 0.95rem; font-weight: 800; color: var(--text); margin: 0 0 16px; border-bottom: 1px solid var(--border); padding-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                <i data-lucide="info" style="width: 16px; height: 16px; color: var(--accent);"></i> Deployment Tiers
            </h3>
            
            <div style="display: flex; flex-direction: column; gap: 12px; font-size: 0.8rem; line-height: 1.4;">
                <div>
                    <strong style="color: var(--text);">Armed Static Patrol:</strong>
                    <div style="color: var(--text-muted);">Commercial/Residential perimeter patrol operations.</div>
                </div>
                <div style="border-top: 1px solid var(--border); padding-top: 8px;">
                    <strong style="color: var(--text);">Armed Escort Detachments:</strong>
                    <div style="color: var(--text-muted);">High-security transit escort and asset custody protection.</div>
                </div>
            </div>
        </div>

        <div class="dk-card dk-card-pad" style="background: rgba(255, 255, 255, 0.3);">
            <h3 style="font-size: 0.95rem; font-weight: 800; color: var(--text); margin: 0 0 12px; display: flex; align-items: center; gap: 6px;">
                <i data-lucide="help-circle" style="width: 16px; height: 16px; color: var(--accent);"></i> Operations Help Desk
            </h3>
            <p style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 16px;">
                Need help coordinating complex, multi-site deployments or VIP operations? Contact Vanguard dispatch directly.
            </p>
            <div style="font-size: 0.82rem; font-weight: 700; color: var(--accent); display: flex; align-items: center; gap: 6px;">
                <i data-lucide="phone-call" style="width: 14px; height: 14px;"></i> Dispatch: +1 (800) VANGUARD
            </div>
        </div>
    </div>
</div>
