@model List<Vanguard_Engine.Entities.GuardApplication>
@{
    ViewData["Title"] = "Security Operator Terminal";
    var latestApp = Model?.OrderByDescending(a => a.CreatedAt).FirstOrDefault();
    var isApproved = latestApp?.Status == "Approved";
}

<div class="page-header">
    <div>
        <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 6px;">Tactical Operator Console</div>
        <h1 class="page-header-title">Operator Terminal</h1>
        <p class="page-header-sub">View active duty assignments, manage attendance logs, and track deployment statuses.</p>
    </div>
</div>

@if (latestApp == null)
{
    <!-- Empty Application State -->
    <div class="dk-card dk-card-pad" style="text-align: center; padding: 48px; border-style: dashed; border-color: rgba(180, 83, 9, 0.4);">
        <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(180, 83, 9, 0.1); color: var(--accent); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
            <i data-lucide="shield" style="width: 28px; height: 28px;"></i>
        </div>
        <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text); margin: 0 0 10px;">Not Currently Enlisted</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem; max-width: 440px; margin: 0 auto 24px; line-height: 1.6;">
            You have not submitted a Security Guard deployment application. Submit an application to gain access to active tactical duties and shift assignments.
        </p>
        <a asp-controller="Guard" asp-action="Apply" class="dk-btn dk-btn-primary">
            <i data-lucide="file-signature" style="width: 16px; height: 16px;"></i> Fill Out Deployment Form
        </a>
    </div>
}
else
{
    <div style="display: grid; grid-template-columns: 3fr 2fr; gap: 24px;">
        <!-- Left: Active Duty & Attendance -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            
            @if (isApproved)
            {
                <!-- Interactive Duty Attendance Check-in Widget -->
                <div class="dk-card dk-card-pad" style="background: linear-gradient(135deg, rgba(180, 83, 9, 0.04), rgba(255,255,255,0.4)); border-color: rgba(180, 83, 9, 0.25);">
                    <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0 0 20px;">
                        <i data-lucide="clock" style="width: 20px; height: 20px; color: var(--accent);"></i> Live Shift Status & Check-In
                    </h2>

                    <div style="display: flex; align-items: center; justify-content: space-between; border: 1px solid var(--border); background: rgba(255,255,255,0.4); padding: 18px 24px; border-radius: 14px; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
                        <div>
                            <div style="font-size: 0.74rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted);">Current Assignment</div>
                            <div style="font-size: 1.05rem; font-weight: 700; color: var(--text); margin-top: 4px;">Metropolitan Bank H.Q. (Day Shift)</div>
                            <div style="font-size: 0.78rem; color: var(--text-sub); margin-top: 2px;"><i data-lucide="map-pin" style="width: 12px; height: 12px; display: inline-block; vertical-align: -2px; margin-right: 2px;"></i> Sector 4, Financial District</div>
                        </div>
                        <div>
                            <span id="shiftStatusTag" class="badge-pending" style="padding: 4px 12px; border-radius: 100px; font-size: 0.74rem; font-weight: 700; background: rgba(180, 83, 9, 0.1); color: var(--accent); border: 1px solid rgba(180, 83, 9, 0.2);">
                                Offline
                            </span>
                        </div>
                    </div>

                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        <button id="btnCheckIn" class="dk-btn dk-btn-primary" style="flex: 1; justify-content: center; min-height: 48px; border-radius: 14px; font-size: 0.92rem;" onclick="checkIn()">
                            <i data-lucide="log-in" style="width: 18px; height: 18px;"></i> Check In for Shift
                        </button>
                        <button id="btnCheckOut" class="dk-btn dk-btn-danger" style="flex: 1; justify-content: center; min-height: 48px; border-radius: 14px; font-size: 0.92rem; display: none;" onclick="checkOut()">
                            <i data-lucide="log-out" style="width: 18px; height: 18px;"></i> Check Out / End Duty
                        </button>
                    </div>
                </div>

                <!-- Assigned Duty Logs -->
                <div class="dk-card dk-card-pad">
                    <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0 0 16px;">
                        <i data-lucide="calendar-days" style="width: 20px; height: 20px; color: var(--accent);"></i> Duty Schedule (Week 2)
                    </h2>

                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <div style="padding: 16px; border-radius: 12px; border: 1px solid var(--border); background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
                            <div>
                                <div style="font-weight: 700; color: var(--text); font-size: 0.88rem;">Metro HQ - Static Patrol</div>
                                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Monday - Wednesday &bull; 08:00 AM - 17:00 PM</div>
                            </div>
                            <span style="font-size: 0.74rem; font-weight: 700; background: rgba(52, 211, 153, 0.1); color: var(--green); border: 1px solid rgba(52, 211, 153, 0.2); padding: 4px 10px; border-radius: 8px;">Active Contract</span>
                        </div>

                        <div style="padding: 16px; border-radius: 12px; border: 1px solid var(--border); background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
                            <div>
                                <div style="font-weight: 700; color: var(--text); font-size: 0.88rem;">City Mall V.I.P. Guard</div>
                                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Thursday &bull; 10:00 AM - 20:00 PM</div>
                            </div>
                            <span style="font-size: 0.74rem; font-weight: 700; background: rgba(217, 119, 6, 0.1); color: var(--yellow); border: 1px solid rgba(217, 119, 6, 0.2); padding: 4px 10px; border-radius: 8px;">Pending Briefing</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Vetting State Card -->
                <div class="dk-card dk-card-pad" style="background: linear-gradient(135deg, rgba(217,119,6,0.03), rgba(255,255,255,0.4)); border-color: rgba(217, 119, 6, 0.2);">
                    <div style="display: flex; gap: 16px; align-items: flex-start;">
                        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(217,119,6,0.1); color: var(--yellow); display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><i data-lucide="clock"></i></div>
                        <div>
                            <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text); margin: 0 0 6px;">Application Under Review</h2>
                            <p style="color: var(--text-muted); font-size: 0.86rem; line-height: 1.5; margin: 0 0 16px;">
                                Your tactical deployment profile is being audited by our recruitment directors. We will verify your background check and armed guard licenses.
                            </p>
                            <div style="font-size: 0.78rem; color: var(--text-sub);">
                                Submitted: <strong>@latestApp.CreatedAt.ToString("MMMM dd, yyyy")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- Right: Status and details -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            <div class="dk-card dk-card-pad">
                <h3 style="font-size: 1rem; font-weight: 800; color: var(--text); margin: 0 0 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                    <i data-lucide="user-check" style="width: 18px; height: 18px; color: var(--accent);"></i> Operator Profile
                </h3>

                <div style="display: flex; flex-direction: column; gap: 14px; font-size: 0.82rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Enlisted Name:</span>
                        <strong style="color: var(--text);">@latestApp.FullName</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Station Preference:</span>
                        <strong style="color: var(--text);">@latestApp.PreferredLocation</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Armed License:</span>
                        <span style="font-weight: 700; color: @(latestApp.ArmedLicense ? "var(--green)" : "var(--red)")">@(latestApp.ArmedLicense ? "Active State Guard" : "Unlicensed")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Experience Level:</span>
                        <strong style="color: var(--text);">@latestApp.YearsOfExperience Years</strong>
                    </div>
                </div>
            </div>
            
            <div class="dk-card dk-card-pad" style="background: rgba(255,255,255,0.15);">
                <h3 style="font-size: 1rem; font-weight: 800; color: var(--text); margin: 0 0 12px; display: flex; align-items: center; gap: 6px;">
                    <i data-lucide="info" style="width: 18px; height: 18px; color: var(--accent);"></i> Operational Checklist
                </h3>
                <ul style="padding: 0; margin: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.8rem; color: var(--text-sub);">
                    <li style="display: flex; gap: 8px;"><i data-lucide="check" style="width: 14px; height: 14px; color: var(--green); flex-shrink: 0; margin-top: 2px;"></i> Always check in via operator console when reporting for duty.</li>
                    <li style="display: flex; gap: 8px;"><i data-lucide="check" style="width: 14px; height: 14px; color: var(--green); flex-shrink: 0; margin-top: 2px;"></i> Wear full regulation uniform at static contract posts.</li>
                    <li style="display: flex; gap: 8px;"><i data-lucide="check" style="width: 14px; height: 14px; color: var(--green); flex-shrink: 0; margin-top: 2px;"></i> Report and log incident tickets instantly through tactical communications.</li>
                </ul>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function checkIn() {
                var btnIn = document.getElementById("btnCheckIn");
                var btnOut = document.getElementById("btnCheckOut");
                var tag = document.getElementById("shiftStatusTag");

                // Micro-animations and State Changes
                btnIn.style.transform = "scale(0.96)";
                setTimeout(() => {
                    btnIn.style.display = "none";
                    btnOut.style.display = "flex";
                    btnOut.style.transform = "none";
                    
                    tag.innerHTML = "On Duty / Active";
                    tag.style.background = "rgba(52, 211, 153, 0.1)";
                    tag.style.color = "var(--green)";
                    tag.style.borderColor = "rgba(52, 211, 153, 0.25)";
                    
                    // Create floating success check
                    const banner = document.createElement("div");
                    banner.innerHTML = "🎯 Check-In logged successfully. Operator is Active.";
                    banner.style.position = "fixed";
                    banner.style.bottom = "24px";
                    banner.style.right = "24px";
                    banner.style.background = "var(--surface)";
                    banner.style.border = "1px solid var(--green)";
                    banner.style.padding = "12px 20px";
                    banner.style.borderRadius = "12px";
                    banner.style.color = "var(--green)";
                    banner.style.fontWeight = "700";
                    banner.style.boxShadow = "var(--shadow)";
                    banner.style.zIndex = "9999";
                    banner.style.transition = "opacity 0.5s";
                    document.body.appendChild(banner);
                    setTimeout(() => { banner.style.opacity = "0"; setTimeout(() => banner.remove(), 500); }, 3000);
                }, 200);
            }

            function checkOut() {
                var btnIn = document.getElementById("btnCheckIn");
                var btnOut = document.getElementById("btnCheckOut");
                var tag = document.getElementById("shiftStatusTag");

                btnOut.style.transform = "scale(0.96)";
                setTimeout(() => {
                    btnOut.style.display = "none";
                    btnIn.style.display = "flex";
                    btnIn.style.transform = "none";
                    
                    tag.innerHTML = "Offline";
                    tag.style.background = "rgba(180, 83, 9, 0.1)";
                    tag.style.color = "var(--accent)";
                    tag.style.borderColor = "rgba(180, 83, 9, 0.25)";
                }, 200);
            }
        </script>
    }
}
