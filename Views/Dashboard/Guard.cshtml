@model List<Vanguard_Engine.Entities.GuardApplication>
@{
    ViewData["Title"] = "Security Operator Terminal";
    var latestApp = Model?.OrderByDescending(a => a.CreatedAt).FirstOrDefault();
    var isApproved = latestApp?.Status == "Approved";
}

<div class="page-header">
    <div>
        <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 6px;">Tactical Operator Console</div>
        <h1 class="page-header-title">Operator Terminal</h1>
        <p class="page-header-sub">View active duty assignments, manage attendance logs, and track deployment statuses.</p>
    </div>
</div>

@if (latestApp == null)
{
    <!-- Empty Application State -->
    <div class="dk-card dk-card-pad" style="text-align: center; padding: 48px; border-style: dashed; border-color: rgba(180, 83, 9, 0.4);">
        <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(180, 83, 9, 0.1); color: var(--accent); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
            <i data-lucide="shield" style="width: 28px; height: 28px;"></i>
        </div>
        <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text); margin: 0 0 10px;">Not Currently Enlisted</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem; max-width: 440px; margin: 0 auto 24px; line-height: 1.6;">
            You have not submitted a Security Guard deployment application. Submit an application to gain access to active tactical duties and shift assignments.
        </p>
        <a asp-controller="Guard" asp-action="Apply" class="dk-btn dk-btn-primary">
            <i data-lucide="file-signature" style="width: 16px; height: 16px;"></i> Fill Out Deployment Form
        </a>
    </div>
}
else
{
    <div style="display: grid; grid-template-columns: 3fr 2fr; gap: 24px;">
        <!-- Left: Active Duty & Attendance -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            
            @if (isApproved)
            {
                <!-- Live Shift Status & Check-In Widget -->
                <div class="dk-card dk-card-pad" style="background: linear-gradient(135deg, rgba(180, 83, 9, 0.04), rgba(255,255,255,0.4)); border-color: rgba(180, 83, 9, 0.25);">
                    <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0 0 20px;">
                        <i data-lucide="clock" style="width: 20px; height: 20px; color: var(--accent);"></i> Live Shift Status &amp; Check-In
                    </h2>

                    @if (TempData["Success"] != null)
                    {
                        <div class="dk-alert dk-alert-success" style="margin-bottom: 16px;">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="dk-alert dk-alert-error" style="margin-bottom: 16px;">@TempData["Error"]</div>
                    }

                    @{
                        var activeShift = ViewBag.ActiveShift as Vanguard_Engine.Entities.GuardShift;
                    }
                    @if (activeShift != null)
                    {
                        <!-- Checked In State -->
                        <div style="display: flex; align-items: center; justify-content: space-between; border: 1px solid rgba(52,211,153,0.25); background: rgba(52,211,153,0.05); padding: 18px 24px; border-radius: 14px; margin-bottom: 20px; flex-wrap: wrap; gap: 16px;">
                            <div>
                                <div style="font-size: 0.74rem; font-weight: 600; text-transform: uppercase; color: var(--green);">Shift Active</div>
                                <div style="font-size: 1.05rem; font-weight: 700; color: var(--text); margin-top: 4px;">
                                    Checked in at <strong>@activeShift.CheckInDateTime.ToLocalTime().ToString("HH:mm")</strong>
                                </div>
                                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                                    Elapsed: <strong id="elapsedTimer">calculating...</strong>
                                </div>
                            </div>
                            <span style="padding: 4px 12px; border-radius: 100px; font-size: 0.74rem; font-weight: 700; background: rgba(52,211,153,0.1); color: var(--green); border: 1px solid rgba(52,211,153,0.25);">
                                On Duty / Active
                            </span>
                        </div>
                        <form asp-controller="GuardShift" asp-action="CheckOut" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="shiftId" value="@activeShift.Id" />
                            <button type="submit" class="dk-btn dk-btn-danger" style="width: 100%; justify-content: center; min-height: 48px; border-radius: 14px; font-size: 0.92rem;"
                                    onclick="return confirm('End your shift and save duration to history?')">
                                <i data-lucide="log-out" style="width: 18px; height: 18px;"></i> Check Out / End Duty
                            </button>
                        </form>
                    }
                    else
                    {
                        <!-- Not Checked In State -->
                        <div style="text-align: center; padding: 20px 0 24px;">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(180, 83, 9, 0.08); color: var(--accent); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                                <i data-lucide="shield-alert" style="width: 22px; height: 22px;"></i>
                            </div>
                            <div style="font-weight: 700; color: var(--text); font-size: 0.94rem;">Not Currently On Shift</div>
                            <p style="color: var(--text-muted); font-size: 0.82rem; margin: 6px auto 20px; max-width: 320px;">
                                Start your shift to log attendance and track working hours.
                            </p>
                        </div>
                        <form asp-controller="GuardShift" asp-action="CheckIn" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dk-btn dk-btn-primary" style="width: 100%; justify-content: center; min-height: 48px; border-radius: 14px; font-size: 0.92rem;">
                                <i data-lucide="log-in" style="width: 18px; height: 18px;"></i> Check In for Shift
                            </button>
                        </form>
                    }
                </div>

                <!-- Current VIP Mission -->
                <div class="dk-card dk-card-pad" style="background: linear-gradient(135deg, rgba(180,83,9,0.04), rgba(255,255,255,0.4)); border-color: rgba(180,83,9,0.2);">
                    <h2 style="font-size: 1.05rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0 0 16px;">
                        <i data-lucide="crown" style="width: 18px; height: 18px; color: var(--accent);"></i> Current VIP Mission
                    </h2>

                    @{
                        var vipMission = ViewBag.VipMission as Vanguard_Engine.Entities.VIPRequest;
                    }
                    @if (vipMission != null)
                    {
                        var (mBg, mFg) = vipMission.Status == "Active"
                            ? ("rgba(52,211,153,0.1)", "var(--green)")
                            : ("rgba(180,83,9,0.1)", "var(--accent)");
                        <div style="border: 1px solid rgba(180,83,9,0.2); border-radius: 14px; padding: 18px 20px; background: rgba(255,255,255,0.4);">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 14px;">
                                <div>
                                    <div style="font-weight: 800; font-size: 1rem; color: var(--text); display: flex; align-items: center; gap: 6px;">
                                        <i data-lucide="crown" style="width:14px; height:14px; color: var(--accent);"></i>
                                        @vipMission.ProtectionType
                                    </div>
                                    <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 3px;">
                                        @vipMission.NumberOfGuards-officer elite detail &bull; @vipMission.Duration
                                    </div>
                                </div>
                                <span style="display: inline-flex; align-items: center; gap: 4px; padding: 5px 12px; border-radius: 100px; font-size: 0.75rem; font-weight: 700; background: @mBg; color: @mFg; border: 1px solid @mBg;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: @mFg; display: inline-block;"></span>
                                    @vipMission.Status
                                </span>
                            </div>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                @if (vipMission.ArmedRequired)
                                {
                                    <span style="padding: 4px 10px; border-radius: 8px; font-size: 0.74rem; font-weight: 700; background: rgba(239,68,68,0.08); color: var(--red); border: 1px solid rgba(239,68,68,0.15); display: inline-flex; align-items: center; gap: 4px;">
                                        <i data-lucide="shield-alert" style="width:11px; height:11px;"></i> Armed Detail
                                    </span>
                                }
                                else
                                {
                                    <span style="padding: 4px 10px; border-radius: 8px; font-size: 0.74rem; font-weight: 700; background: rgba(52,211,153,0.08); color: var(--green); border: 1px solid rgba(52,211,153,0.15); display: inline-flex; align-items: center; gap: 4px;">
                                        <i data-lucide="shield" style="width:11px; height:11px;"></i> Unarmed Detail
                                    </span>
                                }
                                <span style="padding: 4px 10px; border-radius: 8px; font-size: 0.74rem; font-weight: 700; background: rgba(180,83,9,0.06); color: var(--accent); border: 1px solid rgba(180,83,9,0.12);">
                                    Team: @vipMission.AssignedGuardIds?.Count officer(s)
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 24px 0; border: 1px dashed rgba(180,83,9,0.2); border-radius: 12px;">
                            <i data-lucide="crown" style="width: 28px; height: 28px; color: var(--text-muted); margin-bottom: 8px;"></i>
                            <div style="font-size: 0.86rem; font-weight: 600; color: var(--text-muted);">No active VIP deployment.</div>
                        </div>
                    }
                </div>

                <!-- Scheduled Shifts Shortcut -->
                <div class="dk-card dk-card-pad" style="border-color: rgba(52, 211, 153, 0.25);">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <h2 style="font-size: 1.05rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0 0 4px;">
                                <i data-lucide="calendar" style="width: 18px; height: 18px; color: var(--green);"></i> Assigned Shifts
                            </h2>
                            <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0;">View your scheduled dates and deployment times.</p>
                        </div>
                        <a asp-controller="AssignedShift" asp-action="GuardSchedule" class="dk-btn dk-btn-primary" style="padding: 8px 16px; font-size: 0.85rem;">
                            View Schedule <i data-lucide="arrow-right" style="width: 14px; height: 14px; margin-left: 6px;"></i>
                        </a>
                    </div>
                </div>

                <!-- Active Duty Logs -->
                <div class="dk-card dk-card-pad">
                    <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0 0 16px;">
                        <i data-lucide="calendar-days" style="width: 20px; height: 20px; color: var(--accent);"></i> Deployment Applications History
                    </h2>

                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        @{
                            var jobApps = Model?.Where(a => !string.IsNullOrEmpty(a.JobId)).OrderByDescending(a => a.CreatedAt).ToList() ?? new();
                        }
                        @if (!jobApps.Any())
                        {
                            <div style="font-size: 0.82rem; color: var(--text-muted); font-style: italic; text-align: center; padding: 12px 0;">
                                No recruitment application history.
                            </div>
                        }
                        else
                        {
                            @foreach (var app in jobApps)
                            {
                                <div style="padding: 16px; border-radius: 12px; border: 1px solid var(--border); background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
                                    <div>
                                        <div style="font-weight: 700; color: var(--text); font-size: 0.88rem;">Deployment Target ID: @app.JobId</div>
                                        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Applied: @app.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </div>
                                    @if (app.Status == "Accepted")
                                    {
                                        <span style="font-size: 0.74rem; font-weight: 700; background: rgba(52, 211, 153, 0.1); color: var(--green); border: 1px solid rgba(52, 211, 153, 0.2); padding: 4px 10px; border-radius: 8px;">Accepted</span>
                                    }
                                    else if (app.Status == "Rejected")
                                    {
                                        <span style="font-size: 0.74rem; font-weight: 700; background: rgba(239, 68, 68, 0.1); color: var(--red); border: 1px solid rgba(239, 68, 68, 0.2); padding: 4px 10px; border-radius: 8px;">Declined</span>
                                    }
                                    else
                                    {
                                        <span style="font-size: 0.74rem; font-weight: 700; background: rgba(217, 119, 6, 0.1); color: var(--yellow); border: 1px solid rgba(217, 119, 6, 0.2); padding: 4px 10px; border-radius: 8px;">Pending Review</span>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Vetting State Card -->
                <div class="dk-card dk-card-pad" style="background: linear-gradient(135deg, rgba(217,119,6,0.03), rgba(255,255,255,0.4)); border-color: rgba(217, 119, 6, 0.2);">
                    <div style="display: flex; gap: 16px; align-items: flex-start;">
                        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(217,119,6,0.1); color: var(--yellow); display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><i data-lucide="clock"></i></div>
                        <div>
                            <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text); margin: 0 0 6px;">Application Under Review</h2>
                            <p style="color: var(--text-muted); font-size: 0.86rem; line-height: 1.5; margin: 0 0 16px;">
                                Your tactical deployment profile is being audited by our recruitment directors. We will verify your background check and armed guard licenses.
                            </p>
                            <div style="font-size: 0.78rem; color: var(--text-sub);">
                                Submitted: <strong>@latestApp.CreatedAt.ToString("MMMM dd, yyyy")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- Right: Status and details -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            <div class="dk-card dk-card-pad">
                <h3 style="font-size: 1rem; font-weight: 800; color: var(--text); margin: 0 0 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                    <i data-lucide="user-check" style="width: 18px; height: 18px; color: var(--accent);"></i> Operator Profile
                </h3>

                <div style="display: flex; flex-direction: column; gap: 14px; font-size: 0.82rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Enlisted Name:</span>
                        <strong style="color: var(--text);">@latestApp.FullName</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Station Preference:</span>
                        <strong style="color: var(--text);">@latestApp.PreferredLocation</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Armed License:</span>
                        <span style="font-weight: 700; color: @(latestApp.ArmedLicense ? "var(--green)" : "var(--red)")">@(latestApp.ArmedLicense ? "Active State Guard" : "Unlicensed")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">Experience Level:</span>
                        <strong style="color: var(--text);">@latestApp.YearsOfExperience Years</strong>
                    </div>
                </div>
            </div>
            
            <div class="dk-card dk-card-pad" style="background: rgba(255,255,255,0.15);">
                <h3 style="font-size: 1rem; font-weight: 800; color: var(--text); margin: 0 0 12px; display: flex; align-items: center; gap: 6px;">
                    <i data-lucide="info" style="width: 18px; height: 18px; color: var(--accent);"></i> Operational Checklist
                </h3>
                <ul style="padding: 0; margin: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.8rem; color: var(--text-sub);">
                    <li style="display: flex; gap: 8px;"><i data-lucide="check" style="width: 14px; height: 14px; color: var(--green); flex-shrink: 0; margin-top: 2px;"></i> Always check in via operator console when reporting for duty.</li>
                    <li style="display: flex; gap: 8px;"><i data-lucide="check" style="width: 14px; height: 14px; color: var(--green); flex-shrink: 0; margin-top: 2px;"></i> Wear full regulation uniform at static contract posts.</li>
                    <li style="display: flex; gap: 8px;"><i data-lucide="check" style="width: 14px; height: 14px; color: var(--green); flex-shrink: 0; margin-top: 2px;"></i> Report and log incident tickets instantly through tactical communications.</li>
                </ul>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            // Live elapsed timer — counts up from server-side check-in time
            (function () {
                var el = document.getElementById('elapsedTimer');
                if (!el) return;
                @if (ViewBag.ActiveShift != null)
                {
                    var shift = ViewBag.ActiveShift as Vanguard_Engine.Entities.GuardShift;
                    <text>
                    var checkInMs = new Date('@shift!.CheckInDateTime.ToString("o")').getTime();
                    </text>
                }
                else
                {
                    <text>var checkInMs = Date.now();</text>
                }
                function tick() {
                    var elapsed = Math.floor((Date.now() - checkInMs) / 1000);
                    var h = Math.floor(elapsed / 3600);
                    var m = Math.floor((elapsed % 3600) / 60);
                    var s = elapsed % 60;
                    el.textContent = (h > 0 ? h + 'h ' : '') + m + 'm ' + s + 's';
                }
                tick();
                setInterval(tick, 1000);
            })();
        </script>
    }
}
