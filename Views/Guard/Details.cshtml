@model Vanguard_Engine.Entities.GuardApplication
@{
    ViewData["Title"] = "Application Details";
    var statusColor = Model.Status switch {
        "Approved" => "var(--green)",
        "Rejected" => "var(--red)",
        _ => "var(--yellow)"
    };
    var statusBg = Model.Status switch {
        "Approved" => "rgba(52,211,153,0.1)",
        "Rejected" => "rgba(248,113,113,0.1)",
        _ => "rgba(251,191,36,0.1)"
    };
    var statusBorder = Model.Status switch {
        "Approved" => "rgba(52,211,153,0.3)",
        "Rejected" => "rgba(248,113,113,0.3)",
        _ => "rgba(251,191,36,0.3)"
    };
    var statusIcon = Model.Status switch {
        "Approved" => "✅",
        "Rejected" => "❌",
        _ => "⏳"
    };
}

<!-- Back nav -->
<div style="margin-bottom:24px;">
    <a asp-action="MyApplications" style="display:inline-flex; align-items:center; gap:6px; color:var(--text-muted); text-decoration:none; font-size:0.85rem; font-weight:500; transition:color 0.15s;"
       onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-muted)'">
        ← Back to My Applications
    </a>
</div>

<!-- Hero header -->
<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-bottom:28px;">
    <div style="display:flex; align-items:center; gap:16px;">
        <div style="width:60px; height:60px; border-radius:20px; background:linear-gradient(135deg,#6366f1,#8b5cf6); display:flex; align-items:center; justify-content:center; font-size:1.8rem; box-shadow:0 8px 24px rgba(99,102,241,0.3); flex-shrink:0;">
            🛡️
        </div>
        <div>
            <h1 style="font-size:1.5rem; font-weight:900; color:var(--text); margin:0 0 4px; letter-spacing:-0.3px;">@Model.FullName</h1>
            <div style="font-size:0.8rem; color:var(--text-muted);">Application · Submitted @Model.CreatedAt.ToString("dddd, dd MMMM yyyy")</div>
        </div>
    </div>
    <span style="display:inline-flex; align-items:center; gap:8px; padding:10px 20px; border-radius:14px; font-size:0.9rem; font-weight:700; background:@statusBg; color:@statusColor; border:1px solid @statusBorder;">
        @statusIcon @Model.Status
    </span>
</div>

<!-- Status banner -->
@if (Model.Status == "Pending")
{
    <div style="background:rgba(251,191,36,0.06); border:1px solid rgba(251,191,36,0.18); border-radius:16px; padding:16px 20px; margin-bottom:24px; display:flex; gap:12px; align-items:flex-start;">
        <span style="font-size:1.4rem; flex-shrink:0;">⏳</span>
        <div>
            <div style="font-weight:700; color:#d97706; margin-bottom:4px;">Under Review</div>
            <div style="font-size:0.85rem; color:var(--text-muted); line-height:1.6;">
                Our recruitment team is reviewing your application. This usually takes 2–5 business days. You'll be notified once a decision is made.
            </div>
        </div>
    </div>
}
else if (Model.Status == "Approved")
{
    <div style="background:rgba(52,211,153,0.06); border:1px solid rgba(52,211,153,0.18); border-radius:16px; padding:16px 20px; margin-bottom:24px; display:flex; gap:12px; align-items:flex-start;">
        <span style="font-size:1.4rem; flex-shrink:0;">🎉</span>
        <div>
            <div style="font-weight:700; color:var(--green); margin-bottom:4px;">Application Approved</div>
            <div style="font-size:0.85rem; color:var(--text-muted); line-height:1.6;">
                Congratulations! Your guard application has been approved. Our team will contact you shortly with onboarding instructions.
            </div>
        </div>
    </div>
}
else
{
    <div style="background:rgba(248,113,113,0.06); border:1px solid rgba(248,113,113,0.18); border-radius:16px; padding:16px 20px; margin-bottom:24px; display:flex; gap:12px; align-items:flex-start;">
        <span style="font-size:1.4rem; flex-shrink:0;">📋</span>
        <div>
            <div style="font-weight:700; color:var(--red); margin-bottom:4px;">Not Selected This Time</div>
            <div style="font-size:0.85rem; color:var(--text-muted); line-height:1.6;">
                Your application was reviewed but not selected. You are welcome to submit a new application after updating your experience and skills.
            </div>
        </div>
    </div>
}

<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">

    <!-- LEFT: Personal Info -->
    <div style="display:flex; flex-direction:column; gap:20px;">

        <div class="det-card">
            <div class="det-card-title">👤 Personal Information</div>
            <div class="det-grid">
                <div class="det-item">
                    <span class="det-label">Full Legal Name</span>
                    <span class="det-value">@Model.FullName</span>
                </div>
                <div class="det-item">
                    <span class="det-label">Phone Number</span>
                    <span class="det-value">@Model.Phone</span>
                </div>
                <div class="det-item">
                    <span class="det-label">National ID (NID)</span>
                    <span class="det-value mono">@Model.NationalId</span>
                </div>
                <div class="det-item" style="grid-column:1/-1;">
                    <span class="det-label">Current Address</span>
                    <span class="det-value">@Model.Address</span>
                </div>
            </div>
        </div>

        <div class="det-card">
            <div class="det-card-title">⚡ Qualifications</div>
            <div class="det-grid">
                <div class="det-item">
                    <span class="det-label">Years of Experience</span>
                    <span class="det-value" style="font-size:1.5rem; font-weight:900; color:var(--accent);">
                        @Model.YearsOfExperience
                        <span style="font-size:0.8rem; color:var(--text-muted); font-weight:500;"> years</span>
                    </span>
                </div>
                <div class="det-item">
                    <span class="det-label">Armed Guard License</span>
                    @if (Model.ArmedLicense)
                    {
                        <span class="det-value" style="color:var(--green); display:flex; align-items:center; gap:6px;">
                            <span style="width:8px; height:8px; border-radius:50%; background:var(--green); display:inline-block;"></span>
                            Licensed
                        </span>
                    }
                    else
                    {
                        <span class="det-value" style="color:var(--text-muted);">Not Licensed</span>
                    }
                </div>
                <div class="det-item" style="grid-column:1/-1;">
                    <span class="det-label">Preferred Deployment Location</span>
                    <span class="det-value">📍 @Model.PreferredLocation</span>
                </div>
            </div>
        </div>

    </div>

    <!-- RIGHT: Professional Details -->
    <div style="display:flex; flex-direction:column; gap:20px;">

        <div class="det-card" style="flex:1;">
            <div class="det-card-title">💼 Work Experience</div>
            <p style="font-size:0.875rem; color:var(--text-sub); line-height:1.75; margin:0; white-space:pre-wrap;">@Model.Experience</p>
        </div>

        <div class="det-card" style="flex:1;">
            <div class="det-card-title">🎯 Skills & Certifications</div>
            <p style="font-size:0.875rem; color:var(--text-sub); line-height:1.75; margin:0; white-space:pre-wrap;">@Model.Skills</p>
        </div>

    </div>

</div>

<!-- Bottom actions -->
<div style="display:flex; gap:12px; margin-top:24px; padding-top:20px; border-top:1px solid var(--border);">
    <a asp-action="MyApplications" class="dk-btn dk-btn-ghost">← Back</a>
    @if (Model.Status == "Pending")
    {
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Withdraw this application? This cannot be undone.');">
            <button type="submit" class="dk-btn dk-btn-danger">✕ Withdraw Application</button>
        </form>
    }
    else if (Model.Status == "Rejected")
    {
        <a asp-action="Apply" class="dk-btn dk-btn-primary">🛡️ Submit New Application</a>
    }
</div>

<style>
    .det-card {
        background: var(--glass);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 22px;
        backdrop-filter: blur(20px);
    }
    .det-card-title {
        font-size: 0.82rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 18px;
    }
    .det-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .det-item { display: flex; flex-direction: column; gap: 5px; }
    .det-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
    .det-value { font-size: 0.9rem; font-weight: 600; color: var(--text); }

    @@media (max-width: 700px) {
        div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
        .det-grid { grid-template-columns: 1fr !important; }
    }
</style>
