@model IEnumerable<Vanguard_Engine.Entities.GuardApplication>
@{
    ViewData["Title"] = "Guard Applications Panel";
    Layout = "~/Views/Shared/_DarkLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Guard Applications Panel</h1>
        <p class="page-header-sub">Review, approve, or reject submitted guard applications</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="dk-alert dk-alert-success">✅ @TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="dk-alert dk-alert-error">❌ @TempData["ErrorMessage"]</div>
}

<div class="stat-grid">
    <div class="stat-card stat-total">
        <span class="stat-label">Total Applications</span>
        <span class="stat-value">@Model.Count()</span>
    </div>
    <div class="stat-card stat-pending">
        <span class="stat-label">Pending Review</span>
        <span class="stat-value">@Model.Count(a => a.Status == "Pending")</span>
    </div>
    <div class="stat-card stat-approved">
        <span class="stat-label">Approved</span>
        <span class="stat-value">@Model.Count(a => a.Status == "Approved")</span>
    </div>
    <div class="stat-card stat-rejected">
        <span class="stat-label">Rejected</span>
        <span class="stat-value">@Model.Count(a => a.Status == "Rejected")</span>
    </div>
</div>

<div class="dk-card">
    @if (Model.Any())
    {
        <table class="dk-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Applicant</th>
                    <th>NID</th>
                    <th>Location</th>
                    <th>Yrs</th>
                    <th>Armed</th>
                    <th>Applied</th>
                    <th>Status</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="mono">@i</span></td>
                        <td>
                            <div style="font-weight:600; color:var(--text);">@item.FullName</div>
                            <div class="mono" style="margin-top:2px;">@item.Phone</div>
                        </td>
                        <td><span class="mono">@item.NationalId</span></td>
                        <td style="color:var(--text-sub); font-size:0.83rem;">@item.PreferredLocation</td>
                        <td>
                            <span style="font-weight:600; color:var(--text);">@item.YearsOfExperience</span>
                            <span style="color:var(--text-muted); font-size:0.75rem;">yr</span>
                        </td>
                        <td>
                            @if (item.ArmedLicense)
                            {
                                <span class="badge badge-approved">✓ Yes</span>
                            }
                            else
                            {
                                <span style="color:var(--text-muted); font-size:0.8rem;">No</span>
                            }
                        </td>
                        <td style="color:var(--text-muted); font-size:0.8rem; white-space:nowrap;">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="badge badge-pending">⏳ Pending</span>
                            }
                            else if (item.Status == "Approved")
                            {
                                <span class="badge badge-approved">✅ Approved</span>
                            }
                            else
                            {
                                <span class="badge badge-rejected">❌ Rejected</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            @if (item.Status == "Pending")
                            {
                                <div style="display:flex; gap:8px; justify-content:center;">
                                    <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        <button type="submit" class="dk-btn dk-btn-success dk-btn-sm">✓ Approve</button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        <button type="submit" class="dk-btn dk-btn-danger dk-btn-sm">✗ Reject</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span style="color:var(--text-muted); font-size:0.78rem;">Processed</span>
                            }
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🔍</div>
            <div class="empty-title">No applications found</div>
            <div class="empty-sub">Guard applications will appear here once submitted.</div>
        </div>
    }
</div>
