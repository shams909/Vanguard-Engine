@model IEnumerable<Vanguard_Engine.Entities.GuardApplication>
@{
    ViewData["Title"] = "Applications Panel";
    var list = Model.ToList();
    var pending = list.Count(a => a.Status == "Pending");
    var approved = list.Count(a => a.Status == "Approved");
    var rejected = list.Count(a => a.Status == "Rejected");
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Guard Applications Panel</h1>
        <p class="page-header-sub">
            @pending application@(pending == 1 ? "" : "s") awaiting review ·
            @list.Count total submitted
        </p>
    </div>
    @if (pending > 0)
    {
        <div style="display:flex; align-items:center; gap:8px; background:rgba(217,119,6,0.1); border:1px solid rgba(217,119,6,0.25); border-radius:12px; padding:8px 16px;">
            <span style="width:8px; height:8px; border-radius:50%; background:var(--yellow); display:inline-block; animation:pulse 2s infinite;"></span>
            <span style="font-size:0.8rem; font-weight:600; color:#d97706;">@pending Pending</span>
        </div>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="dk-alert dk-alert-success"><i data-lucide="check-circle-2" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> @TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="dk-alert dk-alert-error"><i data-lucide="x-circle" style="width:16px; height:16px; display:inline-block; vertical-align:-3px; margin-right:4px;"></i> @TempData["ErrorMessage"]</div>
}

<!-- Stats -->
<div class="stat-grid" style="grid-template-columns:repeat(4,1fr); margin-bottom:28px;">
    <div class="stat-card stat-total">
        <span class="stat-label">Total Received</span>
        <span class="stat-value">@list.Count</span>
    </div>
    <div class="stat-card stat-pending">
        <span class="stat-label">Awaiting Review</span>
        <span class="stat-value">@pending</span>
    </div>
    <div class="stat-card stat-approved">
        <span class="stat-label">Approved</span>
        <span class="stat-value">@approved</span>
    </div>
    <div class="stat-card stat-rejected">
        <span class="stat-label">Rejected</span>
        <span class="stat-value">@rejected</span>
    </div>
</div>

@if (!list.Any())
{
    <div class="dk-card" style="padding:72px 24px; text-align:center;">
        <div style="font-size:3.5rem; margin-bottom:14px;"><i data-lucide="search" style="width:56px; height:56px; display:inline-block;"></i></div>
        <div style="font-size:1rem; font-weight:600; color:var(--text); margin-bottom:8px;">No applications yet</div>
        <div style="font-size:0.85rem; color:var(--text-muted);">Guard applications will appear here once candidates submit them.</div>
    </div>
}
else
{
    <!-- Pending section first -->
    @if (list.Any(a => a.Status == "Pending"))
    {
        <div style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--yellow); margin-bottom:12px; display:flex; align-items:center; gap:8px;">
            <span style="width:6px; height:6px; border-radius:50%; background:var(--yellow); display:inline-block;"></span>
            Pending Review
        </div>
        <div style="display:flex; flex-direction:column; gap:12px; margin-bottom:28px;">
            @foreach (var item in list.Where(a => a.Status == "Pending"))
            {
                <div class="app-row app-row-pending">
                    @await Html.PartialAsync("_AppRowPartial", item)
                    <div class="app-row-actions">
                        <a asp-action="Review" asp-route-id="@item.Id" class="dk-btn dk-btn-ghost dk-btn-sm">
                            <i data-lucide="eye" style="width:14px;height:14px;"></i> Review
                        </a>
                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                            <button type="submit" class="dk-btn dk-btn-success dk-btn-sm"><i data-lucide="check" style="width:14px;height:14px;"></i> Approve</button>
                        </form>
                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" style="display:inline;"
                              onsubmit="return confirm('Reject application from @item.FullName?');">
                            <button type="submit" class="dk-btn dk-btn-danger dk-btn-sm"><i data-lucide="x" style="width:14px;height:14px;"></i> Reject</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Processed section -->
    @if (list.Any(a => a.Status != "Pending"))
    {
        <div style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-bottom:12px; display:flex; align-items:center; gap:8px;">
            <span style="width:6px; height:6px; border-radius:50%; background:var(--border-strong); display:inline-block;"></span>
            Processed
        </div>
        <div style="display:flex; flex-direction:column; gap:10px;">
            @foreach (var item in list.Where(a => a.Status != "Pending").OrderByDescending(a => a.CreatedAt))
            {
                var rowBorder = item.Status == "Approved" ? "rgba(52,211,153,0.3)" : "rgba(248,113,113,0.3)";
                <div class="app-row" style="border-left-color:@rowBorder; opacity:0.82;">
                    @await Html.PartialAsync("_AppRowPartial", item)
                    <div class="app-row-actions">
                        <a asp-action="Review" asp-route-id="@item.Id" class="dk-btn dk-btn-ghost dk-btn-sm">
                            <i data-lucide="eye" style="width:14px;height:14px;"></i> View
                        </a>
                        <span style="font-size:0.75rem; color:var(--text-muted);">
                            @(item.Status == "Approved" ? Html.Raw("<i data-lucide='check-circle-2' style='width:14px;height:14px;display:inline-block;vertical-align:-2px;'></i> Approved") : Html.Raw("<i data-lucide='x-circle' style='width:14px;height:14px;display:inline-block;vertical-align:-2px;'></i> Rejected"))
                        </span>
                    </div>
                </div>
            }
        </div>
    }
}

<style>
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
    .app-row {
        background: var(--glass);
        border: 1px solid var(--glass-border);
        border-left: 3px solid rgba(251,191,36,0.4);
        border-radius: 16px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        backdrop-filter: blur(12px);
        transition: box-shadow 0.15s;
        flex-wrap: wrap;
        box-shadow: 0 2px 8px rgba(15,23,42,0.02);
    }
    .app-row:hover { box-shadow: var(--shadow-sm); }
    .app-row-pending { border-left-color: rgba(251,191,36,0.5); }
    .app-row-info { display: flex; align-items: center; gap: 20px; flex:1; min-width:0; flex-wrap:wrap; }
    .app-row-actions { display: flex; align-items: center; gap: 8px; flex-shrink:0; flex-wrap:wrap; }
    .applicant-avatar {
        width: 40px; height: 40px; border-radius: 14px;
        background: linear-gradient(135deg, #d97706, #9a3412);
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; font-weight: 800; color: #fff; flex-shrink:0;
    }
    .app-meta { display:flex; flex-direction:column; gap:3px; min-width:0; }
    .app-name { font-size:0.9rem; font-weight:700; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .app-sub { font-size:0.75rem; color:var(--text-muted); }
    .app-pill {
        display:inline-flex; align-items:center; gap:5px;
        padding:4px 10px; border-radius:100px;
        font-size:0.72rem; font-weight:600;
        background:var(--surface); color:var(--text-sub);
        border:1px solid var(--border); white-space:nowrap;
    }
</style>
