@model IEnumerable<Vanguard_Engine.Entities.GuardApplication>
@{
    ViewData["Title"] = "Guard Applications Panel";
}

<div class="py-10">
    <div class="max-w-7xl mx-auto">

        <div class="mb-6">
            <h1 class="text-3xl font-extrabold text-gray-800">Guard Applications Panel</h1>
            <p class="text-gray-500 text-sm mt-1">Review, approve, or reject guard applications.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-100 border-l-4 border-green-500 text-green-800 px-4 py-3 rounded-xl mb-5 font-medium">
                ✅ @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-100 border-l-4 border-red-500 text-red-800 px-4 py-3 rounded-xl mb-5 font-medium">
                ❌ @TempData["ErrorMessage"]
            </div>
        }

        <!-- Summary Stats -->
        <div class="grid grid-cols-3 gap-4 mb-8">
            <div class="rounded-2xl p-5 text-center shadow-lg" style="background: linear-gradient(135deg, #fef3c7, #fde68a);">
                <div class="text-3xl font-extrabold text-yellow-800">@Model.Count(a => a.Status == "Pending")</div>
                <div class="text-sm font-semibold text-yellow-700 mt-1">Pending</div>
            </div>
            <div class="rounded-2xl p-5 text-center shadow-lg" style="background: linear-gradient(135deg, #d1fae5, #a7f3d0);">
                <div class="text-3xl font-extrabold text-green-800">@Model.Count(a => a.Status == "Approved")</div>
                <div class="text-sm font-semibold text-green-700 mt-1">Approved</div>
            </div>
            <div class="rounded-2xl p-5 text-center shadow-lg" style="background: linear-gradient(135deg, #fee2e2, #fecaca);">
                <div class="text-3xl font-extrabold text-red-800">@Model.Count(a => a.Status == "Rejected")</div>
                <div class="text-sm font-semibold text-red-700 mt-1">Rejected</div>
            </div>
        </div>

        <div class="rounded-3xl overflow-hidden shadow-2xl border border-white border-opacity-20"
             style="background: linear-gradient(135deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.07) 100%); backdrop-filter: blur(20px);">
            <table class="min-w-full">
                <thead>
                    <tr style="background: rgba(255,255,255,0.3);">
                        <th class="px-5 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">#</th>
                        <th class="px-5 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">User ID</th>
                        <th class="px-5 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Experience</th>
                        <th class="px-5 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Skills</th>
                        <th class="px-5 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Applied On</th>
                        <th class="px-5 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Status</th>
                        <th class="px-5 py-4 text-center text-xs font-bold text-gray-600 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{int i = 1;}
                    @foreach (var item in Model)
                    {
                        <tr class="border-t border-white border-opacity-20 hover:bg-white hover:bg-opacity-10 transition-colors">
                            <td class="px-5 py-4 text-sm text-gray-500 font-mono">@i</td>
                            <td class="px-5 py-4">
                                <span class="font-mono text-xs text-gray-600 bg-gray-100 px-2 py-1 rounded-lg">
                                    @item.UserId.Substring(0, Math.Min(8, item.UserId.Length))...
                                </span>
                            </td>
                            <td class="px-5 py-4">
                                <div class="text-sm text-gray-800 max-w-xs" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@item.Experience">
                                    @item.Experience
                                </div>
                            </td>
                            <td class="px-5 py-4">
                                <div class="text-sm text-gray-800 max-w-xs" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@item.Skills">
                                    @item.Skills
                                </div>
                            </td>
                            <td class="px-5 py-4 text-sm text-gray-500 whitespace-nowrap">
                                @item.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="px-5 py-4 whitespace-nowrap">
                                @if (item.Status == "Pending")
                                {
                                    <span class="px-3 py-1 rounded-full text-xs font-bold" style="background: #fef3c7; color: #92400e;">⏳ Pending</span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="px-3 py-1 rounded-full text-xs font-bold" style="background: #d1fae5; color: #065f46;">✅ Approved</span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 rounded-full text-xs font-bold" style="background: #fee2e2; color: #991b1b;">❌ Rejected</span>
                                }
                            </td>
                            <td class="px-5 py-4 text-center whitespace-nowrap">
                                @if (item.Status == "Pending")
                                {
                                    <div class="flex justify-center gap-2">
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit"
                                                    class="px-3 py-1 rounded-xl text-xs font-bold text-white transition-all hover:opacity-80 active:scale-95"
                                                    style="background: linear-gradient(135deg, #10b981, #059669);">
                                                ✓ Approve
                                            </button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit"
                                                    class="px-3 py-1 rounded-xl text-xs font-bold text-white transition-all hover:opacity-80 active:scale-95"
                                                    style="background: linear-gradient(135deg, #ef4444, #b91c1c);">
                                                ✗ Reject
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-gray-400 text-xs font-medium">Processed</span>
                                }
                            </td>
                        </tr>
                        i++;
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-16 text-center">
                                <div class="text-5xl mb-4">🔍</div>
                                <p class="text-gray-500 font-medium">No applications have been submitted yet.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
