@model Vanguard_Engine.Models.GuardApplyViewModel
@{
    ViewData["Title"] = "Guard Application";
    Layout = "~/Views/Shared/_PremiumLayout.cshtml";
}

<div class="page-hero">
    <div class="hero-icon"><i data-lucide="shield-check" style="width:56px; height:56px; margin:0 auto;"></i></div>
    <h1 class="hero-title">Guard Application</h1>
    <p class="hero-sub">Complete all sections accurately. Your application will be reviewed by our recruitment team.</p>
</div>

<div class="dk-card" style="max-width:760px; margin:0 auto;">

    <div asp-validation-summary="ModelOnly" class="dk-alert dk-alert-error"></div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="dk-alert dk-alert-error">@TempData["ErrorMessage"]</div>
    }

    <form asp-action="Apply" method="post" class="app-form">
        <input type="hidden" asp-for="JobId" />

        <!-- SECTION: Personal Info -->
        <div class="form-section">
            <div class="form-section-header">
                <span class="section-icon"><i data-lucide="user"></i></span>
                <span>Personal Information</span>
            </div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="FullName" class="dk-label">Full Legal Name <span class="req">*</span></label>
                    <input asp-for="FullName" class="dk-input" placeholder="e.g. Mohammad Rahman" />
                    <span asp-validation-for="FullName" class="field-err"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Phone" class="dk-label">Phone Number <span class="req">*</span></label>
                    <input asp-for="Phone" class="dk-input" placeholder="+8801XXXXXXXXX" />
                    <span asp-validation-for="Phone" class="field-err"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NationalId" class="dk-label">National ID (NID) <span class="req">*</span></label>
                    <input asp-for="NationalId" class="dk-input" placeholder="Enter your NID number" />
                    <span asp-validation-for="NationalId" class="field-err"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PreferredLocation" class="dk-label">Preferred Deployment Location <span class="req">*</span></label>
                    <input asp-for="PreferredLocation" class="dk-input" placeholder="e.g. Dhaka, Chittagong" />
                    <span asp-validation-for="PreferredLocation" class="field-err"></span>
                </div>
            </div>
            <div class="form-group" style="margin-top:12px;">
                <label asp-for="Address" class="dk-label">Current Address <span class="req">*</span></label>
                <input asp-for="Address" class="dk-input" placeholder="House No, Road, Area, District" />
                <span asp-validation-for="Address" class="field-err"></span>
            </div>
        </div>

        <!-- SECTION: Experience -->
        <div class="form-section">
            <div class="form-section-header">
                <span class="section-icon"><i data-lucide="briefcase"></i></span>
                <span>Professional Background</span>
            </div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="YearsOfExperience" class="dk-label">Years of Security Experience <span class="req">*</span></label>
                    <input asp-for="YearsOfExperience" class="dk-input" type="number" min="0" max="50" placeholder="0" />
                    <span asp-validation-for="YearsOfExperience" class="field-err"></span>
                </div>
                <div class="form-group" style="display:flex; align-items:center; gap:12px; margin-top:28px;">
                    <label class="dk-toggle">
                        <input asp-for="ArmedLicense" type="checkbox" />
                        <span class="toggle-slider"></span>
                    </label>
                    <div>
                        <div class="dk-label" style="margin:0;">Armed Guard License</div>
                        <div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px;">Check if you hold a valid firearms license</div>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Experience" class="dk-label">Work Experience Details <span class="req">*</span></label>
                <textarea asp-for="Experience" class="dk-input dk-textarea" rows="5"
                          placeholder="Describe your previous employers, roles, responsibilities, and notable achievements in security work..."></textarea>
                <span asp-validation-for="Experience" class="field-err"></span>
            </div>
        </div>

        <!-- SECTION: Skills -->
        <div class="form-section">
            <div class="form-section-header">
                <span class="section-icon"><i data-lucide="zap"></i></span>
                <span>Skills & Certifications</span>
            </div>
            <div class="form-group">
                <label asp-for="Skills" class="dk-label">Skills & Certifications <span class="req">*</span></label>
                <textarea asp-for="Skills" class="dk-input dk-textarea" rows="5"
                          placeholder="List your skills, training, and certifications — e.g. Surveillance, Crowd Control, First Aid, Firearms Training, CCTV Operation, Fire Safety..."></textarea>
                <span asp-validation-for="Skills" class="field-err"></span>
            </div>
        </div>

        <!-- Submit -->
        <div style="display:flex; gap:12px; justify-content:flex-end; padding-top:8px;">
            <a asp-action="MyApplications" class="dk-btn dk-btn-ghost">Cancel</a>
            <button type="submit" class="dk-btn dk-btn-primary">
                <i data-lucide="send" style="width:16px; height:16px;"></i> Submit Application
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
