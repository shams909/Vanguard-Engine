@model IEnumerable<Vanguard_Engine.Entities.GuardApplication>
@{
    ViewData["Title"] = "My Applications";
}

<div class="py-10">
    <div class="max-w-5xl mx-auto">

        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-800">My Applications</h1>
                <p class="text-gray-500 text-sm mt-1">Track the status of your guard applications.</p>
            </div>
            <a asp-action="Apply"
               class="px-5 py-2 rounded-2xl text-white font-semibold text-sm shadow-lg transition-all duration-200 hover:opacity-90 active:scale-95"
               style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                + New Application
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-100 border-l-4 border-green-500 text-green-800 px-4 py-3 rounded-xl mb-5 font-medium">
                ✅ @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-100 border-l-4 border-red-500 text-red-800 px-4 py-3 rounded-xl mb-5 font-medium">
                ❌ @TempData["ErrorMessage"]
            </div>
        }

        <div class="rounded-3xl overflow-hidden shadow-2xl border border-white border-opacity-20"
             style="background: linear-gradient(135deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.07) 100%); backdrop-filter: blur(20px);">
            <table class="min-w-full">
                <thead>
                    <tr style="background: rgba(255,255,255,0.3);">
                        <th class="px-6 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">#</th>
                        <th class="px-6 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Experience</th>
                        <th class="px-6 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Skills</th>
                        <th class="px-6 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Applied On</th>
                        <th class="px-6 py-4 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 text-right text-xs font-bold text-gray-600 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{int i = 1;}
                    @foreach (var item in Model)
                    {
                        <tr class="border-t border-white border-opacity-20 hover:bg-white hover:bg-opacity-10 transition-colors">
                            <td class="px-6 py-4 text-sm text-gray-500 font-mono">@i</td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-800 max-w-xs" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@item.Experience">
                                    @item.Experience
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-800 max-w-xs" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@item.Skills">
                                    @item.Skills
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">
                                @item.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (item.Status == "Pending")
                                {
                                    <span class="px-3 py-1 rounded-full text-xs font-bold" style="background: #fef3c7; color: #92400e;">⏳ Pending</span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="px-3 py-1 rounded-full text-xs font-bold" style="background: #d1fae5; color: #065f46;">✅ Approved</span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 rounded-full text-xs font-bold" style="background: #fee2e2; color: #991b1b;">❌ Rejected</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                @if (item.Status == "Pending")
                                {
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                                          onsubmit="return confirm('Delete this application? This cannot be undone.');">
                                        <button type="submit"
                                                class="px-3 py-1 rounded-xl text-xs font-semibold text-white transition-all hover:opacity-80 active:scale-95"
                                                style="background: linear-gradient(135deg, #ef4444, #b91c1c);">
                                            Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-gray-400 text-xs">Locked</span>
                                }
                            </td>
                        </tr>
                        i++;
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center">
                                <div class="text-5xl mb-4">📋</div>
                                <p class="text-gray-500 font-medium">You haven't submitted any applications yet.</p>
                                <a asp-action="Apply" class="mt-4 inline-block text-indigo-600 font-semibold hover:underline">Apply now →</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
