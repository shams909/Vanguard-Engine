@model IEnumerable<Vanguard_Engine.Entities.GuardApplication>
@{
    ViewData["Title"] = "My Applications";
    Layout = "~/Views/Shared/_DarkLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">My Applications</h1>
        <p class="page-header-sub">Track the status of your guard applications</p>
    </div>
    <a asp-action="Apply" class="dk-btn dk-btn-primary">+ New Application</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="dk-alert dk-alert-success">✅ @TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="dk-alert dk-alert-error">❌ @TempData["ErrorMessage"]</div>
}

<div class="stat-grid">
    <div class="stat-card stat-total">
        <span class="stat-label">Total</span>
        <span class="stat-value">@Model.Count()</span>
    </div>
    <div class="stat-card stat-pending">
        <span class="stat-label">Pending</span>
        <span class="stat-value">@Model.Count(a => a.Status == "Pending")</span>
    </div>
    <div class="stat-card stat-approved">
        <span class="stat-label">Approved</span>
        <span class="stat-value">@Model.Count(a => a.Status == "Approved")</span>
    </div>
    <div class="stat-card stat-rejected">
        <span class="stat-label">Rejected</span>
        <span class="stat-value">@Model.Count(a => a.Status == "Rejected")</span>
    </div>
</div>

<div class="dk-card">
    @if (Model.Any())
    {
        <table class="dk-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Location</th>
                    <th>Exp.</th>
                    <th>Armed</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th style="text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="mono">@i</span></td>
                        <td>
                            <div style="font-weight:600; color:var(--text);">@item.FullName</div>
                            <div class="mono" style="margin-top:2px;">@item.Phone</div>
                        </td>
                        <td style="color:var(--text-sub);">@item.PreferredLocation</td>
                        <td>
                            <span style="font-weight:600; color:var(--text);">@item.YearsOfExperience</span>
                            <span style="color:var(--text-muted); font-size:0.75rem;"> yr</span>
                        </td>
                        <td>
                            @if (item.ArmedLicense)
                            {
                                <span class="badge badge-approved">✓ Yes</span>
                            }
                            else
                            {
                                <span style="color:var(--text-muted); font-size:0.8rem;">No</span>
                            }
                        </td>
                        <td style="color:var(--text-muted); font-size:0.8rem;">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="badge badge-pending">⏳ Pending</span>
                            }
                            else if (item.Status == "Approved")
                            {
                                <span class="badge badge-approved">✅ Approved</span>
                            }
                            else
                            {
                                <span class="badge badge-rejected">❌ Rejected</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            @if (item.Status == "Pending")
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                                      onsubmit="return confirm('Withdraw this application? This cannot be undone.');">
                                    <button type="submit" class="dk-btn dk-btn-danger dk-btn-sm">Withdraw</button>
                                </form>
                            }
                            else
                            {
                                <span style="color:var(--text-muted); font-size:0.78rem;">—</span>
                            }
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📋</div>
            <div class="empty-title">No applications yet</div>
            <div class="empty-sub">Submit your first guard application to get started.</div>
            <a asp-action="Apply" class="dk-btn dk-btn-primary" style="margin-top:20px; display:inline-flex;">Apply Now →</a>
        </div>
    }
</div>
