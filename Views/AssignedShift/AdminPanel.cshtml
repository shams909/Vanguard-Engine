@model List<Vanguard_Engine.Entities.AssignedShift>
@{
    ViewData["Title"] = "Shift Assignment Panel";
    var guards = ViewBag.ApprovedGuards as List<Vanguard_Engine.Entities.GuardApplication> ?? new List<Vanguard_Engine.Entities.GuardApplication>();
}

<div class="page-header">
    <div>
        <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 6px;">Admin Modules</div>
        <h1 class="page-header-title">Shift Deployment Scheduling</h1>
        <p class="page-header-sub">Assign guards to specific dates and times, and prevent scheduling conflicts.</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 24px;">
    
    <!-- Shift Creation Form -->
    <div class="dk-card dk-card-pad">
        <h2 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 16px; color: var(--text); display: flex; align-items: center; gap: 8px;">
            <i data-lucide="calendar-plus" style="width: 20px; height: 20px; color: var(--accent);"></i> Schedule New Shift
        </h2>

        @if (TempData["Success"] != null)
        {
            <div class="dk-alert dk-alert-success" style="margin-bottom: 16px;">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="dk-alert dk-alert-error" style="margin-bottom: 16px;">@TempData["Error"]</div>
        }

        <form asp-action="AssignShift" method="post" style="display: flex; flex-direction: column; gap: 14px;">
            @Html.AntiForgeryToken()
            
            <div class="dk-form-group">
                <label class="dk-label">Select Operator</label>
                <select name="guardId" id="guardSelect" class="dk-input" required onchange="document.getElementById('guardName').value = this.options[this.selectedIndex].text.split(' (')[0];">
                    <option value="">-- Choose Guard --</option>
                    @foreach (var g in guards)
                    {
                        <option value="@g.UserId">@g.FullName (@g.Status)</option>
                    }
                </select>
                <input type="hidden" name="guardName" id="guardName" value="" />
            </div>

            <div class="dk-form-group">
                <label class="dk-label">Date</label>
                <input type="date" name="shiftDate" class="dk-input" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="dk-form-group">
                    <label class="dk-label">Start Time</label>
                    <input type="time" name="startTime" class="dk-input" required />
                </div>
                <div class="dk-form-group">
                    <label class="dk-label">End Time</label>
                    <input type="time" name="endTime" class="dk-input" required />
                </div>
            </div>

            <button type="submit" class="dk-btn dk-btn-primary" style="margin-top: 8px;">
                <i data-lucide="check-circle" style="width: 16px; height: 16px;"></i> Assign Shift
            </button>
        </form>
    </div>

    <!-- Assigned Shifts Table -->
    <div class="dk-card dk-card-pad">
        <h2 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 16px; color: var(--text); display: flex; align-items: center; gap: 8px;">
            <i data-lucide="list" style="width: 20px; height: 20px; color: var(--green);"></i> Assigned Roster
        </h2>

        @if (!Model.Any())
        {
            <div class="empty-state" style="padding: 40px 20px;">
                <div class="empty-icon"><i data-lucide="calendar" style="width:48px; height:48px; color:var(--text-muted); opacity:0.5;"></i></div>
                <div class="empty-title" style="font-size:1.1rem; font-weight:800; color:var(--text); margin-top:10px;">No shifts assigned yet</div>
                <div class="empty-sub" style="font-size:0.85rem; color:var(--text-sub);">Use the scheduling form on the left to assign deployment shifts to operators.</div>
            </div>
        }
        else
        {
            <div class="dk-table-container">
                <table class="dk-table">
                    <thead>
                        <tr>
                            <th>Operator</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shift in Model)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight: 700; color: var(--text);">@shift.GuardName</div>
                                    <div style="font-size: 0.72rem; color: var(--text-muted);">ID: @shift.GuardId.Substring(0, Math.Min(8, shift.GuardId.Length))...</div>
                                </td>
                                <td>@shift.ShiftDate</td>
                                <td><span class="mono" style="background: rgba(0,0,0,0.2); padding: 2px 6px; border-radius: 4px;">@shift.StartTime - @shift.EndTime</span></td>
                                <td>
                                    @if (shift.Status == "Scheduled")
                                    {
                                        <span class="badge badge-approved">SCHEDULED</span>
                                    }
                                    else if (shift.Status == "Cancelled")
                                    {
                                        <span class="badge badge-rejected">CANCELLED</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending">@shift.Status.ToUpper()</span>
                                    }
                                </td>
                                <td>
                                    @if (shift.Status == "Scheduled")
                                    {
                                        <form asp-action="UpdateStatus" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="shiftId" value="@shift.Id" />
                                            <input type="hidden" name="status" value="Cancelled" />
                                            <button type="submit" class="dk-btn dk-btn-danger" style="padding: 4px 10px; font-size: 0.76rem;" data-confirm="Cancel this shift?">Cancel</button>
                                        </form>
                                    }
                                    else if (shift.Status == "Cancelled")
                                    {
                                        <form asp-action="UpdateStatus" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="shiftId" value="@shift.Id" />
                                            <input type="hidden" name="status" value="Scheduled" />
                                            <button type="submit" class="dk-btn dk-btn-primary" style="padding: 4px 10px; font-size: 0.76rem;" data-confirm="Restore this shift?">Restore</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
