@model IEnumerable<Vanguard_Engine.Entities.AuditLog>
@{
    ViewData["Title"] = "Audit Log — Activity Feed";
}

<div class="page-header">
    <div>
        <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">Vanguard Engine</div>
        <h1 class="page-header-title">System Audit Trail</h1>
        <p class="page-header-sub">Immutable record of every state transition across the platform.</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        <a asp-action="Entity" class="dk-btn dk-btn-ghost dk-btn-sm">By Entity</a>
        <a asp-action="UserActivity" class="dk-btn dk-btn-ghost dk-btn-sm">By User</a>
        <a asp-action="Export" class="dk-btn dk-btn-primary dk-btn-sm" style="background:var(--green);border-color:var(--green);"><i data-lucide="download" style="width:16px;height:16px;display:inline-block;vertical-align:-3px;margin-right:4px;"></i> Export CSV</a>
    </div>
</div>

<div class="dk-card dk-card-pad" style="margin-top:8px;">
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:60px 20px;color:var(--text-muted);">
            <div style="font-size:1rem;font-weight:600;margin-bottom:8px;">No audit entries yet</div>
            <div style="font-size:0.85rem;">Audit entries will appear as actions are performed across the system.</div>
        </div>
    }
    else
    {
        <table class="dk-table" style="width:100%;border-collapse:collapse;font-size:0.875rem;">
            <thead>
                <tr style="border-bottom:1px solid var(--border);">
                    <th style="padding:12px 16px;text-align:left;font-weight:700;color:var(--text-sub);font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;">Time</th>
                    <th style="padding:12px 16px;text-align:left;font-weight:700;color:var(--text-sub);font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;">Entity</th>
                    <th style="padding:12px 16px;text-align:left;font-weight:700;color:var(--text-sub);font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;">Action</th>
                    <th style="padding:12px 16px;text-align:left;font-weight:700;color:var(--text-sub);font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;">Transition</th>
                    <th style="padding:12px 16px;text-align:left;font-weight:700;color:var(--text-sub);font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;">Role</th>
                    <th style="padding:12px 16px;text-align:left;font-weight:700;color:var(--text-sub);font-size:0.72rem;text-transform:uppercase;letter-spacing:0.06em;">Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr style="border-bottom:1px solid var(--border);transition:background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.04)'" onmouseout="this.style.background=''">
                        <td style="padding:12px 16px;color:var(--text-muted);white-space:nowrap;">
                            @log.CreatedAt.ToString("MMM dd, HH:mm")
                        </td>
                        <td style="padding:12px 16px;">
                            <span style="font-weight:700;color:var(--text);">@log.EntityType</span>
                            <div style="font-size:0.72rem;color:var(--text-muted);margin-top:2px;font-family:monospace;">@log.EntityId?.Substring(0, Math.Min(12, log.EntityId?.Length ?? 0))…</div>
                        </td>
                        <td style="padding:12px 16px;">
                            @{
                                var actionColor = log.Action switch {
                                    "Created"       => "var(--green)",
                                    "Cancelled"     => "var(--red)",
                                    "StatusChanged" => "var(--accent)",
                                    _               => "var(--text-sub)"
                                };
                            }
                            <span style="font-size:0.75rem;font-weight:700;padding:3px 10px;border-radius:100px;background:rgba(180,83,9,0.1);color:@actionColor;border:1px solid rgba(180,83,9,0.2);">
                                @log.Action
                            </span>
                        </td>
                        <td style="padding:12px 16px;font-family:monospace;font-size:0.8rem;">
                            @if (!string.IsNullOrEmpty(log.FromValue))
                            {
                                <span style="color:var(--text-muted);">@log.FromValue</span>
                                <span style="color:var(--accent);margin:0 6px;">→</span>
                            }
                            @if (!string.IsNullOrEmpty(log.ToValue))
                            {
                                <span style="color:var(--green);font-weight:700;">@log.ToValue</span>
                            }
                        </td>
                        <td style="padding:12px 16px;color:var(--text-muted);font-size:0.8rem;">@log.PerformedByRole</td>
                        <td style="padding:12px 16px;color:var(--text-muted);font-size:0.8rem;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@log.Notes">@log.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
