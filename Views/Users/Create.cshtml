@model Vanguard_Engine.Models.UsersCreateViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="page-hero">
    <div class="hero-icon">👤</div>
    <h1 class="hero-title">Create User</h1>
    <p class="hero-sub">Manually add a new user to the system</p>
</div>

<div class="dk-card" style="max-width:600px; margin:0 auto;">
    <form asp-action="Create" method="post" class="app-form">

        <div asp-validation-summary="ModelOnly" class="dk-alert dk-alert-error" style="margin:20px 20px 0;"></div>

        <div class="form-section">
            <div class="form-section-header"><span class="section-icon">👤</span> Account Details</div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="Username" class="dk-label">Username <span class="req">*</span></label>
                    <input class="dk-input" asp-for="Username" placeholder="johndoe" />
                    <span asp-validation-for="Username" class="field-err"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email" class="dk-label">Email <span class="req">*</span></label>
                    <input class="dk-input" asp-for="Email" type="email" placeholder="user@example.com" />
                    <span asp-validation-for="Email" class="field-err"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password" class="dk-label">Password <span class="req">*</span></label>
                    <input class="dk-input" asp-for="Password" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="field-err"></span>
                </div>
                <div class="form-group">
                    <label asp-for="RoleId" class="dk-label">Role</label>
                    <select class="dk-input" asp-for="RoleId">
                        <option value="">Select a role</option>
                        @foreach (var role in Model.Roles)
                        {
                            <option value="@role.Id">@role.RoleName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-group" style="margin-top:12px;">
                <label asp-for="Address" class="dk-label">Address</label>
                <input class="dk-input" asp-for="Address" placeholder="House, Road, Area, District" />
            </div>
        </div>

        <div class="form-section" style="display:flex; gap:12px; justify-content:flex-end;">
            <a asp-action="Index" class="dk-btn dk-btn-ghost">Cancel</a>
            <button type="submit" class="dk-btn dk-btn-primary">Create User</button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
