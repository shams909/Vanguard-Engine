@model Vanguard_Engine.Models.UsersCreateViewModel
@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Shared/_DarkLayout.cshtml";
}

<div class="page-hero">
    <div class="hero-icon">👤</div>
    <h1 class="hero-title">Create User</h1>
    <p class="hero-sub">Manually add a new user to the system</p>
</div>

<div class="dk-card" style="max-width:600px; margin:0 auto;">
    <form asp-action="Create" method="post" class="app-form">
        <div class="form-section">
            <div class="form-section-header"><span class="section-icon">👤</span> Account Details</div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label class="dk-label">Username <span class="req">*</span></label>
                    <input class="dk-input" asp-for="CreateUser.Username" placeholder="johndoe" />
                </div>
                <div class="form-group">
                    <label class="dk-label">Email <span class="req">*</span></label>
                    <input class="dk-input" asp-for="CreateUser.Email" type="email" placeholder="user@example.com" />
                </div>
                <div class="form-group">
                    <label class="dk-label">Password <span class="req">*</span></label>
                    <input class="dk-input" asp-for="CreateUser.Password" type="password" placeholder="••••••••" />
                </div>
                <div class="form-group">
                    <label class="dk-label">Role <span class="req">*</span></label>
                    <select class="dk-input" asp-for="CreateUser.RoleId">
                        <option value="">Select a role</option>
                        @foreach (var role in Model.Roles)
                        {
                            <option value="@role.Id">@role.RoleName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-group" style="margin-top:12px;">
                <label class="dk-label">Address</label>
                <input class="dk-input" asp-for="CreateUser.Address" placeholder="House, Road, Area, District" />
            </div>
        </div>
        <div class="form-section" style="display:flex; gap:12px; justify-content:flex-end;">
            <a asp-action="Index" class="dk-btn dk-btn-ghost">Cancel</a>
            <button type="submit" class="dk-btn dk-btn-primary">Create User</button>
        </div>
    </form>
</div>
