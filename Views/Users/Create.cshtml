@model Vanguard_Engine.Models.UsersCreateViewModel
@{
    ViewData["Title"] = "Create User";
}

<h2>Create User</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">Username</label>
        <input class="form-control" asp-for="CreateUser.Username" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" asp-for="CreateUser.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <input class="form-control" asp-for="CreateUser.Password" type="password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Address</label>
        <input class="form-control" asp-for="CreateUser.Address" />
    </div>
    <div class="mb-3">
        <label class="form-label">Role</label>
        <select class="form-select" asp-for="CreateUser.RoleId">
            <option value="">Select role</option>
            @foreach (var role in Model.Roles)
            {
                <option value="@role.Id">@role.RoleName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Last Login</label>
        <input class="form-control" asp-for="CreateUser.LastLogin" type="datetime-local" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
