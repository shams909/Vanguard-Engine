@model Vanguard_Engine.Models.UsersIndexViewModel
@{
    ViewData["Title"] = "Users Management";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Users Management</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Users</li>
    </ol>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-people-fill me-1"></i>
                Registered Users
            </div>
            <a class="btn btn-primary btn-sm" asp-action="Create">
                <i class="bi bi-person-plus-fill me-1"></i> Add New User
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Current Role</th>
                            <th>Change Role</th>
                            <th>Last Login</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td class="fw-bold">@user.Username</td>
                                <td>@user.Email</td>
                                <td>
                                    @{
                                        var currentRole = Model.Roles.FirstOrDefault(r => r.Id == user.RoleId)?.RoleName ?? "Unknown";
                                        var badgeClass = currentRole switch
                                        {
                                            "Admin" => "bg-danger",
                                            "Guard" => "bg-success",
                                            "Client" => "bg-info text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@currentRole</span>
                                </td>
                                <td>
                                    <form asp-action="UpdateRole" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                        <select name="newRoleId" class="form-select form-select-sm" style="min-width: 120px;">
                                            @foreach (var role in Model.Roles)
                                            {
                                                if (role.Id == user.RoleId)
                                                {
                                                    <option value="@role.Id" selected>@role.RoleName</option>
                                                }
                                                else
                                                {
                                                    <option value="@role.Id">@role.RoleName</option>
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-outline-primary btn-sm" onclick="return confirm('Are you sure you want to change the role for user @user.Username?')">
                                            Update
                                        </button>
                                    </form>
                                </td>
                                <td class="small text-muted">@user.LastLogin.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>
                    <li class="page-item active">
                        <span class="page-link">Page @Model.PageNumber</span>
                    </li>
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}
