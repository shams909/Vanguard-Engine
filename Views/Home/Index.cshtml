@{
    ViewData["Title"] = "Home";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Dashboard -->
    <div style="text-align:center; padding: 40px 0 32px;">
        <h1 style="font-size:2.2rem; font-weight:800; color:#1e293b; margin:0 0 8px;">
            Welcome back, @User.Identity.Name! 👋
        </h1>
        <p style="color:#64748b; font-size:1rem; margin:0;">
            Logged in as <span style="font-weight:700; color:#6366f1;">@userRole</span>
        </p>
    </div>

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:20px; margin-top:8px;">

        @if (userRole == "Guard")
        {
            <a asp-controller="Guard" asp-action="Apply" style="text-decoration:none;">
                <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius:24px; padding:28px; color:white; box-shadow:0 8px 32px rgba(102,126,234,0.3); transition:transform 0.2s; cursor:pointer;"
                     onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div style="font-size:2.5rem; margin-bottom:12px;">🛡️</div>
                    <h3 style="margin:0 0 8px; font-size:1.1rem; font-weight:700;">Apply as Guard</h3>
                    <p style="margin:0; font-size:0.875rem; opacity:0.85;">Submit a new guard application to join the force.</p>
                </div>
            </a>
            <a asp-controller="Guard" asp-action="MyApplications" style="text-decoration:none;">
                <div style="background: rgba(255,255,255,0.7); border:1px solid rgba(148,163,184,0.3); border-radius:24px; padding:28px; box-shadow:0 4px 20px rgba(15,23,42,0.08); transition:transform 0.2s; cursor:pointer; backdrop-filter:blur(10px);"
                     onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div style="font-size:2.5rem; margin-bottom:12px;">📋</div>
                    <h3 style="margin:0 0 8px; font-size:1.1rem; font-weight:700; color:#1e293b;">My Applications</h3>
                    <p style="margin:0; font-size:0.875rem; color:#64748b;">Track the status of your submitted applications.</p>
                </div>
            </a>
        }

        @if (userRole == "Admin" || userRole == "Recruiter" || userRole == "Client")
        {
            <a asp-controller="Guard" asp-action="Applications" style="text-decoration:none;">
                <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius:24px; padding:28px; color:white; box-shadow:0 8px 32px rgba(16,185,129,0.3); transition:transform 0.2s; cursor:pointer;"
                     onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div style="font-size:2.5rem; margin-bottom:12px;">👁️</div>
                    <h3 style="margin:0 0 8px; font-size:1.1rem; font-weight:700;">Guard Applications</h3>
                    <p style="margin:0; font-size:0.875rem; opacity:0.85;">Review, approve, or reject all guard applications.</p>
                </div>
            </a>
        }

        @if (userRole == "Admin")
        {
            <a asp-controller="Users" asp-action="Index" style="text-decoration:none;">
                <div style="background: rgba(255,255,255,0.7); border:1px solid rgba(148,163,184,0.3); border-radius:24px; padding:28px; box-shadow:0 4px 20px rgba(15,23,42,0.08); transition:transform 0.2s; cursor:pointer; backdrop-filter:blur(10px);"
                     onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div style="font-size:2.5rem; margin-bottom:12px;">👥</div>
                    <h3 style="margin:0 0 8px; font-size:1.1rem; font-weight:700; color:#1e293b;">Users</h3>
                    <p style="margin:0; font-size:0.875rem; color:#64748b;">Manage all system users and role assignments.</p>
                </div>
            </a>
            <a asp-controller="Roles" asp-action="Index" style="text-decoration:none;">
                <div style="background: rgba(255,255,255,0.7); border:1px solid rgba(148,163,184,0.3); border-radius:24px; padding:28px; box-shadow:0 4px 20px rgba(15,23,42,0.08); transition:transform 0.2s; cursor:pointer; backdrop-filter:blur(10px);"
                     onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div style="font-size:2.5rem; margin-bottom:12px;">🔑</div>
                    <h3 style="margin:0 0 8px; font-size:1.1rem; font-weight:700; color:#1e293b;">Roles</h3>
                    <p style="margin:0; font-size:0.875rem; color:#64748b;">Configure system roles and permissions.</p>
                </div>
            </a>
        }
    </div>
}
else
{
    <!-- Landing -->
    <div style="text-align:center; padding: 80px 0 40px;">
        <div style="font-size:5rem; margin-bottom:16px;">⚔️</div>
        <h1 style="font-size:3rem; font-weight:900; color:#1e293b; margin:0 0 16px; letter-spacing:-1px;">
            Vanguard Engine
        </h1>
        <p style="color:#64748b; font-size:1.15rem; max-width:500px; margin:0 auto 40px; line-height:1.6;">
            The complete security guard recruitment and management platform.
        </p>
        <div style="display:flex; justify-content:center; gap:12px; flex-wrap:wrap;">
            <a asp-controller="Auth" asp-action="Register" class="vg-btn-primary"
               style="padding:14px 32px; font-size:1rem; border-radius:16px;">
                Get Started →
            </a>
            <a asp-controller="Auth" asp-action="Login"
               style="padding:14px 32px; font-size:1rem; border-radius:16px; background:rgba(255,255,255,0.7); color:#374151; font-weight:600; text-decoration:none; border:1.5px solid rgba(148,163,184,0.4); backdrop-filter:blur(10px);">
                Sign In
            </a>
        </div>
    </div>
}
