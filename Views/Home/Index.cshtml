@using System.Security.Claims
@{
    ViewData["Title"] = "Enterprise Security Platform";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
    var isAuth = User.Identity?.IsAuthenticated == true;
}

<div class="landing-container">
    <!-- ═══ HERO SECTION ═══ -->
    <div class="landing-hero">
        @if (isAuth)
        {
            <div class="auth-banner">
                <div class="auth-banner-left">
                    <span class="auth-pulse"></span>
                    <span class="auth-banner-text">Welcome back, <strong>@User.Identity!.Name</strong> (<span style="color:var(--accent); font-weight:800;">@userRole</span>)</span>
                </div>
                <div class="auth-banner-right">
                    @if (userRole == "Admin" || userRole == "Recruiter")
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="dk-btn dk-btn-primary" style="font-size:0.78rem; padding:6px 14px;">Operational Console →</a>
                    }
                    else if (userRole == "Guard")
                    {
                        <a asp-controller="ClientRequest" asp-action="OpenJobs" class="dk-btn dk-btn-primary" style="font-size:0.78rem; padding:6px 14px;">Open Deployments →</a>
                    }
                    else
                    {
                        <a asp-controller="ClientRequest" asp-action="MyRequests" class="dk-btn dk-btn-primary" style="font-size:0.78rem; padding:6px 14px;">My Security Posts →</a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="hero-badge">
                <i data-lucide="shield-check" style="width:14px; height:14px; color:var(--green);"></i>
                <span>NEXT-GENERATION SECURITY & TACTICAL DEPLOYMENT ENGINE</span>
            </div>
        }

        <!-- Logo Icon Mark -->
        <div class="hero-logo-wrap">
            <div class="hero-logo">
                <i data-lucide="shield-half"></i>
            </div>
        </div>

        <h1 class="hero-headline">
            Vanguard <span class="accent-text">Engine</span>
        </h1>
        <p class="hero-tagline">
            The definitive enterprise security platform combining real-time tactical dispatch, verified guard recruitment, and high-clearance executive protection into a seamless command ecosystem.
        </p>

        <div class="hero-cta-wrap">
            @if (!isAuth)
            {
                <a asp-controller="Auth" asp-action="Register" class="dk-btn dk-btn-primary hero-btn">
                    <i data-lucide="shield" style="width:18px; height:18px; margin-right:6px;"></i> Deploy Your Defense — Free Trial
                </a>
                <a asp-controller="Auth" asp-action="Login" class="dk-btn dk-btn-ghost hero-btn-ghost">
                    <i data-lucide="log-in" style="width:18px; height:18px; margin-right:6px;"></i> Portal Login
                </a>
                <a asp-controller="Recruitment" asp-action="Index" class="dk-btn dk-btn-ghost hero-btn-ghost" style="border: 1px dashed var(--border-strong);">
                    <i data-lucide="megaphone" style="width:18px; height:18px; margin-right:6px; color:var(--accent);"></i> Explore Guard Careers
                </a>
            }
            else
            {
                <a href="#why-choose-us" class="dk-btn dk-btn-ghost hero-btn-ghost">
                    <i data-lucide="chevron-down" style="width:18px; height:18px; margin-right:6px;"></i> Explore Platform Capabilities
                </a>
            }
        </div>
    </div>

    <!-- ═══ LIVE TELEMETRY & PERFORMANCE BENCHMARKS ═══ -->
    <div class="telemetry-bar">
        <div class="telemetry-item">
            <div class="tel-value">99.99%</div>
            <div class="tel-label">System Availability</div>
        </div>
        <div class="telemetry-sep"></div>
        <div class="telemetry-item">
            <div class="tel-value">&lt; 5ms</div>
            <div class="tel-label">SignalR Dispatch Latency</div>
        </div>
        <div class="telemetry-sep"></div>
        <div class="telemetry-item">
            <div class="tel-value">AES-256</div>
            <div class="tel-label">Enterprise Encryption</div>
        </div>
        <div class="telemetry-sep"></div>
        <div class="telemetry-item">
            <div class="tel-value">24/7 / 365</div>
            <div class="tel-label">Tactical Support & Dispatch</div>
        </div>
    </div>

    <!-- ═══ WHY CHOOSE VANGUARD ENGINE? ═══ -->
    <div id="why-choose-us" class="section-container">
        <div class="section-header">
            <div class="section-subtitle">THE VANGUARD ADVANTAGE</div>
            <h2 class="section-title">Why Enterprise Leaders & Tactical Command Choose Us</h2>
            <p class="section-desc">Traditional security staffing is slow, fragmented, and opaque. Vanguard Engine revolutionizes the industry with instant communication, rigid vetting, and transparent operations.</p>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon" style="background: rgba(180, 83, 9, 0.12); color: var(--accent); border-color: rgba(180, 83, 9, 0.25);">
                    <i data-lucide="shield-check"></i>
                </div>
                <h3 class="feature-title">Elite Personnel Vetting</h3>
                <p class="feature-text">Every guard inside the Vanguard ecosystem undergoes multi-stage cryptographic identity vetting, license verification, and strict security clearance assignment prior to any active deployment.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon" style="background: rgba(52, 211, 153, 0.12); color: var(--green); border-color: rgba(52, 211, 153, 0.25);">
                    <i data-lucide="zap"></i>
                </div>
                <h3 class="feature-title">Instant SignalR Dispatch</h3>
                <p class="feature-text">Zero latency. When a client petition or VIP escort request is filed, our bi-directional WebSockets engine blasts deployment notifications to qualified tactical units instantaneously.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon" style="background: rgba(217, 119, 6, 0.12); color: var(--yellow); border-color: rgba(217, 119, 6, 0.25);">
                    <i data-lucide="crown"></i>
                </div>
                <h3 class="feature-title">VIP Executive Suite</h3>
                <p class="feature-text">Specialized high-clearance modules designed exclusively for executive assets and VIP clientele, ensuring discreet protective details, custom shift parameters, and immediate rapid response.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6; border-color: rgba(139, 92, 246, 0.25);">
                    <i data-lucide="history"></i>
                </div>
                <h3 class="feature-title">Immutable Audit Telemetry</h3>
                <p class="feature-text">Maintain 360-degree situational awareness with tamper-proof audit trails, real-time analytics hubs, shift history tracking, and incident escalation protocols.</p>
            </div>
        </div>
    </div>

    <!-- ═══ PLATFORM ECOSYSTEM SHOWCASE ═══ -->
    <div class="section-container" style="margin-top: 20px;">
        <div class="section-header">
            <div class="section-subtitle">A UNIFIED ENTERPRISE ARCHITECTURE</div>
            <h2 class="section-title">Built for Every Operational Stakeholder</h2>
        </div>

        <div class="pillars-grid">
            <div class="pillar-card">
                <div class="pillar-top">
                    <span class="pillar-role">FOR CLIENTS & VIPs</span>
                    <h3 class="pillar-heading">Seamless Asset Protection</h3>
                </div>
                <ul class="pillar-list">
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Submit priority security patrols & petitions in seconds</li>
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Monitor active guard shifts & deployment notices live</li>
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Access the dedicated Executive VIP Command Console</li>
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Instant incident reporting with guaranteed response SLAs</li>
                </ul>
                <div class="pillar-foot">
                    @if (isAuth)
                    {
                        <a asp-controller="ClientRequest" asp-action="Create" class="dk-btn dk-btn-ghost pillar-btn">Submit Patrol Petition →</a>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Register" class="dk-btn dk-btn-ghost pillar-btn">Request Security Protection →</a>
                    }
                </div>
            </div>

            <div class="pillar-card highlight-pillar">
                <div class="pillar-top">
                    <span class="pillar-role" style="color:var(--accent);">FOR SECURITY GUARDS</span>
                    <h3 class="pillar-heading">Elevate Your Security Career</h3>
                </div>
                <ul class="pillar-list">
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Access high-paying commercial & private deployment contracts</li>
                    <li><i data-lucide="check-circle-2" class="p-check"></i> One-click enlistment & streamlined application tracking</li>
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Automated shift logging and verifiable career records</li>
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Live career notifications straight to your portal</li>
                </ul>
                <div class="pillar-foot">
                    @if (isAuth && userRole == "Guard")
                    {
                        <a asp-controller="ClientRequest" asp-action="OpenJobs" class="dk-btn dk-btn-primary pillar-btn-pri">View Open Deployments →</a>
                    }
                    else
                    {
                        <a asp-controller="Recruitment" asp-action="Index" class="dk-btn dk-btn-primary pillar-btn-pri">Browse Active Careers →</a>
                    }
                </div>
            </div>

            <div class="pillar-card">
                <div class="pillar-top">
                    <span class="pillar-role">FOR ADMINISTRATORS</span>
                    <h3 class="pillar-heading">Total Command & Control</h3>
                </div>
                <ul class="pillar-list">
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Next-Gen Glassmorphic Mega-Menu with 12 module shortcuts</li>
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Spotlight Quick Jump Command Palette (Ctrl + K)</li>
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Deep analytics hub and granular role governance</li>
                    <li><i data-lucide="check-circle-2" class="p-check"></i> Red-tinted Danger Zone for system purge & override</li>
                </ul>
                <div class="pillar-foot">
                    @if (isAuth && (userRole == "Admin" || userRole == "Recruiter"))
                    {
                        <a asp-controller="Dashboard" asp-action="Admin" class="dk-btn dk-btn-primary pillar-btn-pri" style="background:linear-gradient(135deg, #b45309, #92400e); border-color:#92400e; color:#fff;">Launch Operations Console →</a>
                    }
                    else if (isAuth)
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="dk-btn dk-btn-ghost pillar-btn">Switch to Dashboard →</a>
                    }
                    else
                    {
                        <a href="/Auth/Login" class="dk-btn dk-btn-ghost pillar-btn">Admin Login →</a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ BOTTOM CTA BANNER ═══ -->
    <div class="bottom-cta">
        <div class="cta-content">
            <h2 class="cta-title">Ready to Secure Your Operational Vanguard?</h2>
            <p class="cta-sub">Join enterprise organizations and elite tactical personnel relying on Vanguard Engine today.</p>
            <div style="margin-top: 24px;">
                @if (isAuth)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="dk-btn dk-btn-primary" style="padding: 16px 36px; font-size: 1rem; border-radius: 16px; box-shadow: 0 10px 30px rgba(146, 64, 14, 0.25);">
                        <i data-lucide="layout-dashboard" style="width:20px; height:20px; margin-right:8px;"></i> Return to Operations Desk →
                    </a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Register" class="dk-btn dk-btn-primary" style="padding: 16px 36px; font-size: 1rem; border-radius: 16px; box-shadow: 0 10px 30px rgba(146, 64, 14, 0.25);">
                        <i data-lucide="shield" style="width:20px; height:20px; margin-right:8px;"></i> Get Started Now — Zero Setup Fees
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .landing-container {
        max-width: 1320px;
        margin: 0 auto;
        padding: 20px 12px 60px;
        color: var(--text);
    }

    /* Hero Styling */
    .landing-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 60px 20px 40px;
        position: relative;
    }
    
    .auth-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        background: var(--surface);
        border: 1px solid var(--border-strong);
        padding: 10px 20px;
        border-radius: 100px;
        margin-bottom: 32px;
        box-shadow: var(--shadow-sm);
        max-width: 650px;
        width: 100%;
    }
    .auth-banner-left { display: flex; align-items: center; gap: 10px; font-size: 0.88rem; color: var(--text-sub); }
    .auth-pulse { width: 10px; height: 10px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px rgba(21, 128, 61, 0.6); }
    
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(180, 83, 9, 0.08);
        border: 1px solid rgba(180, 83, 9, 0.22);
        color: var(--text-sub);
        padding: 6px 16px;
        border-radius: 100px;
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        margin-bottom: 32px;
        box-shadow: 0 2px 8px rgba(180, 83, 9, 0.06);
    }

    .hero-logo-wrap { margin-bottom: 24px; }
    .hero-logo {
        width: 84px; height: 84px;
        border-radius: 26px;
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 20px 48px rgba(146, 64, 14, 0.3), inset 0 2px 4px rgba(255,255,255,0.3);
        transform: rotate(0deg);
        transition: transform 0.65s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
    }
    .hero-logo:hover {
        transform: rotate(360deg) scale(1.08);
        box-shadow: 0 24px 60px rgba(146, 64, 14, 0.45), inset 0 2px 4px rgba(255,255,255,0.4);
    }
    .hero-logo svg { width: 42px; height: 42px; }

    .hero-headline {
        font-size: 4rem;
        font-weight: 900;
        letter-spacing: -2px;
        line-height: 1.05;
        margin-bottom: 20px;
        color: var(--text);
        max-width: 900px;
    }
    .accent-text { color: var(--accent); }

    .hero-tagline {
        font-size: 1.15rem;
        color: var(--text-muted);
        line-height: 1.6;
        max-width: 700px;
        margin: 0 auto 40px;
    }

    .hero-cta-wrap {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
    }
    .hero-btn {
        padding: 15px 32px;
        font-size: 1rem;
        border-radius: 16px;
        font-weight: 700;
        box-shadow: 0 10px 28px rgba(146, 64, 14, 0.25);
    }
    .hero-btn-ghost {
        padding: 15px 28px;
        font-size: 0.96rem;
        border-radius: 16px;
        font-weight: 700;
        border: 1px solid var(--border);
        background: var(--surface);
    }
    .hero-btn-ghost:hover {
        background: var(--surface-hover);
        border-color: var(--border-strong);
    }

    /* Telemetry Bar */
    .telemetry-bar {
        display: flex;
        align-items: center;
        justify-content: space-around;
        background: var(--glass);
        border: 1px solid var(--glass-border);
        border-top: 1.5px solid rgba(255, 255, 255, 0.9);
        border-radius: 24px;
        padding: 28px;
        margin: 20px 0 60px;
        backdrop-filter: blur(30px);
        box-shadow: var(--shadow-sm);
        flex-wrap: wrap;
        gap: 20px;
    }
    .telemetry-item { text-align: center; flex: 1; min-width: 160px; }
    .tel-value { font-size: 2.1rem; font-weight: 900; color: var(--text); letter-spacing: -1px; margin-bottom: 4px; }
    .tel-label { font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .telemetry-sep { width: 1px; height: 50px; background: var(--border); }
    @@media (max-width: 768px) {
        .telemetry-sep { display: none; }
        .hero-headline { font-size: 2.6rem; }
    }

    /* Sections */
    .section-container {
        padding: 50px 0;
    }
    .section-header {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 48px;
    }
    .section-subtitle {
        font-size: 0.76rem;
        font-weight: 800;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 12px;
    }
    .section-title {
        font-size: 2.6rem;
        font-weight: 900;
        color: var(--text);
        letter-spacing: -1px;
        margin-bottom: 16px;
        line-height: 1.15;
    }
    .section-desc {
        font-size: 1.02rem;
        color: var(--text-muted);
        line-height: 1.6;
    }

    /* Features Grid */
    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
    }
    .feature-card {
        background: var(--glass);
        border: 1px solid var(--glass-border);
        border-top: 1.5px solid rgba(255, 255, 255, 0.9);
        border-radius: 24px;
        padding: 36px 28px;
        backdrop-filter: blur(30px);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .feature-card:hover {
        transform: translateY(-6px);
        border-color: var(--border-strong);
        box-shadow: var(--shadow-md);
    }
    .feature-icon {
        width: 54px; height: 54px;
        border-radius: 16px;
        border: 1px solid transparent;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 22px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }
    .feature-icon svg { width: 26px; height: 26px; }
    .feature-title {
        font-size: 1.25rem; font-weight: 800; color: var(--text); margin-bottom: 12px; letter-spacing: -0.3px;
    }
    .feature-text {
        font-size: 0.92rem; color: var(--text-muted); line-height: 1.6;
    }

    /* Pillars Showcase */
    .pillars-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }
    @@media (max-width: 992px) {
        .pillars-grid { grid-template-columns: 1fr; }
    }
    .pillar-card {
        background: var(--glass);
        border: 1px solid var(--glass-border);
        border-top: 1.5px solid rgba(255, 255, 255, 0.9);
        border-radius: 28px;
        padding: 38px 30px;
        backdrop-filter: blur(35px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s;
    }
    .highlight-pillar {
        background: rgba(243, 235, 220, 0.85);
        border: 2px solid var(--accent);
        box-shadow: 0 20px 50px rgba(146, 64, 14, 0.12);
        transform: scale(1.02);
    }
    .pillar-top { margin-bottom: 24px; border-bottom: 1px solid var(--border); padding-bottom: 20px; }
    .pillar-role { font-size: 0.75rem; font-weight: 800; color: var(--text-muted); letter-spacing: 0.1em; }
    .pillar-heading { font-size: 1.4rem; font-weight: 800; color: var(--text); margin-top: 6px; letter-spacing: -0.5px; }
    
    .pillar-list { list-style: none; display: flex; flex-direction: column; gap: 16px; flex: 1; margin-bottom: 32px; }
    .pillar-list li { font-size: 0.9rem; color: var(--text-sub); display: flex; align-items: flex-start; gap: 12px; line-height: 1.5; font-weight: 500; }
    .p-check { width: 18px; height: 18px; color: var(--green); flex-shrink: 0; margin-top: 2px; }
    
    .pillar-btn { width: 100%; justify-content: center; padding: 12px; border-radius: 14px; font-weight: 700; background: var(--surface); border: 1px solid var(--border); }
    .pillar-btn-pri { width: 100%; justify-content: center; padding: 14px; border-radius: 14px; font-weight: 700; box-shadow: 0 6px 20px rgba(146, 64, 14, 0.2); }

    /* Bottom CTA */
    .bottom-cta {
        margin-top: 60px;
        background: linear-gradient(135deg, rgba(243, 235, 220, 0.9), rgba(235, 222, 203, 0.9));
        border: 1px solid var(--border-strong);
        border-top: 2px solid rgba(255, 255, 255, 0.95);
        border-radius: 32px;
        padding: 64px 30px;
        text-align: center;
        box-shadow: 0 24px 64px rgba(67, 40, 24, 0.15);
        position: relative;
        overflow: hidden;
    }
    .cta-title { font-size: 2.5rem; font-weight: 900; color: var(--text); letter-spacing: -1px; margin-bottom: 12px; }
    .cta-sub { font-size: 1.1rem; color: var(--text-muted); max-width: 600px; margin: 0 auto; }
</style>
