@model Vanguard_Engine.Models.HiringNoticeViewModel
@{
    ViewData["Title"] = "Post New Requirement";
}

<div style="max-width: 800px; margin: 0 auto;">
    <div style="margin-bottom: 32px; text-align: center;">
        <h1 style="font-size: 2rem; font-weight: 800; color: #1e293b; letter-spacing: -1px; margin-bottom: 8px;">
            Post Recruitment Notice
        </h1>
        <p style="color: #64748b; font-size: 0.95rem;">Enter the details for the new guard requirement. This will be visible to all prospective candidates.</p>
    </div>

    <div class="glass-card" style="max-width: 100%; margin-bottom: 40px;">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert-error" style="list-style: none;"></div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
                <div style="grid-column: span 2;">
                    <label asp-for="Title" class="vg-label">Requirement Title</label>
                    <input asp-for="Title" class="vg-input" placeholder="e.g. Senior Security Supervisor" />
                    <span asp-validation-for="Title" class="field-validation-error"></span>
                </div>

                <div>
                    <label asp-for="JobType" class="vg-label">Job Category</label>
                    <select asp-for="JobType" class="vg-input">
                        <option value="Full-time">Full-time</option>
                        <option value="Contract">Contract</option>
                        <option value="Urgent Dispatch">Urgent Dispatch</option>
                        <option value="VIP Escort">VIP Escort</option>
                    </select>
                    <span asp-validation-for="JobType" class="field-validation-error"></span>
                </div>

                <div>
                    <label asp-for="Priority" class="vg-label">Deployment Priority</label>
                    <select asp-for="Priority" class="vg-input">
                        <option value="Normal">Normal</option>
                        <option value="High">High (Immediate)</option>
                        <option value="Low">Low</option>
                    </select>
                    <span asp-validation-for="Priority" class="field-validation-error"></span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
                <div>
                    <label asp-for="Location" class="vg-label">Operation Location</label>
                    <input asp-for="Location" class="vg-input" placeholder="e.g. Dhaka HQ" />
                    <span asp-validation-for="Location" class="field-validation-error"></span>
                </div>

                <div>
                    <label asp-for="ExpiryDate" class="vg-label">Notice Expiry Date</label>
                    <input asp-for="ExpiryDate" class="vg-input" type="date" />
                    <span asp-validation-for="ExpiryDate" class="field-validation-error"></span>
                </div>
            </div>

            <div style="margin-bottom: 24px;">
                <label asp-for="SalaryRange" class="vg-label">Salary/Compensation Range</label>
                <input asp-for="SalaryRange" class="vg-input" placeholder="e.g. 40,000 - 60,000 BDT" />
                <span asp-validation-for="SalaryRange" class="field-validation-error"></span>
            </div>

            <div style="margin-bottom: 24px;">
                <label asp-for="Description" class="vg-label">Detailed Description</label>
                <textarea asp-for="Description" class="vg-input" rows="4" style="resize: vertical;" placeholder="Outline the main responsibilities..."></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <div style="margin-bottom: 32px;">
                <label asp-for="Requirements" class="vg-label">Mandatory Qualifications</label>
                <textarea asp-for="Requirements" class="vg-input" rows="4" style="resize: vertical;" placeholder="List required skills, licenses, and experience..."></textarea>
                <span asp-validation-for="Requirements" class="field-validation-error"></span>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end; border-top: 1px solid rgba(148,163,184,0.1); pt: 24px;">
                <a asp-action="Manage" style="text-decoration: none; padding: 10px 20px; font-size: 0.9rem; font-weight: 600; color: #64748b; border: 1px solid #cbd5e1; border-radius: 12px; transition: all 0.2s;">
                    Cancel
                </a>
                <button type="submit" class="vg-btn-primary" style="padding: 10px 32px; border-radius: 12px;">
                    Publish Requirement
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
