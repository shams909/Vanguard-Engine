@model Vanguard_Engine.Models.HiringNoticeViewModel
@{
    ViewData["Title"] = "Post New Requirement";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Post Recruitment Notice</h1>
        <p class="page-header-sub">Enter the details for the new guard requirement. This will be visible to all prospective candidates.</p>
    </div>
</div>

<div class="dk-card" style="max-width: 800px; margin-bottom: 40px;">
    <form asp-action="Create" method="post" class="app-form">
        <div asp-validation-summary="ModelOnly" class="dk-alert dk-alert-error" style="list-style: none; margin: 24px 28px 0;"></div>

        <div class="form-section">
            <div class="form-section-header"><i data-lucide="file-text" class="section-icon" style="width:20px; height:20px;"></i> General Information</div>
            
            <div class="form-group" style="margin-bottom: 16px;">
                <label asp-for="Title" class="dk-label">Requirement Title <span class="req">*</span></label>
                <input asp-for="Title" class="dk-input" placeholder="e.g. Senior Security Supervisor" />
                <span asp-validation-for="Title" class="field-err"></span>
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="JobType" class="dk-label">Job Category <span class="req">*</span></label>
                    <select asp-for="JobType" class="dk-input">
                        <option value="Full-time">Full-time</option>
                        <option value="Contract">Contract</option>
                        <option value="Urgent Dispatch">Urgent Dispatch</option>
                        <option value="VIP Escort">VIP Escort</option>
                    </select>
                    <span asp-validation-for="JobType" class="field-err"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Priority" class="dk-label">Deployment Priority <span class="req">*</span></label>
                    <select asp-for="Priority" class="dk-input">
                        <option value="Normal">Normal</option>
                        <option value="High">High (Immediate)</option>
                        <option value="Low">Low</option>
                    </select>
                    <span asp-validation-for="Priority" class="field-err"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-header"><i data-lucide="map-pin" class="section-icon" style="width:20px; height:20px;"></i> Location & Schedule</div>
            
            <div class="form-grid-2" style="margin-bottom: 16px;">
                <div class="form-group">
                    <label asp-for="Location" class="dk-label">Operation Location <span class="req">*</span></label>
                    <input asp-for="Location" class="dk-input" placeholder="e.g. Dhaka HQ" />
                    <span asp-validation-for="Location" class="field-err"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ExpiryDate" class="dk-label">Notice Expiry Date <span class="req">*</span></label>
                    <input asp-for="ExpiryDate" class="dk-input" type="date" />
                    <span asp-validation-for="ExpiryDate" class="field-err"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="SalaryRange" class="dk-label">Salary/Compensation Range</label>
                <input asp-for="SalaryRange" class="dk-input" placeholder="e.g. 40,000 - 60,000 BDT" />
                <span asp-validation-for="SalaryRange" class="field-err"></span>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-header"><i data-lucide="clipboard-list" class="section-icon" style="width:20px; height:20px;"></i> Details & Requirements</div>
            
            <div class="form-group" style="margin-bottom: 16px;">
                <label asp-for="Description" class="dk-label">Detailed Description <span class="req">*</span></label>
                <textarea asp-for="Description" class="dk-input dk-textarea" placeholder="Outline the main responsibilities..."></textarea>
                <span asp-validation-for="Description" class="field-err"></span>
            </div>

            <div class="form-group">
                <label asp-for="Requirements" class="dk-label">Mandatory Qualifications <span class="req">*</span></label>
                <textarea asp-for="Requirements" class="dk-input dk-textarea" placeholder="List required skills, licenses, and experience..."></textarea>
                <span asp-validation-for="Requirements" class="field-err"></span>
            </div>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end; padding: 24px 28px; background: rgba(255,255,255,0.2);">
            <a asp-action="Manage" class="dk-btn dk-btn-ghost">
                Cancel
            </a>
            <button type="submit" class="dk-btn dk-btn-primary">
                <i data-lucide="send" style="width:16px; height:16px;"></i> Publish Requirement
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
