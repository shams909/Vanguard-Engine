@model Vanguard_Engine.Models.HiringNoticeViewModel
@{
    ViewData["Title"] = "Post New Requirement";
}

<div style="max-width: 800px; margin: 0 auto;">
    <div class="page-header" style="justify-content: center; text-align: center; margin-bottom: 32px;">
        <div>
            <h1 class="page-header-title">Post New Requirement</h1>
            <p class="page-header-sub">Create a new hiring notice for guard deployment.</p>
        </div>
    </div>

    <div class="dk-card">
        <form asp-action="Create" method="post" class="app-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="dk-alert dk-alert-error"></div>

            <div class="form-section">
                <div class="form-section-header">
                    <span class="section-icon"><i data-lucide="file-text"></i></span>
                    <span>Notice Information</span>
                </div>
                
                <div class="form-group" style="margin-bottom: 20px;">
                    <label asp-for="Title" class="dk-label">Position Title <span class="req">*</span></label>
                    <input asp-for="Title" class="dk-input" placeholder="e.g. Senior Security Supervisor (Bank Deployment)" />
                    <span asp-validation-for="Title" class="field-err"></span>
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label asp-for="JobType" class="dk-label">Employment Type <span class="req">*</span></label>
                        <select asp-for="JobType" class="dk-input">
                            <option value="Permanent">Permanent</option>
                            <option value="Contract">Contract</option>
                            <option value="Temporary">Temporary</option>
                            <option value="Urgent">Urgent Deployment</option>
                        </select>
                        <span asp-validation-for="JobType" class="field-err"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Priority" class="dk-label">Priority Level <span class="req">*</span></label>
                        <select asp-for="Priority" class="dk-input">
                            <option value="Normal">Normal</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High (Urgent)</option>
                        </select>
                        <span asp-validation-for="Priority" class="field-err"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-header">
                    <span class="section-icon"><i data-lucide="map-pin"></i></span>
                    <span>Deployment Details</span>
                </div>
                <div class="form-grid-2" style="margin-bottom: 20px;">
                    <div class="form-group">
                        <label asp-for="Location" class="dk-label">Deployment Location <span class="req">*</span></label>
                        <input asp-for="Location" class="dk-input" placeholder="e.g. Dhaka (Motijheel Branch)" />
                        <span asp-validation-for="Location" class="field-err"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SalaryRange" class="dk-label">Salary Range (Optional)</label>
                        <input asp-for="SalaryRange" class="dk-input" placeholder="e.g. 15,000 - 20,000 BDT" />
                        <span asp-validation-for="SalaryRange" class="field-err"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="ExpiryDate" class="dk-label">Application Expiry Date (Optional)</label>
                    <input asp-for="ExpiryDate" class="dk-input" type="date" />
                    <span asp-validation-for="ExpiryDate" class="field-err"></span>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-header">
                    <span class="section-icon"><i data-lucide="align-left"></i></span>
                    <span>Description & Requirements</span>
                </div>
                <div class="form-group" style="margin-bottom: 24px;">
                    <label asp-for="Description" class="dk-label">Job Description <span class="req">*</span></label>
                    <textarea asp-for="Description" class="dk-input dk-textarea" rows="6" placeholder="Provide a detailed description of the security deployment, responsibilities, and working conditions..."></textarea>
                    <span asp-validation-for="Description" class="field-err"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Requirements" class="dk-label">Mandatory Requirements <span class="req">*</span></label>
                    <textarea asp-for="Requirements" class="dk-input dk-textarea" rows="6" placeholder="List the mandatory qualifications, physical attributes, or certifications required (e.g. Height 5'8'', Army background preferred)..."></textarea>
                    <span asp-validation-for="Requirements" class="field-err"></span>
                </div>
            </div>

            <div class="form-section" style="background: rgba(180, 83, 9, 0.02); display: flex; gap: 12px; justify-content: flex-end;">
                <a asp-action="Manage" class="dk-btn dk-btn-ghost">Discard</a>
                <button type="submit" class="dk-btn dk-btn-primary">
                    <i data-lucide="send" style="width:18px; height:18px;"></i> Publish Notice
                </button>
            </div>
        </form>
    </div>
</div>
