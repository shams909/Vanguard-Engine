@model List<Vanguard_Engine.Entities.HiringNotice>
@{
    ViewData["Title"] = "Manage Requirements";
}

<div style="margin-bottom: 32px; display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <h1 style="font-size: 2rem; font-weight: 800; color: #0f172a; letter-spacing: -1px; margin-bottom: 4px;">
            Requirement Management
        </h1>
        <p style="color: #475569; margin: 0; font-weight: 500;">Post and monitor all active guard recruitment notices.</p>
    </div>
    <a asp-action="Create" class="vg-btn-primary" style="display: flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 14px; text-decoration: none; font-size: 0.95rem;">
        <span style="font-size: 1.2rem;">+</span> Post Requirement
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-error">@TempData["ErrorMessage"]</div>
}

<div style="background: rgba(255,255,255,0.85); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.6); border-radius: 20px; box-shadow: 0 20px 60px rgba(15,23,42,0.12); overflow: hidden;">
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="background: rgba(241, 245, 249, 0.7); border-bottom: 2px solid rgba(148, 163, 184, 0.2);">
                    <th style="padding: 16px 24px; font-size: 0.75rem; font-weight: 700; color: #334155; text-transform: uppercase; letter-spacing: 0.08em;">Reference</th>
                    <th style="padding: 16px 24px; font-size: 0.75rem; font-weight: 700; color: #334155; text-transform: uppercase; letter-spacing: 0.08em;">Requirement Title</th>
                    <th style="padding: 16px 24px; font-size: 0.75rem; font-weight: 700; color: #334155; text-transform: uppercase; letter-spacing: 0.08em;">Type & Priority</th>
                    <th style="padding: 16px 24px; font-size: 0.75rem; font-weight: 700; color: #334155; text-transform: uppercase; letter-spacing: 0.08em;">Status</th>
                    <th style="padding: 16px 24px; font-size: 0.75rem; font-weight: 700; color: #334155; text-transform: uppercase; letter-spacing: 0.08em; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="padding: 60px 24px; text-align: center; color: #64748b;">
                            <div style="font-size: 3rem; margin-bottom: 16px;">📁</div>
                            <div style="font-weight: 700; color: #334155;">No requirements posted yet.</div>
                            <div style="font-size: 0.85rem; margin-top: 4px; color: #64748b;">Click "Post Requirement" to create your first notice.</div>
                        </td>
                    </tr>
                }
                @foreach (var notice in Model)
                {
                    <tr style="border-bottom: 1px solid rgba(148, 163, 184, 0.15); transition: background 0.15s;" onmouseover="this.style.background='rgba(241, 245, 249, 0.5)'" onmouseout="this.style.background='transparent'">
                        <td style="padding: 16px 24px;">
                            <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 0.8rem; color: #4f46e5; background: rgba(79, 70, 229, 0.1); padding: 5px 10px; border-radius: 8px; border: 1px solid rgba(79, 70, 229, 0.15);">
                                @notice.ReferenceCode
                            </span>
                        </td>
                        <td style="padding: 16px 24px;">
                            <div style="font-weight: 700; color: #0f172a; font-size: 0.95rem;">@notice.Title</div>
                            <div style="font-size: 0.8rem; color: #64748b; margin-top: 2px;">📍 @notice.Location</div>
                        </td>
                        <td style="padding: 16px 24px;">
                            <div style="font-size: 0.85rem; font-weight: 600; color: #334155;">@notice.JobType</div>
                            @if (notice.Priority == "High")
                            {
                                <div style="font-size: 0.7rem; font-weight: 800; color: #dc2626; text-transform: uppercase; display: flex; align-items: center; gap: 4px; margin-top: 2px;">
                                    <span style="width: 7px; height: 7px; border-radius: 50%; background: #dc2626; display: inline-block; animation: pulse 1.5s infinite;"></span> URGENT
                                </div>
                            }
                            else
                            {
                                <div style="font-size: 0.75rem; color: #64748b; margin-top: 2px;">@notice.Priority</div>
                            }
                        </td>
                        <td style="padding: 16px 24px;">
                            @if (notice.Status == "Open")
                            {
                                <span style="font-size: 0.75rem; font-weight: 700; padding: 5px 12px; border-radius: 100px; background: #dcfce7; color: #15803d; border: 1px solid #86efac;">OPEN</span>
                            }
                            else
                            {
                                <span style="font-size: 0.75rem; font-weight: 700; padding: 5px 12px; border-radius: 100px; background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1;">CLOSED</span>
                            }
                        </td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                                <a asp-action="Details" asp-route-id="@notice.Id" style="text-decoration: none; padding: 7px 14px; font-size: 0.8rem; font-weight: 700; color: #4f46e5; background: rgba(79,70,229,0.08); border: 1px solid rgba(79,70,229,0.2); border-radius: 10px; transition: all 0.2s;">
                                    View
                                </a>
                                @if (notice.Status == "Open")
                                {
                                    <form asp-action="Close" asp-route-id="@notice.Id" method="post" style="margin:0;">
                                        <button type="submit" onclick="return confirm('Close this recruitment notice?')" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.25); color: #b45309; padding: 7px 14px; font-size: 0.8rem; font-weight: 700; border-radius: 10px; cursor: pointer; transition: all 0.2s;">
                                            Close
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@notice.Id" method="post" style="margin:0;">
                                    <button type="submit" onclick="return confirm('Permanently delete this requirement?')" style="background: rgba(239,68,68,0.06); border: 1px solid rgba(239,68,68,0.2); color: #dc2626; padding: 7px 14px; font-size: 0.8rem; font-weight: 700; border-radius: 10px; cursor: pointer; transition: all 0.2s;">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
</style>
