@model List<Vanguard_Engine.Entities.HiringNotice>
@{
    ViewData["Title"] = "Manage Requirements";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Recruitment Management</h1>
        <p class="page-header-sub">Manage active hiring notices and deployment requirements.</p>
    </div>
    <a asp-action="Create" class="dk-btn dk-btn-primary">
        <i data-lucide="plus-circle" style="width:18px; height:18px;"></i> Post New Requirement
    </a>
</div>

<div class="dk-card">
    <div class="dk-table-container">
        <table class="dk-table">
            <thead>
                <tr>
                    <th>Ref Code</th>
                    <th>Position Title</th>
                    <th>Location</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-icon"><i data-lucide="file-signature" style="width:56px; height:56px; color:var(--text-muted);"></i></div>
                                <div class="empty-title">No hiring notices yet</div>
                                <div class="empty-sub">Create your first recruitment notice to start hiring.</div>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var notice in Model)
                {
                    <tr>
                        <td><span class="mono" style="font-weight:700;">#@notice.ReferenceCode</span></td>
                        <td>
                            <div style="font-weight:700; color:var(--text);">@notice.Title</div>
                            @if (notice.Priority == "High")
                            {
                                <span style="font-size:0.65rem; color:var(--red); font-weight:800; text-transform:uppercase;">● Urgent</span>
                            }
                        </td>
                        <td><i data-lucide="map-pin" style="width:12px; height:12px; display:inline; vertical-align:-2px; margin-right:2px; color:var(--text-muted);"></i> @notice.Location</td>
                        <td><span class="badge" style="background:rgba(255,255,255,0.4); border:1px solid var(--border); font-size:0.7rem;">@notice.JobType</span></td>
                        <td>
                            @if (notice.Status == "Open")
                            {
                                <span class="badge badge-approved">OPEN</span>
                            }
                            else
                            {
                                <span class="badge badge-rejected">CLOSED</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex; gap:8px; justify-content:flex-end;">
                                <a asp-action="Details" asp-route-id="@notice.Id" class="dk-btn dk-btn-ghost dk-btn-sm" title="View Details">
                                    <i data-lucide="eye" style="width:14px; height:14px;"></i>
                                </a>
                                @if (notice.Status == "Open")
                                {
                                    <form asp-action="Close" asp-route-id="@notice.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dk-btn dk-btn-danger dk-btn-sm" title="Close Post" onclick="return confirm('Are you sure you want to close this hiring notice?')">
                                            <i data-lucide="x-circle" style="width:14px; height:14px;"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@notice.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dk-btn dk-btn-danger dk-btn-sm" style="background:rgba(248,113,113,0.05); border-color:rgba(248,113,113,0.15);" title="Delete Permanently" onclick="return confirm('WARNING: This will permanently delete the notice. Continue?')">
                                        <i data-lucide="trash-2" style="width:14px; height:14px;"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
