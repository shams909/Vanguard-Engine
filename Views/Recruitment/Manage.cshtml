@model List<Vanguard_Engine.Entities.HiringNotice>
@{
    ViewData["Title"] = "Manage Requirements";
}

<div style="margin-bottom: 32px; display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <h1 style="font-size: 2rem; font-weight: 800; color: #1e293b; letter-spacing: -1px; margin-bottom: 4px;">
            Requirement Management
        </h1>
        <p style="color: #64748b; margin: 0;">Post and monitor all active guard recruitment notices.</p>
    </div>
    <a asp-action="Create" class="vg-btn-primary" style="display: flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 14px; text-decoration: none;">
        <span style="font-size: 1.2rem;">+</span> Post Requirement
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="glass-card" style="max-width: 100%; padding: 0; overflow: hidden; border-radius: 20px;">
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead style="background: rgba(241, 245, 249, 0.5); border-bottom: 1px solid rgba(148, 163, 184, 0.2);">
                <tr>
                    <th style="padding: 16px 24px; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;">Reference</th>
                    <th style="padding: 16px 24px; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;">Requirement Title</th>
                    <th style="padding: 16px 24px; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;">Type & Priority</th>
                    <th style="padding: 16px 24px; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;">Status</th>
                    <th style="padding: 16px 24px; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="padding: 60px 24px; text-align: center; color: #94a3b8;">
                            <div style="font-size: 3rem; margin-bottom: 16px;">📁</div>
                            <div style="font-weight: 600;">No requirements posted yet.</div>
                        </td>
                    </tr>
                }
                @foreach (var notice in Model)
                {
                    <tr style="border-bottom: 1px solid rgba(148, 163, 184, 0.1); transition: background 0.2s;" onmouseover="this.style.background='rgba(241, 245, 249, 0.4)'" onmouseout="this.style.background='transparent'">
                        <td style="padding: 16px 24px;">
                            <span style="font-family: monospace; font-weight: 700; color: #4f46e5; background: rgba(79, 70, 229, 0.08); padding: 4px 8px; border-radius: 6px;">
                                @notice.ReferenceCode
                            </span>
                        </td>
                        <td style="padding: 16px 24px;">
                            <div style="font-weight: 700; color: #1e293b;">@notice.Title</div>
                            <div style="font-size: 0.75rem; color: #94a3b8;">@notice.Location</div>
                        </td>
                        <td style="padding: 16px 24px;">
                            <div style="font-size: 0.85rem; font-weight: 600; color: #475569;">@notice.JobType</div>
                            @if (notice.Priority == "High")
                            {
                                <div style="font-size: 0.7rem; font-weight: 800; color: #ef4444; text-transform: uppercase; display: flex; align-items: center; gap: 4px;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #ef4444; display: inline-block;"></span> URGENT
                                </div>
                            }
                        </td>
                        <td style="padding: 16px 24px;">
                            @if (notice.Status == "Open")
                            {
                                <span style="font-size: 0.7rem; font-weight: 700; padding: 4px 10px; border-radius: 100px; background: #dcfce7; color: #166534; border: 1px solid #bbf7d0;">OPEN</span>
                            }
                            else
                            {
                                <span style="font-size: 0.7rem; font-weight: 700; padding: 4px 10px; border-radius: 100px; background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0;">CLOSED</span>
                            }
                        </td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                                <a asp-action="Details" asp-route-id="@notice.Id" style="text-decoration: none; padding: 6px 12px; font-size: 0.75rem; font-weight: 700; color: #6366f1; border: 1px solid rgba(99,102,241,0.3); border-radius: 8px; transition: all 0.2s;">
                                    View
                                </a>
                                @if (notice.Status == "Open")
                                {
                                    <form asp-action="Close" asp-route-id="@notice.Id" method="post" style="margin:0;">
                                        <button type="submit" style="background: none; border: 1px solid rgba(245,158,11,0.3); color: #d97706; padding: 6px 12px; font-size: 0.75rem; font-weight: 700; border-radius: 8px; cursor: pointer;">
                                            Close
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@notice.Id" method="post" style="margin:0;">
                                    <button type="submit" style="background: none; border: 1px solid rgba(239,68,68,0.2); color: #ef4444; padding: 6px 12px; font-size: 0.75rem; font-weight: 700; border-radius: 8px; cursor: pointer;" onclick="return confirm('Permanently delete this requirement?')">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
