@model List<Vanguard_Engine.Entities.GuardShift>
@{
    ViewData["Title"] = "My Shift History";
    var completed = Model?.Where(s => s.Status == "Completed").OrderByDescending(s => s.CreatedAt).ToList() ?? new();
    var active    = Model?.FirstOrDefault(s => s.Status == "Active");
    var totalMins = completed.Sum(s => s.DurationMinutes);
    var totalH    = totalMins / 60;
    var totalM    = totalMins % 60;
}

<div class="page-header">
    <div>
        <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 6px;">
            Operator Terminal &bull; Shift Records
        </div>
        <h1 class="page-header-title" style="display: flex; align-items: center; gap: 10px;">
            <i data-lucide="calendar-days" style="width: 22px; height: 22px; color: var(--accent);"></i> My Shift History
        </h1>
        <p class="page-header-sub">A complete log of your attendance records and working hours.</p>
    </div>
    <a asp-controller="Dashboard" asp-action="Guard" class="dk-btn dk-btn-ghost dk-btn-sm">
        <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i> Back to Terminal
    </a>
</div>

<!-- Summary Cards -->
<div class="stat-grid" style="margin-bottom: 28px;">
    <div class="stat-card stat-total">
        <div class="stat-label">Total Shifts</div>
        <div class="stat-value">@(completed.Count + (active != null ? 1 : 0))</div>
    </div>
    <div class="stat-card stat-approved">
        <div class="stat-label">Hours Logged</div>
        <div class="stat-value" style="font-size: 1.6rem;">@totalH<span style="font-size: 1rem; font-weight: 600;">h @totalM<span style="font-size: 0.75rem;">m</span></span></div>
    </div>
    <div class="stat-card" style="border-color: rgba(180,83,9,0.2);">
        <div class="stat-label">Avg Shift Length</div>
        <div class="stat-value" style="font-size: 1.6rem; color: var(--accent);">
            @if (completed.Any())
            {
                var avg = (int)completed.Average(s => s.DurationMinutes);
                @($"{avg / 60}h {avg % 60}m")
            }
            else { @("—") }
        </div>
    </div>
    <div class="stat-card @(active != null ? "stat-approved" : "")">
        <div class="stat-label">Current Status</div>
        <div class="stat-value" style="font-size: 1.2rem; color: @(active != null ? "var(--green)" : "var(--text-muted)");">
            @(active != null ? "On Duty" : "Off Duty")
        </div>
    </div>
</div>

<!-- Active Shift Banner -->
@if (active != null)
{
    <div class="dk-card dk-card-pad" style="margin-bottom: 20px; background: rgba(52,211,153,0.05); border-color: rgba(52,211,153,0.25);">
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="width: 10px; height: 10px; border-radius: 50%; background: var(--green); display: inline-block; box-shadow: 0 0 8px rgba(52,211,153,0.6);"></span>
                <div>
                    <div style="font-weight: 800; color: var(--green); font-size: 0.9rem;">Active Shift in Progress</div>
                    <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                        Checked in at <strong>@active.CheckInDateTime.ToLocalTime().ToString("HH:mm, dd MMM yyyy")</strong>
                    </div>
                </div>
            </div>
            <a asp-controller="Dashboard" asp-action="Guard" class="dk-btn dk-btn-primary dk-btn-sm">Check Out</a>
        </div>
    </div>
}

<!-- Shift Log Table -->
<div class="dk-card">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--border);">
        <div style="font-weight: 800; font-size: 1rem; color: var(--text);">Completed Shifts</div>
        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">@completed.Count record(s)</div>
    </div>

    @if (!completed.Any())
    {
        <div style="text-align: center; padding: 56px 24px;">
            <i data-lucide="calendar-off" style="width: 32px; height: 32px; color: var(--text-muted); margin-bottom: 12px;"></i>
            <div style="font-size: 0.94rem; font-weight: 700; color: var(--text); margin-bottom: 6px;">No Shift History Yet</div>
            <p style="font-size: 0.82rem; color: var(--text-muted);">Complete your first shift to see records here.</p>
        </div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.84rem;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border); background: rgba(180,83,9,0.03);">
                        <th style="padding: 12px 24px; text-align: left; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Date</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Check In</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Check Out</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Duration</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in completed)
                    {
                        <tr style="border-bottom: 1px solid rgba(215,200,180,0.4); transition: background 0.1s;" onmouseover="this.style.background='rgba(180,83,9,0.02)'" onmouseout="this.style.background=''">
                            <td style="padding: 14px 24px; font-weight: 600; color: var(--text);">
                                @shift.CheckInDateTime.ToLocalTime().ToString("dd MMM yyyy")
                            </td>
                            <td style="padding: 14px 16px; color: var(--text-sub);">
                                @shift.CheckInDateTime.ToLocalTime().ToString("HH:mm")
                            </td>
                            <td style="padding: 14px 16px; color: var(--text-sub);">
                                @(shift.CheckOutDateTime.HasValue ? shift.CheckOutDateTime.Value.ToLocalTime().ToString("HH:mm") : "—")
                            </td>
                            <td style="padding: 14px 16px;">
                                <span style="font-weight: 700; color: var(--accent);">@shift.DurationDisplay</span>
                            </td>
                            <td style="padding: 14px 16px;">
                                <span style="padding: 4px 10px; border-radius: 8px; font-size: 0.72rem; font-weight: 700; background: rgba(100,116,139,0.08); color: var(--text-muted); border: 1px solid rgba(100,116,139,0.15);">
                                    Completed
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
